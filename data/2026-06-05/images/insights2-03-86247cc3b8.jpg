<!-- HockeyStack — gated on CookieYes consent (analytics or advertisement) -->
<script>
(function () {
  var HS_API_KEY = "01864243df8f83b740094cceabbe01";
  var HS_SRC     = "https://cdn.jsdelivr.net/npm/hockeystack@latest/hockeystack.min.js";

  function loadHockeyStack() {
    if (document.getElementById('fphs')) return;
    var s = document.createElement('script');
    s.id = 'fphs';
    s.src = HS_SRC;
    s.async = 1;
    s.dataset.apikey = HS_API_KEY;
    s.dataset.cookieless = 1;
    document.getElementsByTagName('head')[0].appendChild(s);
  }

  function readCookieYesConsent() {
    var m = document.cookie.match(/(?:^|; )cookieyes-consent=([^;]+)/);
    if (!m) return null;
    try { return decodeURIComponent(m[1]); } catch (e) { return m[1]; }
  }

  function consentAllowsHockeyStack() {
    var raw = readCookieYesConsent();
    if (!raw) return false;
    return /analytics:yes|advertisement:yes/i.test(raw);
  }

  function maybeLoad() {
    if (consentAllowsHockeyStack()) loadHockeyStack();
  }

  document.addEventListener('cookieyes_consent_update', maybeLoad);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', maybeLoad);
  } else {
    maybeLoad();
  }
})();
</script>

<!-- F4: Teardown of safe-to-remove third-party state when consent is denied -->
<script>
(function () {
  function readCookieYesConsent() {
    var m = document.cookie.match(/(?:^|; )cookieyes-consent=([^;]+)/);
    if (!m) return null;
    try { return decodeURIComponent(m[1]); } catch (e) { return m[1]; }
  }

  function marketingConsented() {
    var raw = readCookieYesConsent();
    return !!raw && /advertisement:yes/i.test(raw);
  }

  function functionalConsented() {
    var raw = readCookieYesConsent();
    return !!raw && /functional:yes/i.test(raw);
  }

  function removeIframeById(id) {
    var el = document.getElementById(id);
    if (el && el.parentNode) el.parentNode.removeChild(el);
  }

  function removeSafeMarketingIframes() {
    removeIframeById('a2a_sm_ifr');
  }

  function clearVendorCookies() {
    var names = [
      '_ga','_gid','_gcl_au','_gcl_aw','_gcl_dc',
      '_fbp','_fbc',
      '_mkto_trk',
      'hubspotutk','__hssc','__hstc','__hssrc',
      'li_sugr','bcookie','bscookie','lidc','UserMatchHistory',
      '_uetsid','_uetvid'
    ];
    document.cookie.split(';').forEach(function (c) {
      var n = c.trim().split('=')[0];
      if (n && n.indexOf('_ga_') === 0) names.push(n);
    });
    names.forEach(function (n) {
      ['.coralogix.com','coralogix.com','www.coralogix.com'].forEach(function (d) {
        document.cookie = n + '=; Max-Age=0; path=/; domain=' + d;
      });
      document.cookie = n + '=; Max-Age=0; path=/';
    });
  }

  function clearVendorLocalStorage() {
    try {
      Object.keys(localStorage).forEach(function (k) {
        if (k.indexOf('wistia') === 0) localStorage.removeItem(k);
      });
    } catch (e) {}
  }

  function applyTeardown() {
    if (!marketingConsented()) {
      removeSafeMarketingIframes();
      clearVendorCookies();
    }
    if (!functionalConsented()) {
      clearVendorLocalStorage();
    }
  }

  document.addEventListener('cookieyes_consent_update', applyTeardown);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyTeardown);
  } else {
    applyTeardown();
  }
})();
</script>

<!-- GPC: Honor Global Privacy Control as Reject All -->
<script>
(function () {
  if (navigator.globalPrivacyControl !== true) return;

  if (typeof gtag === 'function') {
    gtag('consent', 'update', {
      ad_storage:              'denied',
      ad_user_data:            'denied',
      ad_personalization:      'denied',
      analytics_storage:       'denied',
      functionality_storage:   'denied',
      personalization_storage: 'denied'
    });
  }

  function clickReject() {
    var btn = document.querySelector('[data-cky-tag="reject-button"]')
           || document.querySelector('.cky-btn-reject');
    if (!btn) {
      var btns = document.querySelectorAll('button');
      for (var i = 0; i < btns.length; i++) {
        if (/^reject all/i.test((btns[i].textContent || '').trim())) { btn = btns[i]; break; }
      }
    }
    if (btn) { btn.click(); return true; }
    return false;
  }

  function isAlreadyRejected() {
    var m = document.cookie.match(/(?:^|; )cookieyes-consent=([^;]+)/);
    if (!m) return false;
    try {
      var raw = decodeURIComponent(m[1]);
      return /action:yes/i.test(raw) && /advertisement:no/i.test(raw) && /analytics:no/i.test(raw);
    } catch (e) { return false; }
  }

  if (!isAlreadyRejected() && !clickReject()) {
    var tries = 0;
    var iv = setInterval(function () {
      tries++;
      if (isAlreadyRejected() || clickReject() || tries > 50) clearInterval(iv);
    }, 100);
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.dispatchEvent(new CustomEvent('cookieyes_consent_update', {
      detail: { necessary: 'yes', functional: 'no', analytics: 'no', performance: 'no', advertisement: 'no', gpc: true }
    }));
  });
})();
</script><!-- Wistia: loads pre-consent in Privacy Mode -->
