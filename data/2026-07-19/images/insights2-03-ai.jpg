6nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://unrot.co/\"\u003eUnrot micro-learning app\u003c/a\u003e\u003c/p\u003e\u003cp\u003eJuly 17 is going to be the biggest AI day of the year, with Gemini 3.5 Pro and the World AI Conference colliding. Follow Build Fast with AI so the recap lands before your standup.\u003c/p\u003e\u003ch2\u003eReferences\u003c/h2\u003e\u003cp\u003e●\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.cnbc.com/2026/07/02/openai-proposes-us-government-own-5percent-stake-to-address-political-blowback.html\"\u003eOpenAI government stake (CNBC)\u003c/a\u003e\u003c/p\u003e\u003cp\u003e●\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://theaiinsider.tech/2026/07/13/ai-insiders-week-ahead-in-ai-apple-sues-openai-uchicago-law-ai-policy-tsmc-posts-record-revenue-plus-upcoming-hearings-events/\"\u003eTSMC record revenue (The AI Insider)\u003c/a\u003e\u003c/p\u003e\u003cp\u003e●\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://techcrunch.com/2026/07/02/anthropic-is-discussing-a-new-custom-chip-with-samsung/\"\u003eAnthropic Samsung chip talks (TechCrunch)\u003c/a\u003e\u003c/p\u003e\u003cp\u003e●\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.cnbc.com/2026/07/02/microsoft-commits-2point5-billion-6000-employees-ai-implementation-unit.html\"\u003eMicrosoft Frontier Company (CNBC)\u003c/a\u003e\u003c/p\u003e\u003cp\u003e●\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://siliconangle.com/2026/07/03/openai-offers-feds-stake-anthropic-gets-ai-model-jail-meta-wants-neocloud/\"\u003eOpenAI stake and Anthropic (SiliconANGLE)\u003c/a\u003e\u003c/p\u003e\u003cp\u003e●\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://fortune.com/2026/07/02/sam-altman-new-world-order-ai-openai-google-anthropic/\"\u003eAnthropic overtakes OpenAI (Fortune)\u003c/a\u003e\u003c/p\u003e\u003cp\u003e●\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://medium.com/@davidakpovi/ai-news-week-of-july-6-to-july-12-2026-f81a26c49c55\"\u003eWeekly AI roundup (Medium)\u003c/a\u003e\u003c/p\u003e\u003cp\u003e●\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://techcrunch.com/2026/07/09/openai-launches-its-new-family-of-models-with-gpt-5-6/\"\u003eGPT-5.6 launch (TechCrunch)\u003c/a\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"2a:[\"$\",\"$L2b\",null,{\"blog\":{\"id\":542,\"created_at\":\"2026-07-18T04:03:11.729728+00:00\",\"title\":\"AI News Today July 18 2026: 18 Biggest Stories\",\"excerpt\":\"Gemini 3.5 Pro slips again as Alphabet drops 4%, Kimi K3 tops the coding arena, and Apple passes Nvidia. The 18 biggest AI stories for July 18, 2026.\",\"slug\":\"ai-news-today-july-18-2026\",\"content\":\"$2c\",\"image_url\":\"https://oukdqujzonxvqhiefdsv.supabase.co/storage/v1/object/public/blogs/5913b4d7-d3d7-4af0-b7e0-9edea3aab789.png\",\"image_path\":\"5913b4d7-d3d7-4af0-b7e0-9edea3aab789.png\",\"published\":true,\"views\":197,\"is_founder_corner\":false,\"extra_image_urls\":null,\"meta_keywords\":\"AI news, Gemini 3.5 Pro, Kimi K3, WAICO, Apple, Anthropic IPO, DeepSeek, AI funding\",\"categories\":[{\"id\":12,\"name\":\"AI News\"}]},\"relatedBlogs\":[{\"id\":448,\"created_at\":\"2026-06-07T19:16:11.012901+00