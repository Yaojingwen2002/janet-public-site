        <style>
      #cookie-consent .cc-buttons { display:flex; gap:8px; flex-shrink:0; flex-wrap:wrap; }
      #cookie-consent .cc-btn { padding:12px 20px; border-radius:6px; font-size:14px; cursor:pointer; min-height:44px; }
      @media (max-width: 600px) {
        #cookie-consent .cc-buttons { flex-direction:column; width:100%; }
        #cookie-consent .cc-btn { width:100%; text-align:center; }
      }
    </style>
    <div id="cookie-consent" style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:9999; background:#1a1a2e; color:#fff; font-family:'Lato',sans-serif; box-shadow:0 -2px 12px rgba(0,0,0,0.3);">
      <div style="max-width:1100px; margin:0 auto; padding:18px 20px; display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
        <div style="flex:1; min-width:240px; font-size:14px; line-height:1.5;">
          We use essential cookies to keep the site working (login, form security). With your permission, we also use analytics cookies to understand how you use the site.
          <a href="/privacy" style="color:#93c5fd; text-decoration:underline;">Privacy policy</a>
        </div>
        <div class="cc-buttons">
          <button onclick="cookieConsent('all')" class="cc-btn" style="background:#22c55e; color:#fff; border:none; font-weight:700;">Accept All</button>
          <button onclick="cookieConsent('essential')" class="cc-btn" style="background:transparent; color:#fff; border:1px solid #555; font-weight:700;">Essential Only</button>
          <button onclick="cookieConsent('reject')" class="cc-btn" style="background:transparent; color:#999; border:1px solid #333;">Reject Non-Essential</button>
        </div>
      </div>
    </div>
    <script>
    (function() {
      // Show banner if no consent recorded.
      var consent = localStorage.getItem('cookie_consent');
      if (!consent) {
        document.getElementById('cookie-consent').style.display = 'block';
      }
      // Expose consent level globally for any scripts to check.
      window.aiweeklyCookieConsent = consent || 'none';
    })();
    function cookieConsent(level) {
      localStorage.setItem('cookie_consent', level);
      localStorage.setItem('cookie_consent_date', new Date().toISOString());
      document.getElementById('cookie-consent').style.display = 'none';
      window.aiweeklyCookieConsent = level;

      // If user rejected non-essential, clear any analytics cookies that may exist.
      if (level === 'reject' || level === 'essential') {
        document.cookie.split(';').forEach(function(c) {
          var name = c.split('=')[0].trim();
          // Keep essential cookies: session, csrf, Drupal.
          if (name === 'csrf_subscribe' || name.indexOf('SESS') === 0 || name.indexOf('SSESS') === 0) return;
          document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
        });
      }
    }
    // ── Google Analytics 4 (consent-gated) ──
    // Only loads gtag.js if user accepted analytics cookies.
    // GA4 Measurement ID: G-1WVJ6T5EFW
    function loadGA4() {
      if (document.getElementById('ga4-script')) return;
      var s = document.createElement('script');
      s.id = 'ga4-script';
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-1WVJ6T5EFW';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-1WVJ6T5EFW', { anonymize_ip: true });
    }

    // Load immediately if consent was previously given.
    if (window.aiweeklyCookieConsent === 'all') { loadGA4(); }

    // Patch cookieConsent() to also load GA4 when user clicks "Accept All".
    var _originalCookieConsent = cookieConsent;
    cookieConsent = function(level) {
      _originalCookieConsent(level);
      if (level === 'all') { loadGA4(); }
    };
    </script>
  </body>
</html>
