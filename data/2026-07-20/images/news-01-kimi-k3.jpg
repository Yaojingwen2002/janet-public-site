.dash__cred { font-size: 12.5px; color: rgba(255,255,255,0.55); margin: 4px 0 2px; }
.dash__cred a { color: rgba(255,255,255,0.75); }
.dash__cred-live { color: #24ab8a; font-weight: 800; letter-spacing: 0.5px; }
.dash__today-story { padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
.dash__today-story:last-child { border-bottom: none; }
.dash__today-headline { font-family: 'Merriweather', serif; font-size: 17px; line-height: 1.35; margin: 0 0 5px; font-weight: 700; }
.dash__today-headline a { color: #fff; text-decoration: none; }
.dash__today-headline a:hover { color: #24ab8a; }
.dash__today-summary { font-size: 14px; line-height: 1.55; color: rgba(255,255,255,0.65); margin: 0 0 6px; max-width: 74ch; }
.dash__today-meta { font-size: 12px; color: rgba(255,255,255,0.45); }
.dash__today-meta a { color: rgba(255,255,255,0.55); }
.dash__today-meta a.dash__today-brief { color: #24ab8a; font-weight: 700; text-decoration: none; }
.dash__pulse { background: rgba(36,171,138,0.08); border: 1px solid rgba(36,171,138,0.25); border-radius: 8px; padding: 16px 20px 12px; margin-bottom: 24px; }
.dash__pulse-title { font-size: 12px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #24ab8a; display: block; margin-bottom: 4px; }
.dash__pulse-row { display: flex; gap: 14px; padding: 7px 0; border-top: 1px solid rgba(255,255,255,0.06); font-size: 13.5px; line-height: 1.5; align-items: baseline; }
.dash__pulse-label { flex: 0 0 118px; font-size: 10px; font-weight: 800; letter-spacing: 0.8px; text-transform: uppercase; color: rgba(255,255,255,0.4); }
.dash__pulse-row a { color: #fff; font-weight: 800; text-decoration: none; }
.dash__pulse-row a:hover { color: #24ab8a; }
.dash__pulse-up { color: #24ab8a; font-weight: 800; }
.dash__pulse-down { color: #e74c3c; font-weight: 800; }
.dash__story-sum { font-size: 12.5px; color: rgba(255,255,255,0.45); line-height: 1.4; margin-top: 3px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
@media (max-width: 600px) { .dash__pulse-row { flex-direction: column; gap: 2px; } .dash__pulse-label { flex-basis: auto; } }
</style>
