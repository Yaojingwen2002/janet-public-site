        <style>
#sa-cookie-consent {
	display: none;
	position: fixed;
	right: 20px;
	bottom: 20px;
	z-index: 99999;
	width: 340px;
	max-width: calc(100vw - 32px);
	background: #1a1a1a;
	color: #f2f2f2;
	font-family: Roboto, Arial, sans-serif;
	font-size: 13px;
	line-height: 1.45;
	padding: 18px 18px 16px;
	box-shadow: 0 8px 28px rgba(0,0,0,.35);
	border: 1px solid #333;
}
#sa-cookie-consent.sa-cc-visible {
	display: block;
}
#sa-cookie-consent p {
	margin: 0 0 14px;
	color: #ddd;
}
#sa-cookie-consent a {
	color: #fff;
	text-decoration: underline;
}
#sa-cookie-consent .sa-cc-actions {
	display: flex;
	flex-direction: column;
	gap: 8px;
}
#sa-cookie-consent button {
	font-family: Roboto, Arial, sans-serif;
	font-size: 13px;
	font-weight: 500;
	border: 0;
	cursor: pointer;
	padding: 9px 14px;
	line-height: 1.2;
	width: 100%;
	text-align: center;
}
#sa-cookie-consent .sa-cc-reject-all {
	background: transparent;
	color: #ccc;
	border: 1px solid #555 !important;
}
#sa-cookie-consent .sa-cc-reject-all:hover {
	border-color: #888 !important;
	color: #fff;
}
#sa-cookie-consent .sa-cc-accept {
	background: #9c0013;
	color: #fff;
}
#sa-cookie-consent .sa-cc-accept:hover {
	background: #b30016;
}
@media (max-width: 480px) {
	#sa-cookie-consent {
		right: 12px;
		bottom: 12px;
		left: 12px;
		width: auto;
	}
}
</style>
<div id="sa-cookie-consent" role="dialog" aria-live="polite" aria-label="Cookie consent">
	<p>We use cookies for analytics and measurement. You can accept or reject tracking cookies. See our <a href="https://siliconangle.com/privacy-policy/">Privacy Policy</a>.</p>
	<div class="sa-cc-actions">
		<button type="button" class="sa-cc-accept" id="sa-cc-accept">Accept</button>
		<button type="button" class="sa-cc-reject-all" id="sa-cc-reject-all">Reject</button>
	</div>
</div>
<script>
(function () {
	var COOKIE = 'sa_cookie_consent';
	var MAX_AGE = 2592000;
	var GA_ID = 'G-QPLHNT2ZSK';
	var ADS_ID = '';
	var banner = document.getElementById('sa-cookie-consent');

	function readConsentCookie() {
		var match = document.cookie.match(new RegExp('(?:^|; )' + COOKIE.replace(/([.$?*|{}()[\]\\/+^])/g, '\\$1') + '=([^;]*)'));
		if (!match) return '';
		var value = decodeURIComponent(match[1]);
		if (value === 'accepted' || value === 'essential' || value === 'rejected') {
			return value;
		}
		return '';
	}

	function setConsentCookie(value) {
		var parts = [
			COOKIE + '=' + value,
			'path=/',
			'max-age=' + MAX_AGE,
			'SameSite=Lax'
		];
		if (location.protocol === 'https:') {
			parts.push('Secure');
		}
		document.cookie = parts.join('; ');
	}

	function updateGtag(granted) {
		if (typeof gtag !== 'function') return;
		var analytics = granted ? 'granted' : 'denied';
		var ads = (granted && ADS_ID) ? 'granted' : 'denied';
		gtag('consent', 'update', {
			analytics_storage: analytics,
			ad_storage: ads,
			ad_user_data: ads,
			ad_personalization: ads
		});
	}

	function loadGoogleTags() {
		if (window.__saGaLoaded) return;
		window.__saGaLoaded = true;

		window.dataLayer = window.dataLayer || [];
		if (typeof gtag !== 'function') {
			window.gtag = function () { dataLayer.push(arguments); };
		}

		var primaryId = GA_ID || ADS_ID;
		if (!primaryId) return;

		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(primaryId);
		document.head.appendChild(s);

		gtag('js', new Date());
		if (GA_ID) {
			gtag('config', GA_ID);
		}
		if (ADS_ID) {
			gtag('config', ADS_ID);
		}
	}

	window.saLoadAnalyticsTrackers = function () {
		if (window.__saThirdPartyLoaded) return;
		window.__saThirdPartyLoaded = true;

		/* Woopra (matches Woopra WP plugin snippet) */
		(function(){
			var t,i,e,n=window,o=document,a=arguments,s="script",r=["config","track","identify","visit","push","call"],c=function(){var t,i=this;for(i._e=[],t=0;r.length>t;t++)(function(t){i[t]=function(){return i._e.push([t].concat(Array.prototype.slice.call(arguments,0))),i}})(r[t])};for(n._w=n._w||{},t=0;a.length>t;t++)n._w[a[t]]=n[a[t]]=n[a[t]]||new c;i=o.createElement(s),i.async=1,i.src="//static.woopra.com/js/w.js",e=o.getElementsByTagName(s)[0],e.parentNode.insertBefore(i,e)
		})("woopra");
		woopra.config({"app":"wordpress","domain":"siliconangle.com","download_tracking":false,"outgoing_tracking":false,"hide_campaign":false});
		woopra.track();

		/* Quantcast (matches Quantcast Quantifier plugin options on production) */
		window._qevents = window._qevents || [];
		(function() {
			var elem = document.createElement('script');
			elem.src = (document.location.protocol == "https:" ? "https://secure" : "http://edge") + ".quantserve.com/quant.js";
			elem.async = true;
			elem.type = "text/javascript";
			var scpt = document.getElementsByTagName('script')[0];
			scpt.parentNode.insertBefore(elem, scpt);
		})();
		_qevents.push({ qacct: "p-HgwXEEYzRpfFC" });
		window._qoptions = { qacct: "p-0bRKhF16V5Cqk" };
	};

	function expireCookie(name, domain) {
		var base = name + '=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT';
		document.cookie = base;
		if (domain) {
			document.cookie = base + '; domain=' + domain;
		}
	}

	/** Best-effort: attempts to remove known first-party analytics cookies. */
	function clearAnalyticsCookies() {
		var host = location.hostname;
		var root = host.replace(/^www\./, '');
		var domains = [null, host, '.' + host, root, '.' + root];
		var names = document.cookie.split(';');
		var i, raw, name;

		for (i = 0; i < names.length; i++) {
			raw = names[i].replace(/^\s+/, '');
			name = raw.split('=')[0];
			if (!name) continue;
			if (
				name === '_ga' ||
				name.indexOf('_ga_') === 0 ||
				name === '_gid' ||
				name === '_gat' ||
				name === '__qca' ||
				name.indexOf('woopra') === 0
			) {
				for (var d = 0; d < domains.length; d++) {
					expireCookie(name, domains[d]);
				}
			}
		}
	}

	function showBanner() {
		if (banner) banner.classList.add('sa-cc-visible');
	}

	function hideBanner() {
		if (banner) banner.classList.remove('sa-cc-visible');
	}

	function applyConsent(value) {
		if (value === 'accepted') {
			updateGtag(true);
			loadGoogleTags();
			window.saLoadAnalyticsTrackers();
			hideBanner();
			return;
		}
		if (value === 'essential' || value === 'rejected') {
			updateGtag(false);
			hideBanner();
			return;
		}
		showBanner();
	}

	document.getElementById('sa-cc-accept').addEventListener('click', function () {
		setConsentCookie('accepted');
		applyConsent('accepted');
	});

	document.getElementById('sa-cc-reject-all').addEventListener('click', function () {
		setConsentCookie('rejected');
		updateGtag(false);
		clearAnalyticsCookies();
		window.location.reload();
	});

	/* EU/EEA + UK (+ associated territories GeoIP may return separately). */
	var CONSENT_REGIONS = {
		// EU member states
		AT:1, BE:1, BG:1, HR:1, CY:1, CZ:1, DK:1, EE:1, FI:1, FR:1, DE:1, GR:1,
		HU:1, IE:1, IT:1, LV:1, LT:1, LU:1, MT:1, NL:1, PL:1, PT:1, RO:1, SK:1,
		SI:1, ES:1, SE:1,

		// EEA
		IS:1, LI:1, NO:1,

		// United Kingdom
		GB:1,
		UK:1, // non-standard fallback

		// European/associated territories
		AX:1, // Åland Islands
		GI:1, // Gibraltar
		GG:1, // Guernsey
		JE:1, // Jersey
		IM:1, // Isle of Man

		// French territories that may be returned separately by GeoIP
		GP:1, // Guadeloupe
		GF:1, // French Guiana
		MQ:1, // Martinique
		RE:1, // Réunion
		YT:1, // Mayotte
		MF:1  // Saint Martin
	};

	function requiresConsentBanner(countryCode) {
		if (!countryCode) return false;
		return !!CONSENT_REGIONS[String(countryCode).toUpperCase()];
	}

	function autoAcceptOutsideConsentRegion() {
		setConsentCookie('accepted');
		applyConsent('accepted');
	}

	function initConsentByRegion() {
		var existing = readConsentCookie();
		if (existing) {
			applyConsent(existing);
			return;
		}

		var settled = false;
		function finish(fn) {
			if (settled) return;
			settled = true;
			clearTimeout(timer);
			fn();
		}

		var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
		var timer = setTimeout(function () {
			if (controller) {
				try { controller.abort(); } catch (e) {}
			}
			/* Geo timed out — prefer analytics for non-EU majority; do not show banner. */
			finish(autoAcceptOutsideConsentRegion);
		}, 2500);

		var fetchOpts = { credentials: 'omit', cache: 'no-store' };
		if (controller) fetchOpts.signal = controller.signal;

		fetch('https://get.geojs.io/v1/ip/country.json', fetchOpts)
			.then(function (res) {
				if (!res.ok) throw new Error('geo http ' + res.status);
				return res.json();
			})
			.then(function (data) {
				var code = (data && (data.country || data.country_code)) || '';
				if (requiresConsentBanner(code)) {
					finish(showBanner);
				} else {
					finish(autoAcceptOutsideConsentRegion);
				}
			})
			.catch(function () {
				finish(autoAcceptOutsideConsentRegion);
			});
	}

	initConsentByRegion();
})();
</script>
	<script>
(function () {
	"use strict";

	document.addEventListener("click", function (e) {
		// Match any of the known marketplace CTA anchor classes
		var link = e.target.closest(
			".aws-marketplace-cta-btn, " +
			".aws-marketplace-cta-ghost, " +
			".aws-marketplace-cta-plain, " +
			".aws-marketplace-written-cta-link, " +
			".aws-mp-cta-btn, " +
			".hero-cta-listing, " +
			".series-hero-cta-listing"
		);
		if (!link) return;

		// Determine CTA type
		var ctaType = "listing";
		var text = (link.textContent || "").trim().toUpperCase();
		if (
			link.classList.contains("aws-marketplace-cta-ghost") ||
			link.classList.contains("aws-marketplace-cta-plain") ||
			text.indexOf("DEMO") !== -1
		) {
			ctaType = "demo";
		}

		// Current page URL
		var sourcePage = window.location.pathname;

		// Section derived purely from what the link is inside
		var closestArticle   = link.closest("article");
		var closestSlide     = link.closest(".series-hero-slide");
		var closestHub       = link.closest(".aws-marketplace-hub");
		var closestSvcModal  = link.closest(".aws-svc-modal");
		var closestSvcGrid   = link.closest(".aws-mp-svc-grid");
		var sourceSection;
		if (closestSlide) {
			sourceSection = "series-hero";
		} else if (closestSvcModal) {
			sourceSection = "special-video-modal";
		} else if (closestSvcGrid) {
			sourceSection = "special-video-coverage";
		} else if (closestHub) {
			sourceSection = "hub";
		} else {
			sourceSection = "article";
		}

		// Nearest post/product title
		var titleEl = null;
		if (closestSvcModal) {
			// Title is in the modal's own title element
			titleEl = closestSvcModal.querySelector(".aws-svc-modal-title");
		} else if (closestArticle) {
			titleEl = closestArticle.querySelector(".aws-marketplace-card-title, .aws-mp-post-title, .aws-mp-product-name");
		} else if (closestSlide) {
			titleEl = closestSlide.querySelector(".series-hero-title");
		} else {
			titleEl = document.querySelector(".aws-mp-post-title, .aws-mp-product-name");
		}
		var postTitle = titleEl ? (titleEl.textContent || "").trim() : "";

		// Fire GA4 event
		if (typeof gtag === "function") {
			gtag("event", "marketplace_cta_click", {
				cta_type:       ctaType,
				post_title:     postTitle,
				destination:    link.href,
				source_page:    sourcePage,
				source_section: sourceSection,
			});
		}
	});
}());
</script>
	<script type='text/javascript' src='https://vjs.zencdn.net/7.12.2/video.js?ver=7.12.2'></script>
<script type='text/javascript' src='https://cdn.jsdelivr.net/npm/videojs-youtube@2.6.1/dist/Youtube.min.js?ver=2.6.1'></script>
