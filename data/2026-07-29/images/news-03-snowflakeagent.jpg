<!-- Font stylesheets — all locale CSS is loaded unconditionally because this
     is an SPA; React Router navigation never re-runs HTL, so server-gating
     would mean ko/zh_cn fonts never load on language switch. The .language-{code}
     class on the React tree (App.tsx) gates which @font-face actually resolves;
     fonts-ja.css further guards woff2 downloads via unicode-range. NotoSansKR
     and NotoSansSC have no unicode-range, but they're never resolved until
     .language-ko / .language-zh_cn matches a styled element, so non-matching
     locales pay only the CSS bytes (no woff2 download). -->
<link rel="stylesheet" href="/etc.clientlibs/snowflake-site/clientlibs/clientlib-react/resources/fonts/fonts-latin.css"/>
<link rel="stylesheet" href="/etc.clientlibs/snowflake-site/clientlibs/clientlib-react/resources/fonts/fonts-ja.css"/>
<link rel="stylesheet" href="/etc.clientlibs/snowflake-site/clientlibs/clientlib-react/resources/fonts/fonts-zh.css"/>
<link rel="stylesheet" href="/etc.clientlibs/snowflake-site/clientlibs/clientlib-react/resources/fonts/fonts-ko.css"/>

<!-- SVAI brand font (AEMSNOW-2601): DM Mono, self-hosted. Loaded only for SVAI
     pages (server-gated on brand path, not locale — brand never changes during
     SPA navigation, so gating here is safe). global/dcn are unaffected. Element
     font-family mapping is owned by design's CSS via the .site-svai hook. -->


