	<section id="primary" class="content-area context-mnc-post">
		<main id="main" class="site-main" role="main" data-grid="container pad-6x stack-2" tabindex="-1">
            <div data-grid="col-8" ms.cmpgrp="post content">
				
<article id="post-52563055" class="m-blog-post post-52563055 post type-post status-publish format-standard has-post-thumbnail hentry category-featured category-the-official-microsoft-blog tag-ai tag-microsoft-365-copilot tag-microsoft-foundry" ms.cmpnm="post content">
	<header class="entry-header m-blog-content">
		<h1 class="entry-title c-heading-3">Looking back on Microsoft’s FY26: From AI experimentation to Frontier Transformation</h1>			<div>
				<p class="c-meta-text">
					<time datetime="2026-07-28">
						<abbr title="July 28, 2026">Jul 28, 2026</abbr>
					</time>
					<span class="c-meta-divider-space">|</span>					<a href="https://blogs.microsoft.com/blog/author/judson-althoff/" ms.title="Judson Althoff" class="c-hyperlink u-underline" aria-label="See more written by Judson Althoff">
	Judson Althoff - CEO, Microsoft Commercial Business</a>
				</p>
			</div><!-- .entry-meta -->
