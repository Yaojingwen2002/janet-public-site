63.js\",\"/_next/static/chunks/4e765e6c1af572f8.js\"],\"\"]\n1a:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://orangebot.ai/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Top AI Models This Week\\\",\\\"item\\\":\\\"https://orangebot.ai/top-ai-models-this-week\\\"}]}\"}}]\n1d:T4bd,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What are the top trending AI models and papers this week?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"As of Sunday, August 2, 2026, the #1 is “AskChem: Claim-Centered Infrastructure for Chemistry Literature Synthesis.” The full ranked list of the top 30 trending AI models and papers this week is above, each linking to the original.\"}},{\"@type\":\"Question\",\"name\":\"How often is this trending models \u0026 papers list updated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Daily, over a rolling 7-day window. OrangeBot.AI re-fetches Hugging Face and re-ranks, so this page reflects this week's data.\"}},{\"@type\":\"Question\",\"name\":\"Is this an official page?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. OrangeBot.AI is an independent daily aggregator. We surface the top trending AI models and papers and link straight back to Hugging Face — no login, no paywall, no re-ranking algorithm.\"}},{\"@type\":\"Question\",\"name\":\"Where can I see more or subscribe?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Browse the Hugging Face source page for the latest items, or subscribe to its Atom feed for an always-current copy.\"}}]}1b:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1d\"}}]\n1f:T522,Chemistry literature synthesis often requires assembling specific findings scattered across many publications, yet existing literature-search systems primarily return ranked document lists. As a result, scientists and AI agents need to locate relevant information, verify their provenance, and assemble cross-paper answers manually. We present AskChem, a claim-centered infrastructure for cross-paper chemistry search. AskChem changes the unit of retrieval from the paper to the provenance-carrying claim: each paper is converted into atomic, typed claims, each grounded by a source DOI and a verbatim quote or an explicit evidence locator. Over this shared claim store, AskChem exposes complementary structures for search and synthesis: a stabilized faceted taxonomy for hierarchical retrieval and browsing, an evidence graph linking claims through relations, and an exploratory living taxonomy that situates indexed papers under scientific principles. AskChem currently indexes 2.4M claims from 147K papers and provides a web interface, as well as REST, SDK, and MCP access for AI agents. On AskChem-Bench, grounding a GPT-5.5 reader in AskChem yields 100% resolvable DOIs, compared with 88.3% without retrieval, and the highest citation density among five tested systems. AskChem is live at https://askchem.org."])</script><script>self.__next_f.push([1,"1c:[\"$\",\"main\",null,{\"className\":\"min-h-screen bg-ob-bg text-ob-fg\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl mx-auto px-4 py-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-mono text-[11px] uppercase tracking-[0.12em] text-ob-fg-mute mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block w-6 h-px align-middle bg-ob-rule mr-2\"}],\"HUGGING FACE · THIS WEEK\",\" · \",\"2026-08-02\"]}],[\"$\",\"h1\",null,{\"className\":\"text-4xl font-bold tracking-tight mb-3\",\"children\":\"Top AI Models This Week\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-ob-fg-dim leading-relaxed mb-2\",\"children\":[\