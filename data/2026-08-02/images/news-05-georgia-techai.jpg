ll mx-auto text-center">A Gray Local Media Station © 2002-2026</div><div class="footer-corp-logo | w-100 mx-auto mt-2 mb-0"></div></div></div><div id="fusion-static-exit:footer-wrdw" style="display:none" data-fusion-component="footer-wrdw"></div></footer></div></div><script id="fusion-metadata" type="application/javascript">window.Fusion=window.Fusion||{};Fusion.arcSite="wrdw";Fusion.contextPath="/pf";Fusion.mxId="00000000";Fusion.deployment="580";Fusion.globalContent={"_id":"LZ54R4XG7ZBSROFBFFCYYQGYRY","additional_properties":{"has_published_copy":true,"is_published":true},"address":{},"canonical_website":"wrdw","comments":{"allow_comments":true,"display_comments":true},"copyright":"Copyright 2026 WRDW/WAGT. All rights reserved.","created_date":"2026-08-01T16:59:11.076Z","credits":{"by":[{"_id":"atlantanewsfirststaff","type":"author","version":"0.5.8","name":"Atlanta First News staff","image":{"url":"https://s3.amazonaws.com/arc-authors/gray/d9f05381-fd3c-43de-b192-a10591929e89.png","version":"0.5.8"},"description":"","url":"/authors/atlantanewsfirststaff/","slug":"","social_links":[{"site":"email","url":""}],"socialLinks":[{"site":"email","url":"","deprecated":true,"deprecation_msg":"Please use social_links."}],"additional_properties":{"original":{"_id":"atlantanewsfirststaff","firstName":"Atlanta First News","lastName":"staff","byline":"Atlanta News First staff","image":"https://s3.amazonaws.com/arc-authors/gray/d9f05381-fd3c-43de-b192-a10591929e89.png","email":"","affiliations":"","education":[],"awards":[],"books":[],"podcasts":[],"bio_page":"/authors/atlantanewsfirststaff/","bio":"","longBio":"","slug":"","native_app_rendering":false,"fuzzy_match":false,"contributor":false,"status":true,"last_updated_date":"2022-09-29T12:56:48.264Z","website_url":"/authors/atlantanewsfirststaff/"}}}]},"description":{"basic":"Georgia Tech and Children’s Healthcare of Atlanta (CHOA) are working together to develop an AI social media surveillance tool that can help identify when a young person is at risk of a harmful mental health event."},"display_date":"2026-08-01T17:01:07.955Z","distributor":{"name":"Gray TV Stations (English)","category":"staff","subcategory":"gray-original-content","reference_id":"6c4d5d7a-69c6-483e-8ffd-871ff31dbadb","mode":"reference_denormalized"},"first_publish_date":"2026-08-01T17:01:07.955Z","geo":{},"headlines":{"basic":"AI tool aims to catch teen mental health crises using social media data","meta_title":"","mobile":"","native":"","print":"","table":"","tablet":"","web":""},"label":{},"language":"","last_updated_date":"2026-08-01T17:01:08.119Z","owner":{"id":"gray","sponsored":false},"planning":{"scheduling":{},"story_length":{"character_count_actual":3278,"inch_count_actual":4,"line_count_actual":25,"word_count_actual":577}},"publish_date":"2026-08-01T17:01:07.955Z","related_content":{"basic":[]},"revision":{"branch":"default","editions":["default"],"parent_id":"BCNA6FI2YRFF3DG6FBUOBLT2TY","published":true,"revision_id":"LJHBXOFVE5FXJLJJUJPI4W7ESQ"},"slug":"Owner","source":{"name":"Gray TV Stations","source_type":"gray-original-content","system":"composer"},"subheadlines":{"basic":""},"subtype":"default","type":"story","version":"0.10.11","workflow":{"status_code":1},"canonical_url":"/2026/08/01/ai-tool-aims-catch-teen-mental-health-crises-using-social-media-data/","publishing":{"scheduled_operations":{"publish_edition":[],"unpublish_edition":[]}},"website":"wrdw","website_url":"/2026/08/01/ai-tool-aims-catch-teen-mental-health-crises-using-social-media-data/","hasVideo":true,"hasVideoCenterVideo":true,"hasClickabilityVideo":false,"hasPowaLiveVideoPlayer":false,"dataTransformedAt":"2026-08-02T00:07:07.957Z","content_elements":[{"_id":"67QZEWVLORCTDB7ELMD3I6DKSE","additional_properties":{},"content":"ATLANTA, Ga. (WRDW/WAGT) - Georgia Tech and Children’s Healthcare of Atlanta (CHOA) are working together to develop an AI social media surveillance tool that can help identify when a young person is at risk of a harmful mental health event.","type":"text"},{"_id":"NGACUX6FZNHBXASMLBSAZAF2RI","additional_properties":{},"content":"The tool is based on a decade and a half of research. Researchers discovered signals from the types of words used online, what teens are engaging with and the types of information people are exposed to and share.","type":"text"},{"_id":"2XN5P5UTURF3XGWFFX4RHCESKY","additional_properties":{},"content":"“We hope we will be able to build a technology intervention that can provide the right kind of support and help to a young person at the right time,” Georgia Tech Professor Dr. Munmun De Choudhury said.","type":"text"},{"_id":"6NBYDSARL5HBZGZDZM7IS47TBA","additional_properties":{},"content":"Researchers found that social media data can be incredibly valuable to determine risk.","type":"text"},{"_id":"MBR2U3QNUJE6JNN7JLNBFKQL5E","additional_properties":{},"content":"“Their social media profiles are a very important part of their lives,” De Choudrury said. “If we are not looking there, we will be missing a very important piece of their life that might be very valuable to prevent bad things from happening.” ","type":"text"},{"_id":"E6XZUF2BEVHBBIDHMPDBYG2MCU","additional_properties":{},"content":"The data is being donated by CHOA patients between the ages of 13 and 17. Health data is already sensitive, but even more so for teens — and on top of that, this is data not typically associated with health. Researchers work with families to be transparent about how the data is being used.","type":"text"},{"_id":"BVR7TJPSOFFKTDWHX64H4HIKSE","additional_properties":{},"content":"“When we build that relationship of trust with the family, many families are willing to share this kind of data with the research team because they see the value of science that can result from this kind of donation,” De Choudhury said.","type":"text"},{"_id":"SDJ2ACLTIVHY3FIGEF7PYD5FGI","additional_properties":{},"content":"Researchers hope the tool will save lives. While only about 6% of visits to pediatric emergency rooms are for behavioral crises, about 45% of those are related to suicidal thoughts or actions.","type":"text"},{"_id":"EI4KVFX5KJHNRDERKSHDQXWGHE","additional_properties":{},"content":"“What we’re trying to do is make that device safer,” Dr. John Constantino, chief of behavioral and mental health at CHOA, said. “Not only to use these miracles of technology, which are smartphones, but also to make sure that we’re putting on the guardrails that are going to prevent them from going down these kinds of difficult roads that can lead to catastrophic consequences to them.”","type":"text"},{"_id":"2WVWGFKGTRCIBHKVBK6LJELAE4","additional_properties":{},"content":"The AI tool is not meant to replace existing parental control, but it could be another way for families to prevent tragic outcomes like suicides, researchers say. And it’s not just looking at overt signals.","type":"text"},{"_id":"V4CG4TYOKZDMZLCABYGDQKOBPU","additional_properties":{},"content":"“What AI also allows us to do is to combine otherwise what might seem like benign cues, but when you put them together in intelligent ways, you can begin to see a pattern that can be alarming,” De Choudhury said.","type":"text"},{"_id":"Y32SRKZSXRGAVLNNPH2U4XWMRU","additional_properties":{},"content":"The AI tool sends three levels of messages, all of which are currently being reviewed by researchers. The first stays solely with the teenager, encouraging them to pause, rethink what is happening and get help if needed. If the situation needs to go right to an adult, the AI would determine who to alert, whether it be a parent, guardian or even the authorities. ","type":"text"},{"_id":"7EU4EPWMLNDSPAWGVHO6HFO7N4","additional_properties":{},"content":"The messages are being tested with teens to see whether what seems like a good message is actually helpful. But the doctors say the AI would only send one to three messages.","type":"text"},{"_id":"ZDV3KZLNW5C55AYJMO7MVT5DTA","additional_properties":{},"content":"“It is not designed to be a therapist or a buddy or anything like that,” Constantino said. “Rather, it’s just an agent of opportunity for flagging for that youth themselves when the indications are that this is starting to hurt them.” ","type":"text"}],"promo_items":{"basic":{"_id":"WW7KG3B4AZE6TEI5F5PROPWESM","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/WW7KG3B4AZE6TEI5F5PROPWESM.png?auth=2382091fc82e282936770242cfc3ec35c5d9559610a2d3c7fa1b3a3ad2b972c3","galleries":[],"ingestionMethod":"manual","iptc_source":"WBNG","mime_type":"image/png","originalName":"KIDS ON CAM.png","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/gray/WW7KG3B4AZE6TEI5F5PROPWESM.png","proxyUrl":"/resizer/v2/WW7KG3B4AZE6TEI5F5PROPWESM.png?auth=2382091fc82e282936770242cfc3ec35c5d9559610a2d3c7fa1b3a3ad2b972c3","published":true,"resizeUrl":"/resizer/v2/WW7KG3B4AZE6TEI5F5PROPWESM.png?auth=2382091fc82e282936770242cfc3ec35c5d9559610a2d3c7fa1b3a3ad2b972c3","restricted":false,"thumbnailResizeUrl":"/resizer/v2/WW7KG3B4AZE6TEI5F5PROPWESM.png?auth=2382091fc82e282936770242cfc3ec35c5d9559610a2d3c7fa1b3a3ad2b972c3&width=300","usage_instructions":"For web story","version":0,"template_id":34},"address":{},"auth":{"3":"2382091fc82e282936770242cfc3ec35c5d9559610a2d3c7fa1b3a3ad2b972c3"},"caption":"New York state officials have released final regulations outlining how social media companies must implement the SAFE for Kids Act, a law signed in 2024 that restricts algorithm-driven feeds for users under 18.","created_date":"2026-07-29T18:47:54Z","credits":{"affiliation":[{"name":"WBNG","type":"author"}]},"height":1080,"image_type":"photograph","last_updated_date":"2026-07-29T18:47:54Z","licensable":false,"owner":{"id":"gray","sponsored":false},"source":{"additional_properties":{"editor":"photo center"},"edit_url":"","system":"photo center"},"subtitle":"SAFE KIDS ACT NY","taxonomy":{"associated_tasks":[]},"type":"image","url":"https://cloudfront-us-east-1.images.arcpublis