","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"129ebbcd-1cc0-400c-89a8-571616ebd94e"},"content":[{"text":"Chinese startup Suxian Micro unveiled TUCA unified computing architecture and Tianheng GPGPU accelerator targeting embodied AI and robotics workloads, company-stated.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"a3996ced-feed-4ab8-8e13-04881d73bc6d","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"db754081-7386-4453-b055-58262b64b199"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Adds domestic GPU alternative for Chinese robotics and embodied AI applications, reducing reliance on NVIDIA for non-training inference workloads.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"384e89a4-15e6-4adc-8cda-f40b36105997"},"content":[{"text":"Pandaily","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://pandaily.com/suxian-micro-tuca-tianheng-gpgpu-jul2026","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"5db1c799-8ff6-453e-a4f5-ac86f11dda0a","level":3,"anchorId":"s27-ai-is-needed-to-make-semiconductor-e","anchorTitle":"AI Is Needed To Make Semiconductor Engineering Work More Productive","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"AI Is Needed To Make Semiconductor Engineering Work More Productive.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.forbes.com/sites/tomcoughlin/2026/07/30/ai-is-needed-to-make-semiconductor-engineering-work-more-productive/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"716b98ad-cb57-4a9d-a5c1-7db9067f72ce"},"content":[{"t