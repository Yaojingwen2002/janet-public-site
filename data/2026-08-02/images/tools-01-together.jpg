y-open-sources-numbat-to-monitor-risky-ai-coding-agents/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"08888c1c-5bc4-4fe4-ac26-f130104c8242","level":3,"anchorId":"s15-dataflow-harness-reduces-llm-data-pi","anchorTitle":"DataFlow-Harness reduces LLM data-pipeline API costs by 72.5% versus free-form code","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"DataFlow-Harness reduces LLM data-pipeline API costs by 72.5% versus free-form code.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://venturebeat.com/orchestration/structured-ai-data-pipelines-score-10-9-points-below-free-form-code-dataflow-harness-closes-the-gap","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"7191d4cd-4d43-4885-87a0-6dac0ccd11e3"},"content":[{"text":"China · ◆ Neutral · 31 Jul 21:19 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"84729530-90b4-4c79-a703-85ceae8022a9"},"content":[{"text":"Researchers from Peking University and Shanghai's Institute for Advanced Algorithms released DataFlow-Harness, an open-source framework that reduced API costs by 72.5% compared to Claude Code while achieving 93.3% end-to-end pass rate on data-engineering tasks.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"847ecae6-4660-4cce-9f2f-0e9ad2d52434","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"b83155cc-8e99-4653-a089-95e213acf1c7"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" That structured data-pipeline frameworks can reduce inference token consumption and cost, relevant for organisations optimising large-scale data processing workloads on GPU clusters.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"c1b885a0-7a10-4605-800a-b9ecbd3c3629"},"content":[{"text":"Venturebeat","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://venturebeat.com/orchestration/structured-ai-data-pipelines-score-10-9-points-below-free-form-code-dataflow-harness-closes-the-gap","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"3abb7085-1578-4e99-b396-8dbf709d8ddb","level":3,"anchorId":"s16-smallest-ai-raises-13m-for-real-time","anchorTitle":"Smallest.ai raises $13M for real-time voice AI with sub-100ms latency","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Smallest.ai raises $13M for real-time voice AI with sub-100ms latency.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/2026/07/31/smallest-ai-raises-13m-to-build-ultra-fast-voice-ai-that-sounds-genuinely-human/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"a0fb1017-38f8-4b71-bb4c-d07185b27c5e"},"content":[{"text":"US · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 14:47 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"efb7b302-1750-412e-bb9c-9daf0de728fd"},"content":[{"text":"Smallest.ai closed a $13M Series A led by Seligman Ventures, bringing total funding to $21M, building a small voice model for real-time conversational AI with near-zero response latency.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"7fef349f-a5c3-4620-a63b-939c223d126b","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"2dcd236e-8862-46f0-88b0-0970b9f1c248"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Inference-optimised voice models reduce GPU requirements per inference endpoint, relevant to serverless and edge deployment economics for inference providers.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"e565bd26-3360-4f34-a91f-421f69981128"},"content":[{"text":"TechCrunch","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/2026/07/31/smallest-ai-raises-13m-to-build-ultra-fast-voice-ai-that-sounds-genuinely-human/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"b975e035-21f7-46fa-84a3-8e1424b57cd0","level":3,"anchorId":"s17-openai-and-anthropic-support-petitio","anchorTitle":"OpenAI and Anthropic support petition for slower AI development pace","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"OpenAI and Anthropic support petition for slower AI development pace.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/video/sam-altman-isnt-the-only-one-who-wants-to-pump-the-brakes-on-ai/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"36c9b55d-cd43-4fe9-b4b2-b86e26118cb7"},"content":[{"text":"Global · ◆ Neutral · 31 Jul 17:26 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"6479d5fa-ae32-42f2-8969-32c5ee647d05"},"content":[{"text":"OpenAI CEO Sam Altman and Anthropic both support a petition calling for a slower approach to AI development, following security incidents involving unauthorised model intrusions.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"d1070595-5b3e-4a82-837a-9576140ae1f9","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"9351a5e4-0476-41bd-a594-767db4baaa48"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Potential industry consensus on development pacing, which could affect training cluster utilisation rates and capex timelines if major labs reduce compute spending.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"be2923ba-54b7-4d9c-8fd4-3bf90368ee49"},"content":[{"text":"TechCrunch","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/video/sam-altman-isnt-the-only-one-who-wants-to-pump-the-brakes-on-ai/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"0ea25a0b-08c2-4336-8b1b-728bb2c128b4","level":3,"anchorId":"s18-google-removes-earth-ai-image-genera","anchorTitle":"Google removes Earth AI image generation feature one day after launch due to misinformation risk","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Google removes Earth AI image generation feature one day after launch due to misinformation risk.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/2026/07/31/google-nixes-its-earth-ai-feature-one-day-after-launch-amid-criticism-it-would-spread-misinformation/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"339bd67c-2bfd-4abd-93d5-87abaaba7204"},"content":[{"text":"Global · ◆ Neutral · 31 Jul 19:47 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"9e9302d0-da4c-44aa-b97a-df2256e84da6"},"content":[{"text":"Google launched Nano Banana 2, an AI image generation feature within Google Earth, then removed it within 24 hours after journalists demonstrated it could easily create geospatial misinformation.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"bd5b4113-df67-40d7-8b10-4d821c8c6670","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"313267df-8eef-4209-b5a5-4f3d7a13f7a1"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Regulatory and reputational pressure on AI feature rollouts, which may constrain deployment velocity for inference-heavy applications and increase compliance costs for cloud providers.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"cb7f99b3-15ab-462e-854e-d69c87f78e1d"},"content":[{"text":"TechCrunch","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/2026/07/31/google-nixes-its-earth-ai-feature-one-day-after-launch-amid-criticism-it-would-spread-misinformation/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"d1df954c-fe8f-4f78-8f42-478818217c9c","level":3,"anchorId":"s19-snapchat-stops-rewarding-fully-ai-ge","anchorTitle":"Snapchat stops rewarding fully AI-generated Spotlight content","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Snapchat stops rewarding fully AI-generated Spotlight content.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/2026/07/31/snapchat-no-longer-rewards-fully-ai-generated-spotlight-content/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"d4f54685-77bd-4725-8e04-1b6527af514e"},"content":[{"text":"Global · ◆ Neutral · 31 Jul 16:49 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"a39d95ad-07d5-4971-9f1e-33399378a521"},"content":[{"text":"Snapchat will no longer reward fully AI-generated videos in its Spotlight recommendation system, prioritising content created by real people, though creators can still use AI tools to enhance or edit content.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"390bd24b-17a8-480b-af08-a4152d93dca8","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"f6076414-5370-47a0-b9fa-8c31bc727abc"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Platform-level policy shift against fully synthetic content, which may reduce inference demand for generative video models but market maturation and regulatory pressure on AI-generated content.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"ff7ec63c-3e22-4f75-a1cb-2e2fff1a132c"},"content":[{"text":"TechCrunch","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/2026/07/31/snapchat-no-longer-rewards-fully-ai-generated-spotlight-content/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"5cc33443-6ec4-4879-8479-f777ab271392","level":3,"anchorId":"s20-lambda-labs-analysed-1-433-prompt-in","anchorTitle":"Lambda Labs analysed 1,433 prompt injection attacks, finds cross-domain agent vulnerabilities","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Lambda Labs analysed 1,433 prompt injection attacks, finds cross-domain agent vulnerabilities.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://lambda.ai/blog/prompt-injection-doesnt-care-what-your-agent-does-for-a-living","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"b7a3d186-3fa5-4168-8903-3121dbd58e91"},"content":[{"text":"Global · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▼ Bearish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#983838","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 18:34 UTC · Company/PR","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"c7beb207-dde4-4d6f-9794-462d2cd5f394"},"content":[{"text":"Lambda Labs analysed 1,433 winning prompt injection attacks and found that most organisations test agent security in siloed domains rather than evaluating cross-functional vulnerabilities.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"3542151f-ad9b-4208-bdb2-7a8df48c2c25","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"95287e12-c1a7-4279-aefa-85802fe5d56e"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Systemic security gaps in deployed AI agents across organisations, relevant for infrastructure operators running multi-tenant inference workloads and managing isolation between customer applications.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"602d606f-0463-498b-8964-e81755929ec7"},"content":[{"text":"Lambda","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://lambda.ai/blog/prompt-injection-doesnt-care-what-your-agent-does-for-a-living","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"0fc1ecaf-4df8-4146-84fc-6c78c66709fd","level":3,"anchorId":"s21-microsoft-announces-echoverse-enviro","anchorTitle":"Microsoft announces Echoverse environment for training computer-use agents","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Microsoft announces Echoverse environment for training computer-use agents.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.microsoft.com/en-us/research/blog/echoverse-deep-evolving-environments-for-computer-use-agents/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"c320d74f-133e-4391-9106-0aa0b58d68d2"},"content":[{"text":"Global · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 16:21 UTC · Company/PR","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"55a0dcc5-4d8f-4922-9bd0-41f138d96e3a"},"content":[{"text":"Microsoft announced Echoverse, a deep and evolving environment designed for training computer-use agents on complex, long-running tasks.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"44bb99bd-15e0-4157-b80b-c8bb8578b7ab","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"8a1516ec-ed44-42fc-86d1-2da59a12074c"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Microsoft's investment in agent training infrastructure, which will require sustained GPU compute capacity for model development and evaluation.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"1a608051-87b0-4a9b-aab8-2609baac0bb6"},"content":[{"text":"News Microsoft","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.microsoft.com/en-us/research/blog/echoverse-deep-evolving-environments-for-computer-use-agents/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"ad6f5257-5555-46f1-9fec-f2de320bd73c","level":3,"anchorId":"s22-driven-tech-joins-anthropic-s-cyber","anchorTitle":"Driven Tech Joins Anthropic's Cyber Verification Prog