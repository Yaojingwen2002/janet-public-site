'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"PR Newswire","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"http://www.prnewswire.com/news-releases/driven-tech-joins-anthropics-cyber-verification-program-to-advance-the-future-of-ai-powered-cyber-defense-302839694.html","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]}]},{"type":"paragraph","attrs":{"id":"6ab71f35-193f-41a5-8357-4da12afa81a8"},"content":[{"text":"HARDWARE · 6","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#A85820","fontSize":"0.75rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}},{"type":"bold","attrs":{}}]}]},{"type":"section","attrs":{"id":"9bf317dc-2482-4259-ab7a-1a8838b53686","marginTop":0,"marginLeft":0,"paddingTop":14,"borderColor":"#A85820","borderStyle":"solid","marginRight":0,"paddingLeft":18,"showInEmail":true,"marginBottom":18,"paddingRight":18,"paddingBottom":14,"showOnWebsite":true,"borderWidthTop":2,"backgroundColor":"#F4F2EE","borderWidthLeft":2,"borderWidthRight":2,"borderWidthBottom":2,"referralCondition":"lt","referralCountValue":0,"borderTopLeftRadius":0,"useIndividualMargin":false,"borderTopRightRadius":0,"showToNonSubscribers":true,"useIndividualPadding":false,"showToFreeSubscribers":true,"showToPaidSubscribers":true,"showWithReferralCount":false,"borderBottomLeftRadius":0,"borderBottomRightRadius":0,"showToTieredSubscribers":[],"useIndividualBorderWidth":false,"useIndividualBorderRadius":false},"content":[{"type":"heading","attrs":{"id":"c94d5631-71ff-4851-8d08-71c16e20b760","level":3,"anchorId":"s23-furiosaai-rngd-powers-ai-generated-o","anchorTitle":"FuriosaAI RNGD powers AI-generated overviews for Daum search, 500M tokens daily","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"FuriosaAI RNGD powers AI-generated overviews for Daum search, 500M tokens daily.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://furiosa.ai/blog/furiosa-rngd-powers-ai-generated-overviews-for-millions-of-users-on-daum","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"47a6b052-7df1-49ce-8e8f-e1a7f9177ef0"},"content":[{"text":"South Korea · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 00:00 UTC · Company/PR","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"b78e174c-3969-467c-95e0-60b859f3843b"},"content":[{"text":"Daum web portal search now runs on FuriosaAI's RNGD inference chip generating approximately 500 million tokens per day in production, delivering H200-class throughput at 180W air-cooled power envelope, company-stated.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"8073ef3c-6094-44ac-b4dd-50fcf12d3267","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"d7e92c27-e2d9-42c1-b6bc-dd4fd9939ce2"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Production deployment of Korean custom inference accelerator at scale, alternative to NVIDIA for inference workloads and demand for power-efficient inference chips.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"93d48597-f686-48a5-b4a6-6618176bce6f"},"content":[{"text":"Furiosa","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://furiosa.ai/blog/furiosa-rngd-powers-ai-generated-overviews-for-millions-of-users-on-daum","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"1332b50a-6bea-4b40-92e4-80e312be5b11","level":3,"anchorId":"s24-optical-transceiver-costs-now-exceed","anchorTitle":"Optical transceiver costs now exceed switch ports in AI cluster networks, reshaping economics","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Optical transceiver costs now exceed switch ports in AI cluster networks, reshaping economics.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.datacenterfrontier.com/machine-learning/podcast/55394057/ai-clusters-and-the-new-economics-of-data-center-optics-a-conversation-with-ciscos-bill-gartner","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"34476d10-1189-4da0-9dd3-136fd1464218"},"content":[{"text":"Global · ◆ Neutral · 28 Jul 15:50 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"fb63fc86-279f-4f6c-93d3-c3e7f0804f8a"},"content":[{"text":"Cisco reports optical transceiver costs have surpassed switch port costs at 400G and above, with link flaps from optical failures reducing GPU infrastructure efficiency by up to 40%, making optical reliability a compute-efficiency metric; Cisco is sampling 1.6-terabit optics with hyperscalers for volume deployment later this year.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"51c6db86-54ea-4fcf-a70b-e9996a65cc87","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"e8a6eadb-0c0e-475d-8040-d072bebfd3bc"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Shifts the cost and reliability bottleneck in AI cluster networks from switching to optics, forcing hyperscalers to rethink interconnect architecture and creating new vendor leverage for optical suppliers; co-packaged optics entering market this year will introduce multi-vendor sourcing and interoperability challenges.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"a8510c01-af13-4a42-a2df-0d17b708966d"},"content":[{"text":"Datacenterfrontier","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.datacenterfrontier.com/machine-learning/podcast/55394057/ai-clusters-and-the-new-economics-of-data-center-optics-a-conversation-with-ciscos-bill-gartner","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"b6904e8d-3c7b-4f92-9aa6-97067f799a04","level":3,"anchorId":"s25-supermicro-expands-dcbbs-with-precis","anchorTitle":"Supermicro Expands DCBBS with Precision-Engineered AI Rack Series to Accelerate Deployment and Time-to-Online","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Supermicro Expands DCBBS with Precision-Engineered AI Rack Series to Accelerate Deployment and Time-to-Online.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.thehindu.com/brandhub/pr-release/supermicro-expands-dcbbs-with-precision-engineered-ai-rack-series-to-accelerate-deployment-and-time-to-online/article71288856.ece","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"73f97fd2-2c30-4666-acfc-dbf30652d4d2"},"content":[{"text":"Global · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 03:00 UTC · Newsroom · 2 sources","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"424f6720-59d1-4876-933d-00377522d27f"},"content":[{"text":"Supermicro expanded its Data Centre Building Block System (DCBBS) with new AI-optimised rack designs to reduce deployment time and accelerate time-to-online.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"b359e616-ea0a-4efd-a679-94e437077bc3","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"414cd15d-b8bf-4642-b50a-919fe6174c97"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Shortens data centre deployment cycles for GPU clusters; faster rack integration reduces capex timeline and improves capacity ramp speed for hyperscalers and neoclouds.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"0eb40d7b-20d3-4200-a2df-9ab5d2983a42"},"content":[{"text":"The Hindu","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.thehindu.com/brandhub/pr-release/supermicro-expands-dcbbs-with-precision-engineered-ai-rack-series-to-accelerate-deployment-and-time-to-online/article71288856.ece","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","