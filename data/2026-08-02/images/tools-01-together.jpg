Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"3034dd9f-2aa0-4359-a9f0-4f2113b08469"},"content":[{"text":"Amazon CEO Andy Jassy stated in Q2 earnings that AWS AI workload demand is outpacing available GPU capacity and will continue to do so through 2027.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"08bb1860-e33a-45f6-a906-50b2393ca182","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"49f82d2e-4d72-4a76-8436-23f84a4f06e0"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Confirms sustained GPU shortage at the largest cloud operator, neocloud and independent GPU provider business models and justifying continued capex.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"fd0e0751-5a7e-4fa0-827a-67058a887889"},"content":[{"text":"Crn","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.crn.com/news/ai/2026/amazon-q2-earnings-aws-ai-demand-outpaces-capacity-through-2027-jassy-says","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"b328e9c6-b432-4ef1-999b-bf7c7a48e2f2","level":3,"anchorId":"s30-amazon-lifts-capex-guidance-after-st","anchorTitle":"Amazon lifts capex guidance after strong cloud sales","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Amazon lifts capex guidance after strong cloud sales.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.rte.ie/news/business/2026/0731/1585920-amazon-quarterly-results/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"c81b2ff8-f5e5-4008-beeb-41282d8d14b2"},"content":[{"text":"US · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 10:30 UTC · Newsroom · 2 sources","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"3c7a968e-7b79-41e0-a291-4c5db5e71621"},"content":[{"text":"Amazon increased investment plans following cloud revenue, continued GPU infrastructure expansion across AWS.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"df35a891-ab7e-4a86-8a4b-975500619025","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"7577b490-18cb-474a-9e29-a9672ab5ca12"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Confirms AWS capex acceleration tied to AI compute demand, likely including GPU procurement and data centre builds to compete with Azure and GCP.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"cf5d8344-3195-4756-9e81-8600962e665a"},"content":[{"text":"Rte Ie","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.rte.ie/news/business/2026/0731/1585920-amazon-quarterly-results/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"152adbd7-a888-49f5-be63-9ad5a7e9c62d","level":3,"anchorId":"s31-aws-aurora-dsql-adds-multi-region-cl","anchorTitle":"AWS Aurora DSQL adds multi-Region cluster support in four additional regions","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"AWS Aurora DSQL adds multi-Region cluster support in four additional regions.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://aws.amazon.com/about-aws/whats-new/2026/07/amazon-aurora-dsql-adds-multi-region-clusters-four-more-regions/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"653471f8-67b5-4c0e-9fb1-d140e4ca87de"},"content":[{"text":"Global · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 18:00 UTC · Company/PR","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"8dddb211-6015-4b72-a620-2a698e6e73a3"},"content":[{"text":"AWS Aurora DSQL now supports multi-Region clusters in Stockholm, Spain, Mumbai, and Singapore, bringing total availability to 16 AWS regions with active-active high availability and strong consistency.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"ea916651-1df8-4cde-9fad-c568d4c73a89","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"ae8bcfd0-faac-4805-a77f-35d8403c4014"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Expands geographic footprint for distributed database workloads, relevant for hyperscalers and neoclouds deploying inference and training infrastructure across multiple regions.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"412f868b-ba66-4479-bbe2-80d7cd334c23"},"content":[{"text":"Aws Amazon","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://aws.amazon.com/about-aws/whats-new/2026/07/amazon-aurora-dsql-adds-multi-region-clusters-four-more-regions/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"6fbf8870-ecd9-4e93-ae8a-fff479da026f","level":3,"anchorId":"s32-aws-launches-reserved-instances-for","anchorTitle":"AWS launches Reserved Instances for Oracle RDS R8i and M8i with custom Intel Xeon 6","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"AWS launches Reserved Instances for Oracle RDS R8i and M8i with custom Intel Xeon 6.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://aws.amazon.com/about-aws/whats-new/2026/07/amazon-rds-oracle-r8i-m8i/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"d6e48412-e7bf-4079-a9bf-196f0fc567a0"},"content":[{"text":"US · ◆ Neutral · 31 Jul 15:00 UTC · Company/PR","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"e0a9401b-ab29-42b9-936a-b179e8b0d66d"},"content":[{"text":"AWS introduced 1-year and 3-year Reserved Instances for Amazon RDS Oracle R8i and M8i instances using custom Intel Xeon 6 processors, offering up to 53% cost savings and 2.5x more memory bandwidth than previous Intel-based instances.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"0aeccc6e-4af2-44c7-841e-fa9857aff0e4","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"72c1953d-c811-4b07-8aa0-fa3ec544ccde"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" AWS's continued investment in custom server processors for database workloads, but does not directly impact GPU infrastructure or AI compute capacity.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"ba4fbef1-ccec-41a7-bef9-a3a3a6f42d27"},"content":[{"text":"Aws Amazon","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://aws.amazon.com/about-aws/whats-new/2026/07/amazon-rds-oracle-r8i-m8i/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]}]},{"type":"paragraph","attrs":{"id":"5f367455-fc90-4aca-b46d-4162abb1e2e3"},"content":[{"text":"ENERGY \u0026 POWER · 8","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#A85820","fontSize":"0.75rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}},{"type":"bold","attrs":{}}]}]},{"type":"section","attrs":{"id":"74736909-c75c-42e5-b198-960ca0b525a1","marginTop":0,"marginLeft":0,"paddingTop":14,"borderColor":"#A85820","borderStyle":"solid","marginRight":0,"paddingLeft":18,"showInEmail":true,"marginBottom":18,"paddingRight":18,"paddingBottom":14,"showOnWebsite":true,"borderWidthTop":2,"backgroundColor":"#F4F2EE","borderWidthLeft":2,"borderWidthRight":2,"borderWidthBottom":2,"referralCondition":"lt","referralCountValue":0,"borderTopLeftRadius":0,"useIndividualMargin":false,"borderTopRightRadius":0,"showToNonSubscribers":true,"useIndividualPadding":false,"showToFreeSubscribers":true,"showToPaidSubscribers":true,"showWithReferralCount":false,"borderBottomLeftRadius":0,"borderBottomRightRadius":0,"showToTieredSubscribers":[],"useIndividualBorderWidth":false,"useIndividualBorderRadius":false},"content":[{"type":"heading","attrs":{"id":"4bc8dbb5-a3fc-42be-bdaa-7662157213b8","level":3,"anchorId":"s33-google-kairos-walmart-advance-nuclea","anchorTitle":"Google, Kairos, Walmart advance nuclear power for data centres with 500MW pathway by 2035","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Google, Kairos, Walmart advance nuclear power for data centres with 500MW pathway by 2035.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.datacenterfrontier.com/energy/article/55394098/nuclear-momentum-meets-the-megawatt-test","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"3f889e89-6c1e-4e99-bbf3-e0ef8e405941"},"content":[{"text":"US · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 04:02 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"e79df77f-63f6-45c4-9450-7662c399c24a"},"content":[{"text":"Google and Kairos Power announced first utility PPA for advanced reactor electricity, targeting 50MW to TVA grid by 2030 with pathway to 500MW by 2035, plus separate Valar-NVIDIA Utah microgrid project with behind-the-meter advanced nuclear generation.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"57827f43-24f1-4419-be34-26c4e8559bbd","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"deb2033b-468e-40b0-8070-7a5599486aa2"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Establishes nuclear as binding constraint solution for hyperscaler AI data centre power, setting precedent for other operators and reducing reliance on grid capacity.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"6eb5c883-d0c1-4716-8cef-fff7b49ea006"},"content":[{"text":"Datacenterfrontier","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.datacenterfrontier.com/energy/article/55394098/nuclear-momentum-meets-the-megawatt-test","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"d675287d-7f0f-4a40-b5b4-7c5125f5ad2c","level":3,"anchorId":"s34-meta-breaks-ground-on-c-13b-alberta","anchorTitle":"Meta breaks ground on C$13B Alberta AI campus with dedicated 932 MW gas plant","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Meta breaks ground on C$13B Alberta AI campus with dedicated 932 MW gas plant.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.datacenterfrontier.com/hyperscale/article/55391399/metas-canadian-ai-data-center-a-new-model-for-infrastructure-and-energy-integration","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"51da0644-2322-43b9-9d7a-440045945672"},"content":[{"text":"Canada · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 29 Jul 16:54 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"462aaa91-2190-4b7c-a61b-5ad39f55248c"},"content":[{"text":"Meta began construction on a C$13 billion AI data centre campus in Sturgeon County, Alberta, initially 1 GW with potential to scale to 1.8 GW, paired with a dedicated 932 MW combined-cycle natural gas power plant (Greenlight Electricity Centre) scheduled to begin service in H2 2030.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"56eb362b-6ac3-4250-b6f7-9d40bb7f1006","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"f2921493-3dda-49b3-9a47-cc0f2bc3d300"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" The 'bring your own power' model becoming standard for hyperscaler AI builds as provincial grid capacity saturates; Alberta's 1,200 MW interim allocation for data centres is now fully assigned, forcing future projects to finance new generation.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"a0a4ad30-d2a6-4e83-b9ae-bf1891435f97"},"content":[{"text":"Datacenterfrontier","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.datacenterfrontier.com/hyperscale/article/55391399/metas-canadian-ai-data-center-a-new-model-for-infrastructure-and-energy-integration","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"e2eacebf-8cfa-470c-a6c1-5ec7acb1a165","level":3,"anchorId":"s35-spacex-delays-removal-of-unpermitted","anchorTitle":"SpaceX delays removal of unpermitted xAI turbines until July 2027","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"SpaceX delays removal of unpermitted xAI turbines until July 2027.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/2026/07/31/spacex-wont-remove-all-of-xais-unpermitted-turbines-for-another-year/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"a82bf0a2-b34b-4f4e-b747-22b84ec8c78d"},"content":[{"text":"US · ◆ Neutral · 31 Jul 15:16 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"bc852538-a5e2-48f1-b501-22e555700a6e"},"content":[{"text":"SpaceX will not fully remove unpermitted gas turbines powering xAI's Colossus data centres near Memphis until July 2027, despite federal regulations requiring permits; the company plans to purchase $2.8 billion in gas turbines over three years.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"98e450b6-6e59-4144-a756-25805faf51c2","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"f154153c-9efb-4fb2-9a1b-7988c0c4cf6e"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Reveals xAI's massive power infrastructure capex ($2.8B turbine spend) and regulatory friction around unpermitted generation, setting a precedent for how federal agencies balance energy security against environmental compliance in AI compute build-outs.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"d2c4dd04-a48b-42eb-9754-1c2a329ccc6f"},"content":[{"text":"TechCrunch","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://techcrunch.com/2026/07/31/spacex-wont-remove-all-of-xais-unpermitted-turbines-for-another-year/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"3a2c09e6-be11-4502-b646-91b6511af021","level":3,"anchorId":"s36-antora-energy-closes-550m-series-c-f","anchorTitle":"Antora Energy closes $550M Series C for thermal battery deployment","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Antora Energy closes $550M Series C for thermal battery deployment.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.energy-storage.news/antora-energy-closes-us550-million-series-c-to-scale-us-thermal-battery-deployment/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"d5ccc72f-ad69-40fb-8996-a875257d7bba"},"content":[{"text":"US · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 11:48 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"2197fbaa-3571-4568-a4e9-00a8baf83fa2"},"content":[{"text":"Antora Energy closed a $550M Series C led by G2 Venture Partners and Eclipse to scale thermal battery deployment across US industrial facilities and data centres, with Big Stone 5GWh system operational in South Dakota.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"b8c444c7-cef8-4c59-82a3-480ff1a70362","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"3d74617c-c126-4b97-b863-174578e17d8e"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Thermal storage at data centre scale offers alternative to battery BESS for load shifting and peak shaving; Antora's thermophotovoltaic conversion at 2,400°C adds dispatchable capacity option.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"8d83f92b-d69c-4318-9b9a-1ee14413fd47"},"content":[{"text":"Energy-storage News","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.energy-storage.news/antora-energy-closes-us550-million-series-c-to-scale-us-thermal-battery-deployment/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"2a397d77-d040-429e-8d34-e4452fb704ae","level":3,"anchorId":"s37-world-nuclear-association-projects-1","anchorTitle":"World Nuclear Association projects 1,446GW global nuclear capacity by 2050","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"World Nuclear Association projects 1,446GW global nuclear capacity by 2050.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.world-nuclear-news.org/articles/podcast-the-making-of-the-world-nuclear-investment-guide","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"6ce64420-bafd-461f-bf5f-eec8650ed3e5"},"content":[{"text":"Global · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 11:34 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"ee7a26a8-1ddd-4dae-a597-76ebebaa0a7b"},"content":[{"text":"World Nuclear Association projects global nuclear capacity could reach 1,446GW by 2050, up from 403GW currently, requiring USD 6 trillion in investment through 2050 (USD 250B annually), and published World Nuclear Investment Guide to standardise project financing.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"a736807a-3d41-45d7-a0f9-bf62c4cab68b","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"4d89b36c-248d-4d52-af32-d62f774025a8"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Establishes financing frameworks for nuclear deployment at data centre scale; standardised project structures critical to scaling from tens of billions to hundreds of billions annually for AI compute power supply.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"d6e1ba28-bb38-49b8-ba4f-8469638fa8bf"},"content":[{"text":"World-nuclear-news","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.world-nuclear-news.org/articles/podcast-the-making-of-the-world-nuclear-investment-guide","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"57d24c4a-2331-4c37-90c4-fe10d4ebc551","level":3,"anchorId":"s38-uw-madison-nuclear-engineering-depar","anchorTitle":"UW-Madison nuclear engineering department expands to 150+ undergraduates, launches fusion plasma focus","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"UW-Madison nuclear engineering department expands to 150+ undergraduates, launches fusion plasma focus.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.ans.org/news/2026-07-31/article-8163/uwmadison-a-midwestern-nucleus-of-fission-and-fusion/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"d4fcdfc1-ff7e-4fd1-8bdd-7dcaffdd1f8a"},"content":[{"text":"US · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 19:56 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"29eec207-5a97-4adc-98a1-670767c2dfc3"},"content":[{"text":"University of Wisconsin-Madison nuclear engineering department grew from 60 to 150+ undergraduates and 12 to 17 faculty in three years, launching a new fusion plasma focus area in 2025 as part of state-funded nuclear energy siting study.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"55beb497-7e92-495b-a725-4bdfdffc51d4","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"8862080c-551e-4a3a-9db0-e9d5469dc2d8"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Accelerating academic pipeline for nuclear engineering talent, relevant as data centre operators and hyperscalers pursue SMR and advanced reactor partnerships for on-site power generation.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"7b757a92-9ccd-4a29-a7bc-4669e31dd226"},"content":[{"text":"Ans","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.ans.org/news/2026-07-31/article-8163/uwmadison-a-midwestern-nucleus-of-fission-and-fusion/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"ee50a1ae-fe41-4def-b723-e9ebfd307890","level":3,"anchorId":"s39-arc-partners-with-idaho-national-lab","anchorTitle":"ARC partners with Idaho National Lab to deploy 100MWe sodium reactor","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"ARC partners with Idaho National Lab to deploy 100MWe sodium reactor.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.ans.org/news/2026-07-31/article-8260/arc-partners-with-inl-for-first-reactor-deployment/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"13654b4b-5475-4511-9e8d-f97e6cc65647"},"content":[{"text":"US · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 12:41 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"a6cbfba4-d92f-4529-995c-02baf981b89e"},"content":[{"text":"ARC Clean Technology entered a Strategic Partnership Project agreement with Idaho National Laboratory to design, demonstrate, and deploy its ARC-100, a 100-MWe sodium-cooled fast reactor, with deployment targeted for mid-2030s.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"18e4bccf-ad55-461f-a275-c26f988d2052","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"3643193e-6cfc-46c9-9379-89c1122dd41c"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Advances SMR deployment pathway for data centre power supply; ARC received $27.5M DOE funding in 2020 and progresses through NRC licensing under 10 CFR Part 53.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"0e7d8519-583f-4c85-a87d-6dc3d7535be2"},"content":[{"text":"Ans","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.ans.org/news/2026-07-31/article-8260/arc-partners-with-inl-for-first-reactor-deployment/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"e5a3f766-292e-463f-bcf6-2ac04c057ab3","level":3,"anchorId":"s40-greenvolt-inaugurates-200mw-800mwh-b","anchorTitle":"Greenvolt inaugurates 200MW/800MWh battery storage in Poland","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"Greenvolt inaugurates 200MW/800MWh battery storage in Poland.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.energy-storage.news/greenvolt-inaugurates-200mw-800mwh-capacity-market-contracted-bess-in-poland/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"a61788ba-c98a-44a1-a4c9-d1edcb80d650"},"content":[{"text":"Poland · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 10:40 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"0ef3397e-c394-41c7-b031-9929735982ba"},"content":[{"text":"Greenvolt inaugurated the Turośń Kościelna Battery Energy Storage Facility, a 200MW/800MWh (4-hour) BESS in Poland with a 17-year capacity market contract at 170MW obligation (85% of nameplate output).","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"ced98b26-7492-48b2-9538-9815798856af","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"095c1275-65f2-443c-8ae2-b82ed22bb608"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Adds 200MW of grid-scale battery storage in PJM-adjacent market; capacity market contract at PLN 244.90/kW (~$61.73/year) sets European BESS pricing benchmark for data centre load shifting.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"2b22a992-a6fc-4ed1-a61c-4d34e35039cb"},"content":[{"text":"Energy-storage News","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.energy-storage.news/greenvolt-inaugurates-200mw-800mwh-capacity-market-contracted-bess-in-poland/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]}]},{"type":"paragraph","attrs":{"id":"17a8c317-571c-4b30-a1ba-33baad879491"},"content":[{"text":"REGULATION \u0026 POLICY · 5","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#A85820","fontSize":"0.75rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}},{"type":"bold","attrs":{}}]}]},{"type":"section","attrs":{"id":"10672761-198f-43df-93e6-4549ed4af769","marginTop":0,"marginLeft":0,"paddingTop":14,"borderColor":"#A85820","borderStyle":"solid","marginRight":0,"paddingLeft":18,"showInEmail":true,"marginBottom":18,"paddingRight":18,"paddingBottom":14,"showOnWebsite":true,"borderWidthTop":2,"backgroundColor":"#F4F2EE","borderWidthLeft":2,"borderWidthRight":2,"borderWidthBottom":2,"referralCondition":"lt","referralCountValue":0,"borderTopLeftRadius":0,"useIndividualMargin":false,"borderTopRightRadius":0,"showToNonSubscribers":true,"useIndividualPadding":false,"showToFreeSubscribers":true,"showToPaidSubscribers":true,"showWithReferralCount":false,"borderBottomLeftRadius":0,"borderBottomRightRadius":0,"showToTieredSubscribers":[],"useIndividualBorderWidth":false,"useIndividualBorderRadius":false},"content":[{"type":"heading","attrs":{"id":"9143c3c3-1039-4639-863b-4bbc8f403113","level":3,"anchorId":"s41-china-s-15th-five-year-plan-targets","anchorTitle":"China's 15th Five-Year Plan targets 25% non-fossil energy share by 2030","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"China's 15th Five-Year Plan targets 25% non-fossil energy share by 2030.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.energy-storage.news/chinas-15th-five-year-carbon-peaking-action-plan-aims-to-accelerate-shift-of-energy-mix-from-coal-dominant/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"4c4df35d-2301-4055-9ec1-f325f92d2e25"},"content":[{"text":"China · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▼ Bearish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#983838","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 05:40 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"8c2533c2-2c25-48b1-8377-421a7579af7f"},"content":[{"text":"China's 15th Five-Year Carbon Peaking Action Plan sets 2030 targets of 17% CO2 reduction per unit GDP and 25% non-fossil energy share, with computing centres consuming 170 billion kWh in 2025 projected to reach 800 billion kWh by 2030.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"9e789d19-5ad8-42fd-8133-1211e8f006c0","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"ae6ef3b5-8fb3-485d-8e56-84dde1b12b3c"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Mandates non-fossil energy sourcing for new computing facilities and phase-out of inefficient equipment, directly constraining data centre expansion and raising power procurement costs.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"f287435d-6e33-4fe3-8996-2620714108e4"},"content":[{"text":"Energy-storage News","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.energy-storage.news/chinas-15th-five-year-carbon-peaking-action-plan-aims-to-accelerate-shift-of-energy-mix-from-coal-dominant/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"5cf210ef-e96d-4193-aee4-0ecdec87bcea","level":3,"anchorId":"s42-doe-admits-canceling-billions-in-awa","anchorTitle":"DOE admits canceling billions in awards based on project location in blue states","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"DOE admits canceling billions in awards based on project location in blue states.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.latitudemedia.com/news/the-new-legal-landscape-for-canceled-doe-awards/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"265ed9a9-e905-4b32-b667-fd550913a2fd"},"content":[{"text":"US · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▼ Bearish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#983838","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 30 Jul 20:35 UTC · Trade press","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"53a2eee4-c5ea-4814-a9ef-f978dee51583"},"content":[{"text":"DOE admitted in federal court that it canceled billions in funding based solely on project location in blue states, violating Fifth Amendment equal protection rights, with City of St. Paul and American Institute of Chemical Engineers winning lawsuits overturning seven and 11 canceled awards.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"148ad1ea-d157-4437-b809-e221ba06d2a3","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"4ab5161a-5b05-49d8-84f8-5edf6f89165b"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Regulatory uncertainty and litigation risk for energy infrastructure projects, including data centre power supply and hydrogen hub funding, raising project timelines and financing costs.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"f27496c4-6483-4b40-b0c0-be04bf6ba420"},"content":[{"text":"Latitudemedia","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.latitudemedia.com/news/the-new-legal-landscape-for-canceled-doe-awards/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"a23e3758-533a-4996-9551-38c895e6adb2","level":3,"anchorId":"s43-eu-targets-domestic-ai-chip-manufact","anchorTitle":"EU targets domestic AI chip manufacturing with gigafactory programme","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"EU targets domestic AI chip manufacturing with gigafactory programme.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.dw.com/en/eu-aims-to-build-ai-gigafactories-of-its-own/a-78179533","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"d5b8c9b6-3735-45f5-b79b-46a4a089ae90"},"content":[{"text":"EU · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 30 Jul 16:00 UTC · Newsroom · 2 sources","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"ccaa63d4-f635-4726-ad09-ac8c240192c1"},"content":[{"text":"EU aims to build its own AI gigafactories to reduce dependence on foreign semiconductor suppliers, a shift toward sovereign compute capacity.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"676c9fd9-f75b-44bf-97f6-512fa4add430","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"0cc0bf6f-f4a8-40f5-bbc3-3f1705bd704e"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" Potential fragmentation of the global GPU supply chain and new capex opportunities for European data centre and chip infrastructure, but faces technical and capital barriers against NVIDIA and TSMC dominance.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"0526ebaa-3f3a-47a5-aa0f-f39e9365fe41"},"content":[{"text":"Dw","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://www.dw.com/en/eu-aims-to-build-ai-gigafactories-of-its-own/a-78179533","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"a032ecf6-e086-423c-8aaf-f935a6719974","level":3,"anchorId":"s44-us-seeks-japan-s-top-tech-companies","anchorTitle":"US seeks Japan's top tech companies for AI-powered Genesis Mission","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"US seeks Japan's top tech companies for AI-powered Genesis Mission.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://asia.nikkei.com/editor-s-picks/interview/us-wants-japan-s-top-tech-companies-in-ai-powered-genesis-mission-official","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"b9363591-5b68-4bba-b1dd-0f21f1132b20"},"content":[{"text":"US, Japan · ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":"▲ Bullish","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#2A7A6E","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]},{"text":" · 31 Jul 20:15 UTC · Newsroom","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"77638ad8-34d4-4f7b-bc6e-979be7d23b5f"},"content":[{"text":"US officials are recruiting Japan's leading technology companies for an AI-powered Genesis Mission programme.","type":"text"}]},{"type":"blockquoteFigure","attrs":{"id":"51a05eec-277c-47cb-965a-a93f0545d17e","variant":"1"},"content":[{"type":"quote","content":[{"type":"paragraph","attrs":{"id":"99594833-127b-4501-8d99-468d3ebcba9c"},"content":[{"text":"Why this matters:","type":"text","marks":[{"type":"bold","attrs":{}}]},{"text":" US-Japan technology partnership on AI infrastructure, potentially affecting chip supply chains and compute procurement.","type":"text"}]}]},{"type":"quoteCaption"}]},{"type":"paragraph","attrs":{"id":"03407bb1-ef20-451b-a84d-dfa294daa0cf"},"content":[{"text":"Asia Nikkei","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://asia.nikkei.com/editor-s-picks/interview/us-wants-japan-s-top-tech-companies-in-ai-powered-genesis-mission-official","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"horizontalRule"},{"type":"heading","attrs":{"id":"955992f3-b3d9-4535-8a68-f77b02a1ffea","level":3,"anchorId":"s45-ovhcloud-contests-canadian-productio","anchorTitle":"OVHcloud contests Canadian production order charges","anchorIdSync":false,"anchorTitleSync":true},"content":[{"text":"OVHcloud contests Canadian production order charges.","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://blog.ovhcloud.com/en/posts/ovhcloud-contests-canadian-production-order-charges/","class":null,"color":null,"target":"_blank"}}]}]},{"type":"paragraph","attrs":{"id":"9251e887-e2c1-413e-8cd2-b25e2a014617"},"content":[{"text":"Canada · ◆ Neutral · 31 Jul 12:00 UTC · Company/PR","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#6A6864","fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]},{"type":"paragraph","attrs":{"id":"a0fec470-b38a-4f94-8d9e-e5bf071b00fa"},"content":[{"text":"OVH Groupe and its Canadian subsidiary were charged on July 31, 2026 for failure to comply with a production order and obstruction of justice; OVHcloud stated it will contest the charges fully.","type":"text"}]},{"type":"paragraph","attrs":{"id":"f23442c6-49a1-4cc6-aa72-8906515ad8c4"},"content":[{"text":"Blog Ovhcloud","type":"text","marks":[{"type":"link","attrs":{"rel":"noopener noreferrer nofollow","href":"https://blog.ovhcloud.com/en/posts/ovhcloud-contests-canadian-production-order-charges/","class":null,"color":null,"target":"_blank"}},{"type":"textStyle","attrs":{"color":null,"fontSize":"0.6875rem","fontFamily":"Space Mono,Courier,'Lucida Console',Monaco,monospace","fontWeight":null}}]}]}]},{"type":"poll","attrs":{"id":"f28670cc-6e74-4cb3-867b-9a34e1470339","pollId":"a9ed3dad-51fd-48d9-a307-09c6c9efaed9","showOptionsInitially":false,"data":{"poll_id":"a9ed3dad-51fd-48d9-a307-09c6c9efaed9","poll_type":"voting","poll_style":"default","poll_list_style":"none","poll_choices":[{"id":"682c610b-3fe2-4b4d-8d75-fd569ec73837","response_url":"https://thegpu.ai/login","label":"Y