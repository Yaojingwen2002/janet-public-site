    }

    html.js .benchmark-radar.is-radar-pending .benchmark-radar-series--hero :is(.benchmark-radar-area, .benchmark-radar-segment, .benchmark-radar-point),
    html.js .benchmark-radar.is-radar-visible .benchmark-radar-series--hero :is(.benchmark-radar-area, .benchmark-radar-segment, .benchmark-radar-point),
    html.js .benchmark-radar.is-radar-pending .benchmark-radar-series:not(.benchmark-radar-series--hero),
    html.js .benchmark-radar.is-radar-visible .benchmark-radar-series:not(.benchmark-radar-series--hero) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 620px) {
    #main article.content .benchmark-radar-legend {
      justify-content: center;
    }

     
    .benchmark-radar-scroll {
      overflow-x: visible;
    }

    .benchmark-radar-svg {
      min-width: 0;
      width: 100%;
      height: auto;
    }

    .benchmark-radar-svg text {
      font-size: 21px;
    }

    .benchmark-radar-svg .benchmark-radar-tick {
      font-size: 19px;
    }
  }
</style>

<div class="benchmark-radar-figure">
  <div class="benchmark-radar" id="benchmark-radar-small">
    <div class="benchmark-radar-scroll">
      <svg class="benchmark-radar-svg" data-benchmark-radar viewBox="0 0 860 600" role="img" aria-label="Inkling benchmark comparison" aria-describedby="benchmark-radar-desc-small">
        <desc id="benchmark-radar-desc-small">Spider chart comparing Inkling-Small, Inkling, DeepSeek V4 Flash, Gemini 3.5 Flash-Lite, and GPT 5.6 Luna on ten evaluations scored from zero to one hundred. Inkling-Small is shown with a solid purple line, Inkling with the heavier cobalt line, and the comparison models with dashed lines. Evaluations without a reported model score are plotted at zero. Hover an evaluation to compare every model's score.</desc>
        <g data-radar-grid></g>
        <g data-radar-axes></g>
        <g data-radar-series></g>
        <g data-radar-labels></g>
      </svg>
    </div>
    <div class="benchmark-radar-legend" aria-label="Model legend">
      <span class="benchmark-radar-legend-pill" data-radar-legend-pill aria-hidden="true"></span>
      <button class="benchmark-radar-legend-item" type="button" data-radar-model="inklingsmall">
        <span class="benchmark-radar-key benchmark-radar-key--inklingsmall benchmark-radar-key--hero" aria-hidden="true"></span>
        Inkling-Small
      </button>
      <button class="benchmark-radar-legend-item" type="button" data-radar-model="inkling">
        <span class="benchmark-radar-key benchmark-radar-key--inkling" aria-hidden="true"></span>
        Inkling
      </button>
      <button class="benchmark-radar-legend-item" type="button" data-radar-model="deepseek">
        <span class="benchmark-radar-key benchmark-radar-key--deepseek" aria-hidden="true"></span>
        DeepSeek V4 Flash
      </button>
      <button class="benchmark-radar-legend-item" type="button" data-radar-model="gemini">
        <span class="benchmark-radar-key benchmark-radar-key--gemini" aria-hidden="true"></span>
        Gemini 3.5 Flash-Lite
      </button>
      <button class="benchmark-radar-legend-item" type="button" data-radar-model="luna">
        <span class="benchmark-radar-key benchmark-radar-key--luna" aria-hidden="true"></span>
        GPT 5.6 Luna
      </button>
    </div>
    <div class="benchmark-radar-tooltip tooltip" data-radar-tooltip role="tooltip" aria-hidden="true">
      <div class="benchmark-radar-tooltip-title" data-radar-tooltip-title></div>
      <div data-radar-tooltip-rows></div>
    </div>
  </div>
</div>

<script>
  (() => {
    const radar = document.getElementById('benchmark-radar-small');
    const heroSlug = 'inklingsmall';
    const svg = radar && radar.querySelector('[data-benchmark-radar]');
    if (!radar || !svg) return;

    const initialize = () => {
      if (svg.dataset.ready === 'true') return;
      svg.dataset.ready = 'true';

    const ns = 'http://www.w3.org/2000/svg';
    const center = { x: 430, y: 300 };
    const radius = 220;
    const metrics = [
      { name: 'HLE (no tools)', category: 'Reasoning' },
      { name: 'AIME 2026', category: 'Reasoning' },
      { name: 'SWE-bench Pro (Public)', category: 'Agentic (coding)' },
      { name: 'Terminal Bench 2.1', category: 'Agentic (coding)' },
      

      { name: 'MCP Atlas (public)', category: 'Agentic (general)' },
      { name: 'SimpleQA Verified', category: 'Factuality' },
      { name: 'AA Omniscience (acc)', category: 'Factuality' },
      { name: 'AudioMC', category: 'Audio' },
      { name: 'MMMU Pro', category: 'Vision' },
      { name: 'IFBench', category: 'Chat' }
    ];
    const models = [
      

      {
        name: 'Inkling-Small', slug: 'inklingsmall', color: 'var(--radar-inklingsmall)', dash: '', fillOpacity: 0.12,
        values: [31.6, 95.5, 55.9, 64.7, 79.6, 20.6, 30.5, 54.9, 74.0, 82.2]
      },
      {
        

        

        name: 'Inkling', slug: 'inkling', color: 'var(--radar-inkling)', dash: '12 4', fillOpacity: 0.035,
        values: [29.7, 97.1, 54.3, 63.8, 78.8, 43.9, 40.0, 56.6, 73.5, 79.8]
      },
      

      {
        name: 'DeepSeek V4 Flash', slug: 'deepseek', color: 'var(--radar-deepseek)', dash: '2 4', fillOpacity: 0.035,
        values: [32.1, 95.8, 52.6, 61.8, 69.0, 34.1, 37.2, null, null, 79.2]
      },
      {
        name: 'Gemini 3.5 Flash-Lite', slug: 'gemini', color: 'var(--radar-gemini)', dash: '9 4 2 4', fillOpacity: 0.035,
        values: [17.5, 82.2, 54.2, 54.0, 79.8, 44.1, 30.3, 33.6, 79.0, 78.6]
      },
      {
        name: 'GPT 5.6 Luna', slug: 'luna', color: 'var(--radar-luna)', dash: '6 4', fillOpacity: 0.035,
        values: [35.6, 97.6, 62.7, 82.5, 77.0, 41.7, 41.3, null, 78.6, 67.3]
      },
    ];

    const create = (tag, attrs = {}) => {
      const node = document.createElementNS(ns, tag);
      Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));
      return node;
    };
    const point = (index, value, extra = 0) => {
      const angle = -Math.PI / 2 + index * Math.PI * 2 / metrics.length;
      const distance = radius * value / 100 + extra;
      return {
        x: center.x + Math.cos(angle) * distance,
        y: center.y + Math.sin(angle) * distance,
        ux: Math.cos(angle),
        uy: Math.sin(angle)
      };
    };
    const modelGeometry = models.map((model) => {
      const points = model.values.map((value, index) => {
        const score = value ?? 0;
        return { index, value: score, ...point(index, score) };
      });
      const segments = points.map((from, pointIndex) => ({
        from,
        to: points[(pointIndex + 1) % points.length]
      }));
      return { model, points, segments };
    });
    const pointsAttr = (value) => metrics.map((_, index) => {
      const p = point(index, value);
      return `${p.x.toFixed(2)},${p.y.toFixed(2)}`;
    }).join(' ');

    const grid = svg.querySelector('[data-radar-grid]');
    [20, 40, 60, 80, 100].forEach((value) => {
      grid.append(create('polygon', { class: 'benchmark-radar-grid', points: pointsAttr(value) }));
      const p = point(0, value);
      const tick = create('text', {
        class: 'benchmark-radar-tick benchmark-radar-tick--detail',
        x: p.x + 7,
        y: p.y + 16
      });
      tick.textContent = value;
      grid.append(tick);
    });

    const axes = svg.querySelector('[data-radar-axes]');
    metrics.forEach((_, index) => {
      const p = point(index, 100);
      axes.append(create('line', {
        class: 'benchmark-radar-axis',
        x1: center.x, y1: center.y, x2: p.x, y2: p.y
      }));
    });

    const seriesLayer = svg.querySelector('[data-radar-series]');
    [...modelGeometry].reverse().forEach(({ model, points }) => {
      const group = create('g', {
        class: `benchmark-radar-series benchmark-radar-series--${model.slug}` + (model.slug === heroSlug ? ' benchmark-radar-series--hero' : '')
      });

      const areaPath = points.map((p, index) => `${index === 0 ? 'M' : 'L'} ${p.x.toFixed(2)} ${p.y.toFixed(2)}`).join(' ') + ' Z';
      group.append(create('path', {
        class: 'benchmark-radar-area',
        d: areaPath,
        fill: model.color,
        'fill-opacity': model.fillOpacity
      }));

      points.forEach((from, pointIndex) => {
        const to = points[(pointIndex + 1) % points.length];
        const segment = create('line', {
          class: 'benchmark-radar-segment',
          x1: from.x, y1: from.y, x2: to.x, y2: to.y,
          stroke: model.color
        });
        if (model.dash) segment.setAttribute('stroke-dasharray', model.dash);
        group.append(segment);
      });

      points.forEach((p) => {
        const marker = create('circle', {
          class: 'benchmark-radar-point',
          cx: p.x, cy: p.y, r: model.slug === heroSlug ? 5 : 4.5,
          stroke: model.color,
          style: `--radar-point-delay: ${p.index * 55}ms`
        });
        group.append(marker);
      });
      seriesLayer.append(group);
    });

    const labels = svg.querySelector('[data-radar-labels]');
    metrics.forEach((metric, index) => {
      const p = point(index, 100, 28);
      const target = create('g', {
        class: 'benchmark-radar-label-target',
        'data-radar-metric-index': index
      });
      const label = create('text', { class: 'benchmark-radar-label', x: p.x, y: p.y + 5 });
      label.setAttribute('text-anchor', p.ux > 0.24 ? 'start' : p.ux < -0.24 ? 'end' : 'middle');
      const title = create('tspan', { class: 'benchmark-radar-label-title', x: p.x, dy: 0 });
      title.textContent = metric.name;
      const category = create('tspan', { class: 'benchmark-radar-label-category', x: p.x, dy: '1.3em' });
      category.textContent = metric.category;
      label.append(title, category);
      target.append(label);
      labels.append(target);

      

      const box = svg.viewBox.baseVal;
      const first = label.getBBox();
      const parenthetical = metric.name.match(/^(.*\S)\s+(\(.*\))$/);
      if (parenthetical && (first.x < box.x || first.x + first.width > box.x + box.width)) {
        title.textContent = parenthetical[1];
        const rest = create('tspan', { class: 'benchmark-radar-label-title', x: p.x, dy: '1.15em' });
        rest.textContent = parenthetical[2];
        label.insertBefore(rest, category);
      }

      const bounds = label.getBBox();
      target.insertBefore(create('rect', {
        class: 'benchmark-radar-label-hit',
        x: bounds.x - 8,
        y: bounds.y - 6,
        width: bounds.width + 16,
        height: bounds.height + 12,
        rx: 4
      }), label);
    });

    const tooltip = radar.querySelector('[data-radar-tooltip]');
    const tooltipTitle = tooltip.querySelector('[data-radar-tooltip-title]');
    const tooltipRows = tooltip.querySelector('[data-radar-tooltip-rows]');
    const scrollContainer = radar.querySelector('.benchmark-radar-scroll');
    let activeMetricIndex = -1;

    const formatTooltipValue = (metric, value) => {
      if (value != null) return value.toFixed(1);
      if (metric.category === 'Audio') return 'audio not supported';
      if (metric.category === 'Vision') return 'vision not supported';
      return '0.0 - not reported';
    };

    models.forEach((model) => {
      const row = document.createElement('div');
      row.className = 'benchmark-radar-tooltip-row';
      row.dataset.radarTooltipModel = model.slug;

      const dot = document.createElement('span');
      dot.className = 'benchmark-radar-tooltip-dot';
      dot.style.background = model.color;
      dot.setAttribute('aria-hidden', 'true');

      const name = document.createElement('span');
      name.textContent = model.name;

      const value = document.createElement('span');
      value.className = 'benchmark-radar-tooltip-value';
      value.dataset.radarTooltipValue = '';

      row.append(dot, name, value);
      tooltipRows.append(row);
    });

    const positionTooltip = (metricIndex) => {
      if (metricIndex < 0) return;
      const rootRect = radar.getBoundingClientRect();
      const svgRect = svg.getBoundingClientRect();
      const viewBox = svg.viewBox.baseVal;
      const anchor = point(metricIndex, 100, 24);
      const anchorX = svgRect.left - rootRect.left + (anchor.x - viewBox.x) * svgRect.width / viewBox.width;
      const anchorY = svgRect.top - rootRect.top + (anchor.y - viewBox.y) * svgRect.height / viewBox.height;
      const gap = 12;
      const inset = 8;
      const tooltipWidth = tooltip.offsetWidth;
      const tooltipHeight = tooltip.offsetHeight;
      const rootWidth = radar.clientWidth;
      const rootHeight = radar.clientHeight;
      const placeBelow = anchorY < rootHeight * 0.48;
      const left = Math.min(Math.max(anchorX - tooltipWidth / 2, inset), rootWidth - tooltipWidth - inset);
      const preferredTop = placeBelow ? anchorY + gap : anchorY - tooltipHeight - gap;
      const top = Math.min(Math.max(preferredTop, inset), rootHeight - tooltipHeight - inset);
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;
    };

    const showMetricTooltip = (metricIndex) => {
      activeMetricIndex = metricIndex;
      tooltipTitle.textContent = metrics[metricIndex].name;
      models.forEach((model) => {
        const value = model.values[metricIndex];
        const formattedValue = formatTooltipValue(metrics[metricIndex], value);
        const valueElement = tooltip.querySelector(`[data-radar-tooltip-model="${model.slug}"] [data-radar-tooltip-value]`);
        valueElement.textContent = formattedValue;
        valueElement.classList.toggle('is-missing', value == null);
        valueElement.parentElement.setAttribute('aria-label', `${model.name}: ${formattedValue}`);
      });
      labels.children[metricIndex].classList.add('is-hovered');
      tooltip.setAttribute('aria-hidden', 'false');
      positionTooltip(metricIndex);
    };

    const hideMetricTooltip = () => {
      if (activeMetricIndex >= 0) labels.children[activeMetricIndex].classList.remove('is-hovered');
      activeMetricIndex = -1;
      tooltip.setAttribute('aria-hidden', 'true');
    };

    labels.querySelectorAll('[data-radar-metric-index]').forEach((target) => {
      const index = Number(target.dataset.radarMetricIndex);
      target.addEventListener('pointerenter', () => showMetricTooltip(index));
      target.addEventListener('pointerleave', hideMetricTooltip);
    });

    scrollContainer.addEventListener('scroll', () => positionTooltip(activeMetricIndex), { passive: true });
    window.addEventListener('resize', () => positionTooltip(activeMetricIndex));

    const legendItems = [...radar.querySelectorAll('[data-radar-model]')];
    const legendPill = radar.querySelector('[data-radar-legend-pill]');
    let hoveredModel = '';
    let chartHoveredModel = '';
    let focusedModel = '';
    let selectedModel = '';
    let suppressedHoveredModel = '';
    let suppressedFocusedModel = '';
    let hoverClearTimer = 0;

    const positionLegendPill = (item) => {
      if (!item) {
        legendPill.classList.remove('is-visible');
        return;
      }

      if (legendPill.dataset.ready !== 'true') {
        legendPill.style.transition = 'none';
      }
      legendPill.style.width = `${item.offsetWidth}px`;
      legendPill.style.height = `${item.offsetHeight}px`;
      legendPill.style.transform = `translate3d(${item.offsetLeft}px, ${item.offsetTop}px, 0)`;
      legendPill.classList.add('is-visible');

      if (legendPill.dataset.ready !== 'true') {
        legendPill.getBoundingClientRect();
        legendPill.style.transition = '';
        legendPill.dataset.ready = 'true';
      }
    };

    const getActiveModel = () => {
      const hoverPreview = hoveredModel === suppressedHoveredModel ? '' : hoveredModel;
      const focusPreview = focusedModel === suppressedFocusedModel ? '' : focusedModel;
      return hoverPreview || chartHoveredModel || focusPreview || selectedModel;
    };

    const updateActiveModel = () => {
      const activeModel = getActiveModel();
      radar.classList.toggle('is-radar-filtered', Boolean(activeModel));
      if (activeModel) {
        radar.dataset.activeModel = activeModel;
      } else {
        delete radar.dataset.activeModel;
      }
      legendItems.forEach((item) => {
        item.classList.toggle('is-active', item.dataset.radarModel === activeModel);
        item.setAttribute('aria-pressed', String(item.dataset.radarModel === selectedModel));
      });
      positionLegendPill(legendItems.find((item) => item.dataset.radarModel === activeModel));
    };

    legendItems.forEach((item) => {
      item.setAttribute('aria-pressed', 'false');
      item.addEventListener('pointerenter', () => {
        window.clearTimeout(hoverClearTimer);
        if (suppressedHoveredModel && suppressedHoveredModel !== item.dataset.radarModel) {
          suppressedHoveredModel = '';
        }
        hoveredModel = item.dataset.radarModel;
        updateActiveModel();
      });
      item.addEventListener('pointerleave', () => {
        window.clearTimeout(hoverClearTimer);
        hoverClearTimer = window.setTimeout(() => {
          hoveredModel = '';
          if (suppressedHoveredModel === item.dataset.radarModel) suppressedHoveredModel = '';
          updateActiveModel();
        }, 90);
      });
      item.addEventListener('focus', () => {
        if (suppressedFocusedModel && suppressedFocusedModel !== item.dataset.radarModel) {
          suppressedFocusedModel = '';
        }
        focusedModel = item.dataset.radarModel;
        updateActiveModel();
      });
      item.addEventListener('blur', () => {
        focusedModel = '';
        if (suppressedFocusedModel === item.dataset.radarModel) suppressedFocusedModel = '';
        updateActiveModel();
      });
      item.addEventListener('click', () => {
        const model = item.dataset.radarModel;
        if (selectedModel === model) {
          selectedModel = '';
          suppressedHoveredModel = model;
          suppressedFocusedModel = model;
        } else {
          selectedModel = model;
          suppressedHoveredModel = '';
          suppressedFocusedModel = '';
        }
        updateActiveModel();
      });
    });

    const distanceToSegment = (cursor, from, to) => {
      const dx = to.x - from.x;
      const dy = to.y - from.y;
      const lengthSquared = dx * dx + dy * dy;
      const t = lengthSquared === 0
        ? 0
        : Math.max(0, Math.min(1, ((cursor.x - from.x) * dx + (cursor.y - from.y) * dy) / lengthSquared));
      const x = from.x + dx * t;
      const y = from.y + dy * t;
      return {
        distance: Math.hypot(cursor.x - x, cursor.y - y),
        score: from.value + (to.value - from.value) * t
      };
    };

    const hitTestModel = (event) => {
      if (event.pointerType === 'touch' || event.target.closest?.('.benchmark-radar-label-target')) return '';

      const matrix = svg.getScreenCTM();
      if (!matrix) return '';
      const cursor = new DOMPoint(event.clientX, event.clientY).matrixTransform(matrix.inverse());
      if (Math.hypot(cursor.x - center.x, cursor.y - center.y) > radius + 14) return '';

      const scaleX = Math.hypot(matrix.a, matrix.b);
      const scaleY = Math.hypot(matrix.c, matrix.d);
      const screenScale = Math.max(Math.min(scaleX, scaleY), 0.001);
      const hitDistance = 10 / screenScale;
      const ambiguityDistance = 4.5 / screenScale;
      const hits = modelGeometry.map(({ model, points, segments }) => {
        let distance = Infinity;
        let score = -Infinity;
        const consider = (nextDistance, nextScore) => {
          if (nextDistance < distance - 0.01 || (Math.abs(nextDistance - distance) <= 0.01 && nextScore > score)) {
            distance = nextDistance;
            score = nextScore;
          }
        };

        points.forEach((mark) => {
          consider(Math.hypot(cursor.x - mark.x, cursor.y - mark.y), mark.value);
        });
        segments.forEach(({ from, to }) => {
          const nearest = distanceToSegment(cursor, from, to);
          consider(nearest.distance, nearest.score);
        });
        return { slug: model.slug, distance, score };
      }).filter((hit) => hit.distance <= hitDistance);

      if (hits.length === 0) return '';
      const nearestDistance = Math.min(...hits.map((hit) => hit.distance));
      const ambiguousHits = hits.filter((hit) => hit.distance <= nearestDistance + ambiguityDistance);
      const inkling = ambiguousHits.find((hit) => hit.slug === 'inkling');
      if (inkling) return inkling.slug;

      ambiguousHits.sort((a, b) => a.score - b.score || a.distance - b.distance);
      return ambiguousHits[0].slug;
    };

    const setChartHoveredModel = (model) => {
      if (chartHoveredModel === model) return;
      chartHoveredModel = model;
      updateActiveModel();
    };

    svg.addEventListener('pointermove', (event) => {
      setChartHoveredModel(hitTestModel(event));
    });
    svg.addEventListener('pointerleave', () => setChartHoveredModel(''));
    svg.addEventListener('pointercancel', () => setChartHoveredModel(''));

    window.addEventListener('resize', () => {
      const activeModel = getActiveModel();
      positionLegendPill(legendItems.find((item) => item.dataset.radarModel === activeModel));
    });

    radar.classList.add('is-radar-pending');
    const reveal = () => {
      radar.classList.remove('is-radar-pending');
      radar.classList.add('is-radar-visible');
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      reveal();
    } else if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        reveal();
      }, { threshold: 0.18, rootMargin: '0px 0px -10% 0px' });
      observer.observe(radar);
    } else {
      reveal();
    }
    };

    

    if ('IntersectionObserver' in window) {
      const initializeObserver = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        initializeObserver.disconnect();
        initialize();
      }, { threshold: 0.01, rootMargin: '200px 0px' });
      initializeObserver.observe(radar);
    } else {
      initialize();
    }
  })();
</script>


<figcaption>Inkling-Small is a broad, balanced generalist model. Benchmark scores are shown on a shared 0&ndash;100 scale; higher is better.</figcaption>
</figure>
<h3 id="reasoning-and-agentic-tasks">Reasoning and Agentic Tasks</h3>
<p>Inkling-Small matches or exceeds Inkling on reasoning and agentic tasks. On Humanity&rsquo;s Last Exam it scores 31.6%, ahead of Inkling&rsquo;s 29.7%, and the advantage holds at every thinking budget: Inkling-Small&rsquo;s test-time compute curves sit above Inkling&rsquo;s throughout. On SWEBench-Verified it exceeds 80%.</p>
<p>Across many reasoning and agentic benchmarks, Inkling-Small at max reasoning effort has a strong performance-token tradeoff when compared to open weights models in its weight class.</p>
<figure>
<style>
  /* Figure 3 -- token-efficiency tradeoff. Panel geometry is derived from
     data/inkling-small-cost-quadrant.yaml (upstream provenance is recorded in
     that file's header): x is log-scaled output tokens/task, y is each
     benchmark's native score, and the dashed line is the non-dominated Pareto
     frontier. Each panel is its own 460x300 SVG in a CSS grid -- 1 column when
     narrow, 2x2 once there is room -- so the figure needs no scroller.
     Model colours follow the post's convention (Figures 1 and 2):
     Inkling-Small plum, Inkling cobalt. */
  .cq-figure {
    --cq-inklingsmall: #8F3F71;
    --cq-inkling: #0155BF;
    --cq-peer: color-mix(in srgb, var(--fg4) 50%, var(--bg) 50%);
    --cq-frontier: color-mix(in srgb, var(--fg4) 62%, var(--bg) 38%);
    --cq-t: 1.15;
    color: var(--fg);
    container-type: inline-size;
    font-family: var(--font-sans);
    margin: 0 auto;
    max-width: 660px;
    position: relative;
    width: 100%;
  }

  /* Break out past the reading column on wide viewports, matching Figure 1's
     centred-breakout pattern (at a narrower 920px, which is what a 2x2 of
     scatter panels wants). */
  @media (min-width: 1171px) {
    #main.post article.content .cq-figure {
      margin-left: calc((100% - 920px) / 2);
      margin-right: 0;
      max-width: none;
      width: 920px;
    }
  }

  #main.post article.content .cq-figure .cq-legend {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-size: 12px;
    gap: 0.3rem 1rem;
    justify-content: center;
    margin: 0.2rem auto 1rem;
    max-width: 100%;
  }

  .cq-legend-dot {
    background: var(--cq-color);
    border-radius: 50%;
    display: inline-block;
    flex: 0 0 auto;
    height: 9px;
    width: 9px;
  }

  .cq-frontier-key {
    border-top: 2px dashed var(--cq-frontier);
    display: inline-block;
    flex: 0 0 auto;
    height: 0;
    width: 22px;
  }

  /* Panels stack on narrow containers and go 2x2 once there is room, so the
     figure never needs a horizontal scroller. */
  #main.post article.content .cq-grid-panels {
    display: grid;
    gap: 1.1rem 1.5rem;
    grid-template-columns: minmax(0, 1fr);
  }

  #main.post article.content .cq-cell {
    margin: 0;
    max-width: none;
    min-width: 0;
  }

  #main.post article.content .cq-figure .cq-svg {
    display: block;
    height: auto;
    min-width: 0;
    overflow: visible;
    width: 100%;
  }

  /* One shared axis label under the grid in 2-column tiers; per-panel labels
     when the panels are stacked and a single trailing label would be orphaned. */
  #main.post article.content .cq-figure .cq-cell-xlabel,
  #main.post article.content .cq-figure .cq-xlabel {
    color: var(--fg2);
    font-family: var(--font-sans);
    font-size: 12.5px;
    margin: 0.15rem 0 0;
    text-align: center;
  }

  #main.post article.content .cq-figure .cq-xlabel {
    display: none;
    margin-top: 0.55rem;
  }

  @container (min-width: 560px) {
    #main.post article.content .cq-grid-panels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #main.post article.content .cq-figure .cq-cell-xlabel { display: none; }
    #main.post article.content .cq-figure .cq-xlabel { display: block; }

    /* The scale lands on the grid, not on .cq-figure: an element cannot match a
       container query against its own container. Custom properties inherit, so
       the panels below pick it up. */
    #main.post article.content .cq-grid-panels { --cq-t: 1.42; }
  }

  @container (min-width: 800px) {
    #main.post article.content .cq-grid-panels { --cq-t: 1.03; }
  }

  .cq-grid line,
  .cq-axis line {
    stroke: color-mix(in srgb, var(--fg4) 18%, var(--bg) 82%);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  #main.post article.content .cq-figure .cq-tick {
    fill: var(--fg3);
    font-size: calc(var(--cq-t) * 12px);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    text-anchor: middle;
  }

  #main.post article.content .cq-figure .cq-tick--y { text-anchor: end; }

  #main.post article.content .cq-figure .cq-title {
    fill: var(--fg2);
    font-size: calc(var(--cq-t) * 14px);
    font-weight: 400;
    letter-spacing: 0;
  }

  .cq-frontier {
    fill: none;
    stroke: var(--cq-frontier);
    stroke-dasharray: 5 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  #main.post article.content .cq-figure .cq-point {
    cursor: help;
    fill: var(--cq-peer);
    r: calc(var(--cq-t) * 4.2px);
    stroke: var(--bg);
    stroke-width: 1;
    transition: r 140ms ease, stroke-width 140ms ease;
    vector-effect: non-scaling-stroke;
  }

  #main.post article.content .cq-figure .cq-point--inklingsmall,
  #main.post article.content .cq-figure .cq-point--inkling {
    r: calc(var(--cq-t) * 5.4px);
    stroke-width: 1.5;
  }

  #main.post article.content .cq-figure .cq-point--inklingsmall { fill: var(--cq-inklingsmall); }
  #main.post article.content .cq-figure .cq-point--inkling { fill: var(--cq-inkling); }

  #main.post article.content .cq-figure .cq-point:is(:hover, :focus-visible, .is-ii-point-active) {
    r: calc(var(--cq-t) * 6px);
    stroke-width: 2;
  }

  #main.post article.content .cq-figure .cq-label {
    fill: var(--fg2);
    font-size: calc(var(--cq-t) * 11.5px);
    font-weight: 500;
    paint-order: stroke;
    pointer-events: none;
    stroke: var(--bg);
    stroke-linejoin: round;
    stroke-width: 3.5px;
  }

  #main.post article.content .cq-figure .cq-label--inklingsmall { fill: var(--cq-inklingsmall); }
  #main.post article.content .cq-figure .cq-label--inkling { fill: var(--cq-inkling); }

  /* Reveal: frontier and markers fade up as the figure scrolls into view (the
     markers via the shared ii-point animation), then the callout labels. */
  #main.post article.content .cq-figure.is-plot-pending .cq-frontier,
  #main.post article.content .cq-figure.is-plot-pending .cq-labels {
    opacity: 0;
  }

  #main.post article.content .cq-figure.is-plot-visible .cq-frontier {
    animation: cq-fade-in 420ms ease-out both;
  }

  #main.post article.content .cq-figure.is-plot-visible .cq-labels {
    animation: cq-fade-in 380ms ease-out both;
    animation-delay: 560ms;
  }

  @keyframes cq-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #main.post article.content .cq-figure .cq-frontier,
    #main.post article.content .cq-figure .cq-labels {
      animation: none;
      opacity: 1;
    }
  }

</style>
