  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const prevLink = document.getElementById('post-prev-link');
      const nextLink = document.getElementById('post-next-link');

      const prevUrl = prevLink && prevLink.hasAttribute('href') ? prevLink.href : null;
      const nextUrl = nextLink && nextLink.hasAttribute('href') ? nextLink.href : null;

      
      document.addEventListener('keydown', function(e) {
        
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) {
          return;
        }

        
        if (e.keyCode === 37 && !e.ctrlKey && !e.metaKey && prevUrl) {
          e.preventDefault();
          window.location.href = prevUrl;
        }

        
        if (e.keyCode === 39 && !e.ctrlKey && !e.metaKey && nextUrl) {
          e.preventDefault();
          window.location.href = nextUrl;
        }
      });
    });
  </script>
  

  
  

  
