d","sg_col_enabled":"Grant enabled","sg_col_amount":"Amount (US cents)","sg_col_expire":"Expiry (days)","email_tpl_dunning_subject":"Dunning email subject (renewal failed)","email_tpl_autotopup_subject":"Auto-reload failed email subject","email_tpl_zero_subject":"Zero-balance email subject","email_tpl_dunning_body":"Dunning email body","email_tpl_autotopup_body":"Auto-reload failed email body","email_tpl_zero_body":"Zero-balance email body","zc_dismiss":"Dismiss","zc_pill_no_credit":"No spendable credit","zc_payg_title":"Pay as you go","zc_payg_cta":"Add ${{amount}} credit","zc_crypto_link":"Pay with USDT instead","zc_pm_card":"Card","zc_pm_crypto":"USDT crypto","zc_pm_code":"Voucher codes","zc_autorefill_row":"auto-refill {{price}}/mo","zc_team_tag":"FOR TEAMS","zc_team_title":"Team","zc_per_month":"/mo","zc_trial_badge":"{{days}}-day free trial","zc_team_feat_seats":"Shared workspace, seats & roles","zc_team_feat_compliance":"Compliance & audit controls","zc_team_feat_credit":"{{amount}} routing credit included monthly","zc_team_cta":"Upgrade to Team","zc_sub_paused":"Routing is paused for this workspace. Add credit and requests resume instantly.","zc_bonus_note":"+{{pct}}% bonus credit applied automatically","zc_team_row_features":"Seats, compliance & {{amount}} credit included each billing cycle","zc_team_row_features_nocredit":"Seats, roles & compliance controls","zc_mode_once":"One-time","zc_mode_monthly":"Monthly","zc_mode_recurring":"Recurring","zc_sub_cta":"Subscribe · {{price}}/mo","zc_sub_note":"Credit refills automatically each billing cycle · cancel anytime","email_logs_detail_body":"Content","email_logs_body_missing":"Not stored for this send (predates content storage).","plan_interval_month":"mo","plan_interval_year":"yr","plan_interval_week":"wk","plan_interval_day":"d","plan_interval_hour":"h","zc_sub_cta_interval":"Subscribe · {{price}}{{interval}}","sg_expiry_needs_ledger":"The promo-credit ledger is off, so expiring grants cannot be issued — thes