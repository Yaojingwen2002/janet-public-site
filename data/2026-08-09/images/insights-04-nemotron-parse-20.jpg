me":"Connection name","integrations_form_docs":"Docs ↗","integrations_form_cancel":"Cancel","integrations_form_save":"Save","integrations_form_saving":"Saving…","integrations_errors_name_required":"Name is required","guardrails_tab":"Guardrails","guardrail_rule_connection":"Connection","guardrail_rule_pick_connection":"Select an integration…","guardrail_rule_no_connections":"No connections — create one in the Integrations tab","guardrail_rule_new_integration":"+ New","guardrail_rule_new_integration_hint":"Open the Integrations tab to add a vendor account","guardrail_rule_timeout":"Timeout (ms)","guardrail_rule_fail_open":"Fail-open on vendor error","guardrail_rule_uses":"Uses","vendor_pillar_label":"Pillar Security","vendor_pillar_description":"SLM-ensemble guardrail platform for prompt-injection / jailbreak / PII / secrets detection.","vendor_pillar_base_url":"Base URL","vendor_pillar_api_key":"API key","vendor_pillar_path":"Path","vendor_pillar_path_hint":"Override only for vendor-specific integration endpoints (e.g. /api/v1/integrations/litellm).","vendor_aporia_label":"Aporia Guardrails","vendor_aporia_description":"SLM-ensemble policy engine for prompts and responses.","vendor_aporia_base_url":"Base URL","vendor_aporia_api_key":"API key","vendor_bedrock_label":"Amazon Bedrock Guardrails","vendor_bedrock_description":"Managed Bedrock guardrail policies — provision in the AWS console, reference by id.","vendor_bedrock_region":"Region","vendor_bedrock_access_key":"Access key","vendor_bedrock_access_key_hint":"Leave empty when running on EC2 with an instance role.","vendor_bedrock_secret_key":"Secret key","vendor_bedrock_secret_key_hint":"Leave empty when running on EC2 with an instance role.","vendor_bedrock_guardrail_id":"Guardrail ID","vendor_bedrock_guardrail_version":"Version","vendor_averta_label":"Averta","vendor_averta_description":"Generic SLM-classifier endpoint (POST text → safe / unsafe + optional rewrite).","vendor_averta_base_url":"Base URL","vendor_averta_api_key":"API key","vendor_averta_path":"Path","vendor_averta_path_hint":"Endpoint path (defaults to /v1/decide).","vendor_webhook_label":"BYO Webhook","vendor_webhook_description":"Your own URL — receive prompts and return allow / block / mask / flag verdicts.","vendor_webhook_url":"URL","vendor_webhook_auth_header":"Authorization header value","vendor_webhook_auth_header_hint":"Sent verbatim as Authorization (e.g. \"Bearer abc123\").","vendor_webhook_hmac_secret":"HMAC secret","vendor_webhook_hmac_secret_hint":"Server signs request body as X-Guardrail-Signature: sha256=\u003chex>.","prompt_webhooks_btn":"Webhooks","prompt_sources_btn":"Sources","prompt_import_drawer_title":"Import from {{provider}}","prompt_import_search_placeholder":"Search by name…","prompt_import_empty":"This provider has no prompts yet","prompt_import_upstream_title":"Upstream catalog endpoint returned {{code}}","prompt_import_config_title":"This source is not configured for browsing","prompt_import_upstream_404_help":"The upstream provider does not expose a catalog endpoint at {base}/prompts. Generic HTTP browsing requires the source server to implement the gateway's list contract. If your platform doesn't support browse, use \\\"Import by name\\\" below to add prompts manually.","prompt_import_upstream_help":"The upstream provider rejected the catalog request. Check the source URL and try again, or use \\\"Import by name\\\" below.","prompt_import_config_help":"Fix the source configuration in Integrations → Prompt Sources, or use \\\"Import by name\\\" below to add a prompt without browsing.","prompt_import_by_name_btn":"Import by name","prompt_import_by_name_title":"Import by name","prompt_import_external_name_label":"External prompt name","prompt_import_external_name_placeholder":"Name as known to the upstream source","prompt_import_btn":"Import","prompt_import_browse_btn":"Browse {{provider}}…","prompt_import_from_provider_btn":"Import from provider…","prompt_import_select_provider_first":"Connect a prompt provider first","prompt_import_local_name_label":"Local name","prompt_import_local_name_help":"Will be saved as a native prompt in this workspace","prompt_import_duplicate_title":"Name already exists","prompt_import_duplicate_help":"Pick a different local name and try again","prompt_import_auth_failed":"Provider credentials rejected — update the provider connection","prompt_import_timeout":"Provider slow to respond, please try again","prompt_import_pick_provider":"Pick a prompt provider","prompt_import_col_version":"Version","prompt_import_load_failed":"Failed to load prompts","prompt_import_failed":"Import failed","prompt_import_success":"Imported \"{{name}}\"","prompt_import_provider_fallback":"provider","prompt_webhooks_drawer_title":"Prompt webhooks","prompt_sources_drawer_title":"Prompt sources","prompt_col_usage_7d":"Usage (7d)","prompt_trending_aria":"Top-bound — most keys attached","prompt_empty_cta":"Create your first prompt","prompt_usage_count_aria":"{{n}} bindings","prompt_col_bindings":"Bindings","prompt_help_ref_summary":"How Prompts relates to the rest of the gateway","prompt_help_step_create_title":"Create a prompt","prompt_help_step_create_body":"Click + New prompt. Pick Text (single system message) or Chat (multi-message template). v1 is automatically labeled production + latest.","prompt_help_step_bind_title":"Bind it to an API key","prompt_help_step_bind_body":"In API Keys → Edit key → \"Prompt\", pick the prompt + label (e.g. production). The binding lives on the key, so promoting a new version shifts every bound key at once — no redeploy.","prompt_help_step_call_title":"Call the gateway","prompt_help_step_call_body":"POST to /v1/chat/completions with the bound key. The gateway injects the label's template as the system message. Iterate by editing the prompt and promoting — clients don't need to redeploy.","prompt_history_col_author_id":"By user #{{id}}","prompt_history_col_author_unknown":"By —","integrations_col_actions":"Actions","integrations_used_by_one":"1 rule","integrations_used_by_many":"{count} rules","integrations_col_status":"Status","integrations_delete_confirm_btn":"Delete","integrations_delete_helper_safe":"This integration isn't used by any guardrail rules. The credential will be permanently removed from this workspace.","integrations_delete_msg_safe":"Delete \"{name}\"?","integrations_delete_running":"Deleting…","integrations_delete_title":"Delete integration","integrations_empty_search_body":"Try a different name or clear the vendor filter.","integrations_empty_search_title":"No matches","integrations_filter_all_vendors":"All vendors","integrations_filter_vendor_aria":"Filter by vendor","integrations_form_close":"Close","integrations_last_tested_fail":"Last test failed","integrations_last_tested_ok":"Last test passed","integrations_never_tested":"Never tested","integrations_search_aria":"Search integrations","integrations_search_placeholder":"Search by name or vendor","integrations_test_btn":"Test","integrations_test_btn_tip":"Probe the credential with a benign payload","integrations_test_failed":"Probe failed: {err}","integrations_test_running":"Testing…","integrations_test_success":"Connection OK","integrations_toolbar_count":"{shown} of {total}","integrations_used_by_none":"Not used","integrations_usedby_rule_n":"rule #{n}","integrations_usedby_title":"Used by these guardrails","integrations_status_ok":"OK","integrations_status_failed":"Failed","integrations_clear_filter":"Clear filter","integrations_delete_title_blocked":"Cannot delete — in use","integrations_delete_blocked_in_use":"\"{name}\" is used by {count} guardrail rule(s). Detach or change the rule(s) below, then come back to delete the integration.","integrations_empty_why":"A vendor account is one URL + one API key, shared by every rule that uses it.","integrations_form_test":"Test","integrations_form_test_running":"Testing…","integrations_form_test_ok":"Connection OK","integrations_form_test_failed":"Probe failed: {err}","vendor_webhook_url_hint":"POST receives {stage, text, metadata}; reply 200 with {action: allow | block | mask | flag, masked_text?, reasons[]?}.","guardrail_empty_why":"A guardrail is a set of content-policy rules (keyword, regex, PII, external vendor check) that run on every request to keys it’s attached to. Block, mask, or flag — no app code changes.","guardrail_attach_hint":"→ attach in Settings → Keys","guardrail_stage_hint":"Input runs before the model; output runs after the response; both runs in both directions.","guardrail_action_hint":"Block rejects the request; mask replaces matches with a tag; flag logs but lets the request through; annotate adds a security note; spotlight wraps untrusted text in delimiters and tells the model to treat it as data.","guardrail_type_hint_keyword":"Matches any substring from a denylist (case-insensitive).","guardrail_type_hint_regex":"Matches a regular-expression pattern against the full text.","guardrail_type_hint_pii":"Detects emails, phone numbers, SSNs, credit cards and IPs (PII).","guardrail_type_hint_max_chars":"Caps prompt size to a maximum character count.","guardrail_type_hint_external":"Routes the text to a configured external vendor connection (Pillar, Aporia, Bedrock, webhook).","guardrail_rule_fail_open_hint":"On: when the vendor times out or errors, the request is let through (default). Off: vendor error blocks the request.","integrations_picker_title":"Choose a vendor","integrations_form_back":"Back","integrations_empty_pointer":"Use + New integration above to connect your first vendor.","integrations_empty_no_vendors":"No integration vendors are available right now. Reload the page or contact support if this persists.","integrations_name_placeholder_webhook":"My scanner","guardrail_preset_child_safety_keywords_name":"Child Safety Keywords","guardrail_preset_child_safety_keywords_desc":"Conservative child-safety denylist placeholder — replace with the explicit terms from your policy/standards. Block action; keep this list short and well-reviewed.","guardrail_preset_code_secret_in_output_name":"Code Secret in Output","guardrail_preset_code_secret_in_output_desc":"Block model responses that leak private keys, AWS access keys or OpenAI-style secret tokens. Output-only — prevents accidental disclosure back to the client.","guardrail_preset_competitor_mentions_name":"Competitor Mentions","guardrail_preset_competitor_mentions_desc":"Block (or flag) any mention of your competitors. Seeded with a single placeholder — edit this list to add your competitor names. Switch action to 'flag' to monitor without blocking.","guardrail_preset_crypto_wallet_block_name":"Crypto Wallet Block","guardrail_preset_crypto_wallet_block_desc":"Block BTC (legacy + bech32), ETH and similar wallet addresses on the request. Use when wallet addresses should never reach the provider for compliance reasons.","guardrail_preset_eu_pii_block_name":"EU PII Block (GDPR)","guardrail_preset_eu_pii_block_desc":"Block EU identifiers (IBAN, NHS numbers, German Steuer-ID, French NIR) on the request. Use in EU/UK-resident workspaces to keep regulated data off the upstream provider.","guardrail_preset_jailbreak_v2_regex_name":"Jailbreak v2 Regex","guardrail_preset_jailbreak_v2_regex_desc":"Extends jailbreak coverage with newer role-play modes (DAN/STAN/AIM) and Unicode tag-byte hidden-text injection (U+E0000–U+E007F). Use alongside Jailbreak / Role-Play Blocker.","guardrail_preset_legal_disclaimer_enforce_name":"Legal Disclaimer Enforce","guardrail_preset_legal_disclaimer_enforce_desc":"Flag output that gives definitive legal/financial advice (\"you are entitled to damages\", \"you should sue\", \"guaranteed return\"). Negation isn't easily expressed in RE2, so this is a positive-match flag on advice phrases — pair with team review of flagged calls.","guardrail_preset_markdown_image_block_name":"Markdown Image Block","guardrail_preset_markdown_image_block_desc":"Block markdown image embeds (\"![alt](url)\") in model responses. Defends against image-rendering exfiltration on clients that auto-load remote images.","guardrail_preset_medical_phi_block_name":"Medical PHI Block (HIPAA)","guardrail_preset_medical_phi_block_desc":"Block US healthcare identifiers (NPI numbers, ICD-10 codes, NDC drug codes, DEA registration numbers) before they reach the provider. Context-anchored regex bounds false positives.","guardrail_preset_pci_full_block_name":"PCI Full Block","guardrail_preset_pci_full_block_desc":"Stronger PCI-DSS pre-flight: blocks card PANs (Luhn-checked), IBANs and SWIFT/BIC codes. Use for cards-plus-bank-routing flows where any payment instrument is sensitive.","guardrail_preset_profanity_multilingual_name":"Profanity Multilingual","guardrail_preset_profanity_multilingual_desc":"Seed multi-language denylist (zh, es, fr, de, ja, ar) — placeholder terms; edit the list with the actual words your policy bans for each market.","guardrail_preset_prompt_size_token_cap_name":"Token Cost Cap (prompt)","guardrail_preset_prompt_size_token_cap_desc":"Hard cap on prompt length for cost protection. Implemented as a 200,000-character ceiling (~50K tokens at the standard char→token ratio); tighten via the rule's max_chars field for stricter budgets.","guardrail_preset_response_size_cap_name":"Response Size Cap","guardrail_preset_response_size_cap_desc":"Trim model responses longer than 32,000 characters to control egress + client latency. Output-stage — clamps (does not reject) so the user still gets a usable answer.","guardrail_preset_self_harm_keywords_name":"Self-Harm Keywords","guardrail_preset_self_harm_keywords_desc":"Block prompts asking how to self-harm or commit suicide. Pair with your support/escalation workflow — a blocked request should surface to a human reviewer with helpline info.","guardrail_preset_sql_injection_in_output_name":"SQL Injection in Output","guardrail_preset_sql_injection_in_output_desc":"Block model responses that contain classic SQL-injection payloads (UNION SELECT, OR 1=1, DROP TABLE). Defense-in-depth for tools that auto-execute SQL the model produced.","guardrail_preset_system_prompt_leak_strong_name":"Strong System Prompt Leak","guardrail_preset_system_prompt_leak_strong_desc":"Block (not just flag) model responses that contain chat-template control tokens — clear evidence the system prompt is being echoed back. Output-only.","guardrail_preset_tool_call_shell_block_name":"Tool Call Shell Block","guardrail_preset_tool_call_shell_block_desc":"Block obvious shell-injection patterns in user input (rm -rf /, curl | sh, sudo escalation). Use for agent flows that may forward inputs to a shell tool.","guardrail_preset_url_filter_block_name":"URL Filter","guardrail_preset_url_filter_block_desc":"Block any http(s) URL on the request. Use for agent flows where outbound URLs should be allowlisted; edit the regex to permit specific domains.","guardrail_rule_type_keyword":"Keyword denylist","guardrail_rule_type_regex":"Regular expression","guardrail_rule_type_pii":"PII detection","guardrail_rule_type_max_chars":"Maximum length","guardrail_rule_type_external":"External vendor","guardrail_rule_type_llm_judge":"LLM judge","guardrail_rule_type_group_builtin":"Built-in","guardrail_rule_type_group_advanced":"Advanced","guardrail_stage_input":"Input (request)","guardrail_stage_output":"Output (response)","guardrail_stage_both":"Both directions","guardrail_action_block":"Block — reject request","guardrail_action_mask":"Mask — redact match","guardrail_action_flag":"Flag — log only","guardrail_delete_confirm_title":"Delete guardrail '{{name}}'?","guardrail_delete_confirm_body_default":"This is your account default — keys with no explicit guardrail will become unfiltered.","guardrail_delete_confirm_body_attached":"{{count}} key(s) currently use this guardrail; they will fall back to the account default.","guardrail_delete_confirm_btn":"Delete","guardrail_delete_cancel_btn":"Cancel","workspace_ts_title":"Trust & Safety","workspace_ts_status_lifecycle":"Lifecycle","workspace_ts_status_fraud":"Fraud flag","workspace_ts_status_active":"Active","workspace_ts_status_archived":"Archived","workspace_ts_status_suspended":"Suspended","workspace_ts_fraud_flagged":"Flagged","workspace_ts_fraud_clear":"Clear","workspace_ts_suspend_btn":"Suspend","workspace_ts_unsuspend_btn":"Unsuspend","workspace_ts_flag_btn":"Flag fraud","workspace_ts_clear_flag_btn":"Clear flag","workspace_ts_suspended_reason_prefix":"Suspended:","workspace_ts_suspend_modal_title":"Suspend workspace","workspace_ts_suspend_modal_warning_blocks_relay":"This blocks every relay request from this workspace.","workspace_ts_suspend_reason_label":"Reason","workspace_ts_suspend_reason_placeholder":"e.g. fraud: chargebacks","workspace_ts_suspend_reason_required":"Reason is required.","workspace_ts_suspend_confirm_label":"Type SUSPEND to confirm","workspace_ts_suspend_confirm_word":"SUSPEND","workspace_ts_flag_modal_title":"Flag fraud","workspace_ts_flag_reason_label":"Reason","workspace_ts_flag_reason_placeholder":"e.g. credit card mismatch","workspace_ts_history_title":"Trust & Safety history","workspace_ts_history_empty":"No history yet","workspace_ts_history_load_failed":"Failed to load history","workspace_ts_action_success":"Action completed","workspace_ts_action_failed":"Action failed","workspace_status_active":"Active","workspace_status_archived":"Archived","workspace_status_suspended":"Suspended","workspace_billing_title":"Billing","workspace_billing_wallet_balance":"Wallet balance","workspace_billing_30d_topups":"30d top-ups","workspace_billing_30d_refunds":"30d refunds","workspace_billing_refund_btn":"Refund top-up...","workspace_billing_credit_btn":"+ Manual credit","workspace_billing_ledger_title":"Wallet ledger","workspace_billing_ledger_empty":"No ledger entries yet","workspace_billing_ledger_date":"Date","workspace_billing_ledger_type":"Type","workspace_billing_ledger_amount":"Amount","workspace_billing_ledger_balance":"Balance","workspace_billing_ledger_note":"Note","workspace_billing_action_success":"Done","workspace_refund_modal_title":"Refund top-up","workspace_refund_modal_select_topup":"Select top-up","workspace_refund_modal_amount":"Amount (quota)","workspace_refund_modal_reason":"Reason","workspace_refund_modal_force_checkbox":"Force refund (allow negative balance)","workspace_refund_modal_force_warning":"Insufficient balance. Tick the box to force the refund and let the wallet go negative.","workspace_refund_modal_submit":"Refund","workspace_refund_already":"refunded","workspace_credit_modal_title":"Manual credit","workspace_debit_btn":"− Deduct credits","workspace_debit_modal_title":"Deduct credits","workspace_debit_modal_category":"Category","workspace_debit_category_refund":"Refund (money returned to customer)","workspace_debit_category_correction":"Correction (fix an erroneous credit)","workspace_debit_category_other":"Other","workspace_debit_modal_preview":"Balance after deduction","workspace_debit_modal_hint":"Recorded in the wallet ledger and the admin audit log.","workspace_debit_modal_force_warning":"Insufficient balance. Tick the box to force the deduction and let the wallet go negative.","workspace_debit_modal_force_checkbox":"Force deduction (allow negative balance)","workspace_debit_confirm":"Deduct {{amount}}","workspace_debit_success":"Deduction applied","workspace_credit_modal_amount":"Amount (USD)","workspace_credit_modal_reason":"Reason","workspace_credit_modal_submit":"Credit","workspace_credit_modal_hint":"Positive amounts only.","workspace_refund_err_duplicate":"Refund already issued for this top-up.","workspace_refund_err_exceeds":"Refund amount exceeds original top-up amount.","workspace_refund_err_insufficient":"Refund would result in a negative balance. Tick force to override.","workspace_refund_err_topup_not_found":"Top-up not found.","workspace_drawer_tab_overview":"Overview","workspace_drawer_tab_billing":"Billing","workspace_drawer_tab_crm":"CRM","workspace_drawer_tab_members":"Members","workspace_drawer_tab_activity":"Activity","workspace_drawer_tab_trust_safety":"Trust & Safety","workspace_crm_section_title":"CRM","workspace_crm_sales_owner":"Sales owner","workspace_crm_source":"Source","workspace_crm_first_contact":"First contact","workspace_crm_lead_to_paid":"Lead to paid (days)","workspace_crm_touchpoints_title":"Recent touchpoints","workspace_crm_empty":"No CRM data yet","workspace_members_section_title":"Members","workspace_members_active":"Active members","workspace_members_pending":"Pending invites","workspace_members_empty":"No other members or pending invites","workspace_members_invite_expires_in":"Expires in","workspace_members_email":"Email","workspace_members_role":"Role","workspace_members_accepted":"Joined","workspace_members_invited":"Invited","workspace_members_last_login":"Last activity","workspace_activity_section_title":"Activity","workspace_activity_volume_title":"30 day request volume","workspace_activity_total":"Total requests","workspace_activity_top_models":"Top models","workspace_activity_top_channels":"Top upstreams","workspace_activity_status_codes":"Status code distribution","workspace_activity_member_logins":"Member last activity","workspace_activity_empty":"No activity in the last 30 days","workspace_activity_name":"Name","workspace_activity_count":"Count","finance_col_currency":"Currency","finance_col_original_amount":"Original amount","finance_col_fx_rate_avg":"FX rate (avg)","finance_col_usd_at_capture":"USD at capture","finance_col_settled_amount_usd":"Settled USD","finance_col_fx_pnl_usd":"FX P&L","customers_sidebar":"Customers","dashboards_sidebar":"Dashboard","sales_sidebar":"Sales","logs_tab_audit":"Audit log","logs_tab_n8n":"n8n logs","customers_tab_workspaces":"Workspaces","customers_tab_users":"Users","customers_tab_setting":"Setting","dashboards_tab_platform":"Platform","dashboards_tab_executive":"Executive","channels_tab_routing_adoption":"Routing adoption","channels_tab_margin":"Margin","sales_tab_leads":"Leads","sales_tab_leaderboard":"Leaderboard","acquisition_tab_overview":"Overview","acquisition_tab_funnel":"Funnel","acquisition_tab_roi":"Acquisition ROI","tab_coming_soon":"Coming soon","guardrail_match_tab_label":"Matches","guardrail_match_stats_total":"Total","guardrail_match_stats_block_pct":"Block %","guardrail_match_stats_mask_pct":"Mask %","guardrail_match_stats_flag_pct":"Flag %","guardrail_match_stats_fp_rate":"FP rate","guardrail_match_stats_live":"✓ Live","guardrail_match_stats_paused":"⏸ Paused (server)","guardrail_match_chart_title":"Matches over time","guardrail_match_chart_hide":"Hide chart","guardrail_match_chart_show":"Show chart","guardrail_match_chart_tap_hint":"Tap a bar to filter day","guardrail_match_chart_empty":"—","guardrail_match_view_list":"List","guardrail_match_view_grouped":"Grouped","guardrail_match_density_compact":"Compact","guardrail_match_density_cozy":"Cozy","guardrail_match_quick_view_all":"All","guardrail_match_quick_view_blocks_only":"Blocks only","guardrail_match_quick_view_last_hour":"Last hour","guardrail_match_quick_view_fp_marked":"FP-marked","guardrail_match_quick_view_output_stage":"Output stage","guardrail_match_stats_range_label":"Last {{days}} days","guardrail_match_stats_range_label_24h":"Last 24 hours","guardrail_match_stats_range_label_custom":"Custom range","guardrail_match_stats_last_updated":"Last updated","guardrail_match_filter_range_custom":"custom","guardrail_help_button_aria":"How Guardrails work","guardrail_help_title":"How Guardrails work","guardrail_help_section_guardrails_title":"Guardrails","guardrail_help_section_guardrails_body":"Author content policies (keyword, regex, PII, max-length, external vendor, or LLM judge). Toggle Enabled, mark a default, or attach a policy to specific API keys. Rules run on every request — block, mask, or flag.","guardrail_help_section_matches_title":"Matches","guardrail_help_section_matches_body":"A feed of every rule that fired — the prompt or response excerpt, the rule that matched, the action taken. Use it to tune false positives, spot abuse patterns, or audit policy enforcement.","guardrail_help_section_eval_title":"Eval","guardrail_help_section_eval_body":"Validate a policy before it ships. Run a guardrail against a labelled corpus and measure precision, recall, and false-positive rate. Catch over-blocking or coverage gaps before turning a rule on for production traffic.","guardrail_help_learn_more":"Learn more →","guardrail_match_quick_view_save":"Save current view","guardrail_match_filter_action":"Action","guardrail_match_filter_rule_type":"Rule type","guardrail_match_filter_stage":"Stage","guardrail_match_filter_stage_all":"all stages","guardrail_match_filter_range":"Range","guardrail_match_filter_guardrail":"Guardrail","guardrail_match_filter_model":"Model","guardrail_match_filter_token":"Token","guardrail_match_filter_search":"Search","guardrail_match_filter_more":"More filters","guardrail_match_filter_hide_fp":"Hide false positives","guardrail_match_filter_clear_all":"Clear all","guardrail_match_filter_active_label":"Active","guardrail_match_col_time":"Time","guardrail_match_col_guardrail":"Guardrail","guardrail_match_col_rule":"Rule","guardrail_match_col_stage":"Stage","guardrail_match_col_action":"Action","guardrail_match_col_model":"Model","guardrail_match_col_token":"Token","guardrail_match_col_detail":"Detail","guardrail_match_col_request_id":"Request ID","guardrail_match_col_ip":"IP","guardrail_match_col_fp":"FP","guardrail_match_action_block":"Block","guardrail_match_action_mask":"Mask","guardrail_match_action_flag":"Flag","guardrail_match_stage_input":"Input","guardrail_match_stage_output":"Output","guardrail_match_mark_fp":"Mark as false positive","guardrail_match_unmark_fp":"Unmark false positive","guardrail_match_edit_rule":"Edit rule","guardrail_match_view_request":"View full request","guardrail_match_view_related":"View related matches","guardrail_match_drawer_title":"Guardrail match","guardrail_match_drawer_raw_section_title":"Raw matched content","guardrail_match_drawer_raw_not_captured":"Not captured for this guardrail. To log the actual matched substrings on future matches, enable 'Log raw matched content' on the guardrail.","guardrail_match_drawer_raw_enable_cta":"Enable on this guardrail","guardrail_match_drawer_raw_captured_note":"Captured because 'Log raw matched content' is ON for this guardrail. Retained for 30 days.","guardrail_match_drawer_open":"Open drawer","guardrail_match_export_title":"Export matches","guardrail_match_export_with_filters":"Exporting with current filters","guardrail_match_export_format":"Format","guardrail_match_export_estimated_rows":"Estimated rows","guardrail_match_export_columns":"Columns","guardrail_match_export_cap":"hard cap","guardrail_match_export_no_raw_note":"Note: the 'matched' column is present only for guardrails with 'Log raw matched content' enabled.","guardrail_match_export_download":"Download","guardrail_match_export_starting":"Preparing export…","guardrail_match_export_started":"Download started","guardrail_match_export_failed":"Export failed","guardrail_match_grouped_count":"{count} matches","guardrail_match_grouped_view_full_request":"View full request","guardrail_match_grouped_view_blocked_request":"View blocked request","guardrail_match_grouped_view_more":"+ {count} more","guardrail_match_save_view_title":"Save current view","guardrail_match_save_view_name":"Name","guardrail_match_save_view_pin":"Pin to top of Quick views","guardrail_match_save_view_filters_captured":"Filters captured","guardrail_match_save_view_saved":"View saved","guardrail_match_cols_visible":"Visible columns","guardrail_match_cols_locked":"locked","guardrail_match_cols_reset_defaults":"Reset to defaults","guardrail_match_kbd_title":"Keyboard shortcuts","guardrail_match_kbd_next_row":"next / previous row","guardrail_match_kbd_open":"open drawer","guardrail_match_kbd_mark_fp":"toggle false-positive","guardrail_match_kbd_select":"select row","guardrail_match_kbd_select_range":"select range","guardrail_match_kbd_refresh":"refresh","guardrail_match_kbd_export":"export","guardrail_match_kbd_search":"focus search","guardrail_match_kbd_list":"switch to list view","guardrail_match_kbd_grouped":"switch to grouped view","guardrail_match_kbd_help":"show this overlay","guardrail_match_empty_never_used_title":"No matches yet","guardrail_match_empty_never_used_body":"When one of your guardrails matches a request, it shows up here. Try sending a test request from your application.","guardrail_match_empty_never_used_test_cta":"Test a rule in the sandbox","guardrail_match_empty_never_used_tip":"Tip: rules with action=flag don't block traffic — a great way to observe before promoting to block.","guardrail_match_empty_filtered_title":"No matches found","guardrail_match_empty_filtered_body":"Your current filters returned nothing.","guardrail_match_empty_filtered_clear":"Clear filters","guardrail_match_empty_filtered_widen":"Widen range to 7 days","guardrail_match_empty_mongo_disabled_title":"Matches feature requires MongoDB","guardrail_match_empty_mongo_disabled_body":"Ask an operator to set GUARDRAIL_MATCH_MONGO_DSN. The Guardrails and Integrations tabs are unaffected.","guardrail_match_empty_error_title":"Could not load matches","guardrail_match_empty_error_body":"Something went wrong loading matches.","guardrail_match_empty_error_retry":"Retry","guardrail_match_empty_error_report":"Report this","guardrail_match_daily_cap_warning":"{count} matches dropped today — workspace daily cap reached.","guardrail_match_toast_fp_marked":"Marked as false positive","guardrail_match_toast_fp_marked_suppressed":"Marked as false positive and suppressed for this workspace.","guardrail_match_toast_fp_marked_unsuppressable":"Marked as false positive. This match has no stable identity to suppress, so it may recur.","guardrail_match_toast_fp_unmarked":"FP cleared","guardrail_match_toast_fp_bulk":