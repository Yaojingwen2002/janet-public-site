ndor_osv_severity_threshold":"Minimum severity","vendor_osv_severity_threshold_hint":"Only surface vulnerabilities at or above this severity.","vendor_snyk_label":"Snyk","vendor_snyk_description":"Checks pinned dependencies against Snyk's vulnerability database.","vendor_snyk_api_token":"API token","vendor_snyk_org_id":"Organization ID","vendor_snyk_org_id_hint":"Your Snyk organization UUID (Settings → General).","vendor_snyk_base_url":"Base URL","vendor_snyk_action":"On finding","vendor_snyk_severity_threshold":"Minimum severity","vendor_semgrep_label":"Semgrep","vendor_semgrep_description":"Runs static analysis against a Semgrep-compatible scan endpoint and surfaces SAST findings.","vendor_semgrep_base_url":"Scanner URL","vendor_semgrep_base_url_hint":"POST {code, stage}; reply with Semgrep JSON: {results:[{check_id, extra:{message, severity}}]}.","vendor_semgrep_api_token":"API token","vendor_semgrep_api_token_hint":"Optional bearer token sent to your scanner.","vendor_semgrep_path":"Path","vendor_semgrep_action":"On finding","vendor_semgrep_severity_threshold":"Minimum severity","guardrail_suppressions_tab":"Suppressions","guardrail_suppressions_title":"Suppressed findings","guardrail_suppressions_refresh":"Refresh","guardrail_suppressions_subtitle":"Findings marked as false positives are remembered for this workspace and skipped on future requests.","guardrail_suppressions_empty":"No suppressed findings yet.","guardrail_suppression_col_finding":"Finding","guardrail_suppression_col_reason":"Reason","guardrail_suppression_restore":"Restore","guardrail_suppression_restore_confirm":"Restore this finding? It will be reported again on future requests.","guardrail_suppress_action":"Suppress (false positive)","guardrail_suppress_reason_ph":"Why is this a false positive? (optional)","guardrail_suppress_confirm":"Suppress finding","guardrail_suppress_success":"Finding suppressed for this workspace.","guardrail_suppress_removed":"Suppression removed.","guardrail_suppress_