uest itself is invalid. Check and fix your request.","error_analysis_col_status":"Status","error_analysis_col_reason":"Reason","error_analysis_col_count":"Count","error_analysis_reasons_more":"+{{count}} more in rarer reasons","error_analysis_view_logs":"View error logs","error_analysis_unavailable":"Error analytics are temporarily unavailable.","error_analysis_no_errors":"No failed requests for this model in the selected window.","pg_auto":"Auto","pg_standard":"Standard","pg_login_select_key_to_generate":"Please sign in and select an API Key before generating","pg_select_model":"Select model","nav_zero_trust":"Zero Trust","nav_api_docs":"API Docs","pg_search_models":"Search models","pg_no_models":"No models","pg_loading":"Loading…","pg_context":"Context","pg_input":"Input","pg_output":"Output","pg_modalities":"Modalities","pg_no_adjustable_params":"This model exposes no adjustable parameters","pg_parameters":"Parameters","pg_per_image":"Per image","pg_per_request":"Per request","pg_page_title":"Playground","pg_code_block":"Code block","pg_model_description":"Model description","pg_seo_title":"OrcaRouter Playground — Test 200+ AI models in your browser","pg_seo_description":"Try GPT-5, Claude Opus, Gemini Pro and 200+ models directly in the OrcaRouter playground. No credit card; compare models side by side in your browser.","pg_select_key_to_send":"Select an API key before sending — create one in the console","pg_signin_to_send":"Sign in to send","pg_cta_signup_title":"Create your free account","pg_cta_note_no_card":"No credit card required","pg_gate_title":"Your prompt is ready to send","pg_gate_title_exhausted":"Free messages used up for today","pg_gate_pitch":"Sign in to run it — takes about 10 seconds. No card required.","pg_gate_signin":"Sign in","pg_gate_register":"Create account","pg_gate_not_now":"Not now","pg_gate_kept":"Your prompt is kept — it sends right after sign-in","pg_gate_kept_restore":"Your prompt is kept — it will be waiting after sign-in","pg_guest_left":"Guest mode — {{count}} free messages left","pg_hero_title":"Test 200+ AI models in your browser","pg_hero_sub":"One prompt — the router picks the best model, or choose any model yourself. No credit card required.","pg_turnstile_wait":"Verifying you are human — please retry in a moment","pg_router_auto":"Auto — router picks","pg_model_details":"Model details","pg_sources":"Sources","pg_sources_more":"Show all ({{count}})","pg_sources_collapse":"Show less","pg_img_param_hint":"Tip: if this keeps failing, set Size / Quality to Auto and retry.","pg_no_images_returned":"No usable image was returned. Try again or switch model.","pg_stopped":"Stopped","pg_sugg_translate":"Translate this paragraph into natural, fluent English","pg_sugg_debug":"Find and fix the bug in this code snippet","pg_img_sugg_portrait":"Studio portrait of a young woman, soft light","pg_img_sugg_product":"Product shot of a sleek smartphone on marble","pg_vid_sugg_food":"Close-up of a sizzling steak, slow motion","pg_vid_sugg_forest":"Drone shot over an autumn forest at golden hour","pg_sugg_explain_short":"Quantum computing","pg_sugg_code_short":"SQL query","pg_sugg_compare_short":"REST vs GraphQL","pg_sugg_email_short":"Follow-up email","pg_sugg_translate_short":"Refine translation","pg_sugg_debug_short":"Debug code","pg_img_sugg_garden_short":"Japanese garden","pg_img_sugg_logo_short":"Minimalist logo","pg_img_sugg_city_short":"Cyberpunk street","pg_img_sugg_fox_short":"Watercolor fox","pg_img_sugg_portrait_short":"Studio portrait","pg_img_sugg_product_short":"Product shot","pg_vid_sugg_coast_short":"Coastline aerial","pg_vid_sugg_cat_short":"Cat on piano","pg_vid_sugg_city_short":"City time-lapse","pg_vid_sugg_astro_short":"Astronaut nebula","pg_vid_sugg_food_short":"Steak close-up","pg_vid_sugg_forest_short":"Forest aerial","pg_api_request":"API Request","pg_config":"Settings","pg_image_gen":"Image generation","pg_image_gen_desc":"Enter a prompt below to generate images","pg_generating_ellipsis":"Generating...","pg_download":"Download","pg_image_prompt_placeholder":"Describe the image you want to generate...","pg_size":"Size","pg_background":"Background","pg_output_format":"Output format","pg_output_compression":"Compression","pg_style":"Style","pg_count":"Count","pg_quality":"Quality","pg_response_format":"Response format","pg_image":"Image","pg_example_prompt":"(example prompt)","pg_clear":"Clear","pg_upload":"Upload","pg_input_question_placeholder":"Type your question...","pg_stop":"Stop","pg_send":"Send","pg_cannot_reveal_token":"Unable to reveal this token (requires Developer or higher)","pg_use_existing_token":"Use an existing token","pg_no_tokens":"No tokens available.","pg_go_create":"Create one","pg_or":"or","pg_paste_key_manually":"Paste Key manually","pg_api_key":"API Key","pg_chat":"Chat","pg_video":"Video","pg_interactive_experience":"Interactive experience","pg_try_models_in_browser":"Try models directly in your browser","pg_smart_routing_demo":"Smart routing demo","pg_playground":"Playground","pg_login_select_key_to_send":"Please sign in and select an API Key before sending","pg_select_model_each_column":"Select a model for each comparison column","pg_copied":"Copied","pg_copy_failed":"Copy failed","pg_example_message":"(example message)","pg_copy":"Copy","pg_model":"Model","pg_compare_mode":"Compare mode","pg_add_model":"Add model","pg_compare":"Compare","pg_remove":"Remove","pg_compare_n_models":"Compare {{count}} models","pg_start_chat":"Start a conversation","pg_compare_intro":"Enter a question to send to multiple models at once and compare","pg_chat_intro":"Select a model and type a question below to start; click \"Compare\" in the top-right to try multiple models at once","pg_web_search":"Web search","pg_enable":"Enable","pg_api_request_example":"API request example","pg_video_gen":"Video generation","pg_video_gen_desc":"Fill in a prompt below to generate a video (this may take several minutes)","pg_video_models_only":"Currently only Kling and Seedance video models are supported","pg_video_prompt_placeholder":"Describe the video you want to generate...","pg_submitting_task":"Submitting task...","pg_no_task_id":"No task ID returned","pg_generation_timeout":"Generation timed out; check the task list later","pg_generating":"Generating","pg_generation_failed":"Generation failed","pg_duration":"Duration","pg_first_frame_image":"First-frame image (image-to-video)","pg_last_frame_image":"Last-frame image (first & last frame)","pg_mode":"Mode","pg_aspect_ratio":"Aspect ratio","pg_negative_prompt":"Negative prompt (optional, ≤2500 chars)","pg_negative_prompt_placeholder":"Content you don't want to appear","pg_native_audio_sound":"Native audio (sound)","pg_resolution":"Resolution","pg_random_seed":"Random seed (optional)","pg_leave_blank_random":"Leave blank for random","pg_reference_content":"Reference content (image/video/audio + role)","pg_add":"Add","pg_video_ref_hint":"First frame = first_frame; add another end_frame for first & last; use reference_* for references","pg_generate_audio":"Generate audio","pg_watermark":"Watermark","pg_mode_std":"Standard std (720P)","pg_mode_pro":"Expert pro (1080P)","pg_mode_4k":"4K (v3 only)","pg_audio":"Audio","pg_url_or_upload":"https://... or upload","pg_sugg_explain":"Explain quantum computing in simple terms","pg_sugg_code":"Write a SQL query to find the top 5 customers by revenue","pg_sugg_compare":"Compare REST and GraphQL — when to use each?","pg_sugg_email":"Draft a polite follow-up email to a client","pg_img_sugg_garden":"A serene Japanese garden at sunset","pg_img_sugg_logo":"Minimalist logo for a coffee brand","pg_img_sugg_city":"Cyberpunk city street with neon rain","pg_img_sugg_fox":"Watercolor portrait of a red fox","pg_vid_sugg_coast":"Aerial drone shot over a tropical coastline","pg_vid_sugg_cat":"A cat playing piano, cinematic lighting","pg_vid_sugg_city":"Time-lapse of city traffic at night","pg_vid_sugg_astro":"An astronaut drifting through a glowing nebula","pg_api_key_placeholder_note":"Replace xxx with your API key. Ready to paste into a terminal, Apifox or Postman.","models_card_router":"Multi-model router","models_card_router_billing":"· usage-based","fusion_unknown":"Unknown fusion variant.","fusion_back_to_models":"Back to all models","fusion_seo_title":"{{title}} — Fable 5-level intelligence at a fraction of the cost","fusion_seo_desc":"A panel of frontier models answers your hard prompts in parallel; a judge picks the single best one, cross-checked against the rest. Call it as {{model}}.","fusion_faq_q1":"What is {{title}}?","fusion_faq_a1":"A curated multi-model router. On real work it runs a panel of models in parallel and a judge picks the single best answer, cross-checked against the rest; easy requests go to a cheaper default.","fusion_faq_q_fableapi":"Where can I access the Claude Fable 5 API?","fusion_faq_a_fableapi":"The Claude Fable 5 API was delisted and restricted, so it is no longer broadly callable. {{title}} is a drop-in, OpenAI-compatible alternative: it runs a panel of frontier models in parallel and a judge returns the strongest answer — a Fable-5-level option you can call today as {{model}}.","fusion_faq_q2":"How is it billed?","fusion_faq_a2":"As the sum of the panel members plus the judge it actually ran, only on the requests that fan out. Zero markup.","fusion_hero_tagline":"Fable 5 got pulled. Fusion rebuilds that level — from the models you can still call, at a fraction of the cost.","fusion_hero_tagline_flash":"Multi-model quality on a budget.","fusion_hero_desc":"Stop waiting for the next model — the next jump in capability is a panel, not a checkpoint. Fusion sends your hardest prompts to several frontier models at once, then a judge weighs where they agree, catches where they contradict, and returns the single strongest answer — cross-checked against the rest. Reach for it on the work that actually matters — deep reasoning, hard coding, research, expert critique — anywhere being wrong costs more than a few extra completions.","fusion_cta_playground":"Try in Playground","fusion_cta_apikey":"Get API key","fusion_how_title":"How it works","fusion_how_s1_title":"Route by task","fusion_how_s1_body":"Casual chat goes straight to a cheaper default. Coding, agent, and tool-using requests fan out to the panel — where a second opinion actually pays off.","fusion_how_s2_title":"Fan out to a panel","fusion_how_s2_body":"Your prompt hits several frontier models at once — independent attempts that each catch what the others miss.","fusion_how_s3_title":"Pick the best answer","fusion_how_s3_body":"A judge reads every candidate and returns the single strongest one — cross-checked against the others, not a single model's first try.","fusion_models_title":"Models in this router","fusion_models_note":"Want a different combination? Build your own panel from the \"Claude Fable 5 Level\" templates in the routing DSL editor.","fusion_models_note_flash":"Want a different combination? Build your own panel in the routing DSL editor.","fusion_judge_label":"judge","fusion_subline_modalities":"Text in · Text out","fusion_card_desc":"The best of {{models}}, picked per request.","fusion_card_desc_flash":"Multi-model quality on a budget — the best of {{models}}, picked per request.","fusion_quickstart_title":"Quick start","fusion_quickstart_note":"OpenAI-compatible. Swap the model slug — everything else stays the same.","fusion_billing_title":"Billing","fusion_billing_body":"Because fusion runs every panel member plus a judge, a fan-out request is billed as the sum of those underlying completions rather than a single model — and only on the requests that actually fan out. Zero markup.","fusion_tier_quality":"Quality","fusion_tier_mini":"Mini","fusion_tier_flash":"Budget","revenue_quality_title":"Net & gross revenue retention","revenue_quality_basis":"Basis","revenue_quality_basis_paid":"Paid","revenue_quality_basis_payment":"Cash","revenue_quality_export_csv":"Export CSV","revenue_quality_empty":"No retention data for the selected basis.","revenue_quality_series_nrr":"NRR","revenue_quality_series_grr":"GRR","revenue_quality_kpi_nrr":"Net revenue retention","revenue_quality_kpi_nrr_hint":"Includes expansion from existing customers","revenue_quality_kpi_grr":"Gross revenue retention","revenue_quality_kpi_grr_hint":"Expansion capped at 100%; shows churn + contraction","revenue_quality_kpi_prior_revenue":"Prior-window revenue","revenue_quality_kpi_prior_revenue_hint":"Denominator of the latest NRR / GRR","revenue_concentration_title":"Revenue concentration","revenue_concentration_export_csv":"Export CSV","revenue_concentration_empty":"No paying workspaces in the selected range.","revenue_concentration_kpi_top1":"Top 1% share","revenue_concentration_kpi_top1_hint":"Revenue held by the largest 1% of accounts","revenue_concentration_kpi_top5":"Top 5% share","revenue_concentration_kpi_top10":"Top 10% share","revenue_concentration_kpi_top20":"Top 20% share","revenue_concentration_kpi_hhi":"HHI","revenue_concentration_kpi_hhi_hint":"Herfindahl index (0–10000; higher = more concentrated)","revenue_concentration_kpi_gini":"Gini","revenue_concentration_kpi_gini_hint":"0 = even, 1 = all in one account","revenue_concentration_kpi_at_risk":"Revenue at risk","revenue_concentration_kpi_at_risk_hint":"Paid spend of the top-5 accounts","revenue_cohort_metric_logo":"Logo retention","revenue_cohort_metric_dollar":"Dollar retention","revenue_cohort_tooltip_dollar":"Paid $ / month-0 $","dashboards_tab_adoption":"Feature Adoption","dashboards_tab_byok":"BYOK","feature_adoption_feat_api_keys":"API keys","feature_adoption_feat_subscriptions":"Subscriptions","feature_adoption_feat_auto_topup":"Auto top-up","feature_adoption_feat_teams":"Teams","feature_adoption_feat_passkeys":"Passkeys","feature_adoption_feat_router":"Router","feature_adoption_feat_compliance":"Compliance","feature_adoption_feat_log":"Request logs","feature_adoption_feat_guardrai