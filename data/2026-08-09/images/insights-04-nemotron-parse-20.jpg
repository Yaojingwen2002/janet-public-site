hread_kind_request":"Request","threat_drawer_title":"Threat thread","threat_drawer_timeline":"Timeline","threat_drawer_categories":"Categories in this thread","threat_drawer_open_in_logs":"Open in Request Logs","threat_drawer_firewall_event":"Firewall","threat_drawer_guardrail_match":"Guardrail","threat_drawer_no_events":"This thread has no detections.","threat_drawer_confidence":"Confidence","threat_drawer_surface":"Surface","threat_drawer_verdict":"Verdict","threat_drawer_action":"Action","threat_drawer_tool":"Tool","threat_drawer_reason":"Reason","threat_drawer_policy":"Policy","threat_drawer_rule":"Rule","threat_drawer_egress_host":"Egress host","threat_drawer_guardrail_name":"Guardrail","threat_drawer_stage":"Stage","threat_taxonomy_title":"Threat taxonomy","threat_taxonomy_version":"Taxonomy version {{version}}","threat_taxonomy_col_tag":"Tag","threat_taxonomy_col_category":"Category","threat_taxonomy_col_default_severity":"Default severity","threat_taxonomy_empty":"No taxonomy is configured yet.","threat_taxonomy_error":"Couldn't load the threat taxonomy.","threat_tag_field_label":"Threat tag (optional)","threat_tag_field_hint":"Tag matches from this rule with a threat category and severity. Leave blank to let the taxonomy classify automatically.","threat_tag_field_category":"Category","threat_tag_field_tag":"Tag","threat_tag_field_severity":"Severity","threat_tag_field_auto":"Auto (from taxonomy)","threat_chip_more":"+{{count}} more","threat_thread_row_open_aria":"Open threat thread {{id}}","threat_cat_llm01_prompt_injection":"Prompt injection","threat_cat_llm02_sensitive_information_disclosure":"Sensitive information disclosure","threat_cat_llm03_supply_chain":"Supply chain","threat_cat_llm05_improper_output_handling":"Improper output handling","threat_cat_llm06_excessive_agency":"Excessive agency","threat_cat_llm07_system_prompt_leakage":"System prompt leakage","threat_cat_llm09_misinformation":"Misinformation","threat_cat_llm10_unbounded_consumption":"Unbounded consumption","threat_cat_coverage_gap":"Coverage gap","threat_cat_policy_violation":"Policy violation","threat_overview_truncated":"Showing the most recent detections; the total is capped and may be higher.","threat_threads_truncated":"Showing the most recent detections; older threads beyond the cap (even higher-severity ones) may be omitted.","sec_tier_badge":"Security Research","sec_tier_card_subtitle":"Unrestricted model for authorized security work","sec_tier_enable_cta":"Enable access","sec_tier_signin_to_enable":"Sign in to enable access","sec_tier_cancel":"Cancel","sec_tier_modal_title":"Enable Security Research access","sec_tier_continue":"Continue","sec_tier_back":"Back","sec_tier_payment_step_title":"Payment method","sec_tier_add_card_cta":"Add payment method","sec_tier_add_card_failed":"Could not start payment setup. Please try again.","sec_tier_checking_card":"Checking payment method…","sec_tier_card_on_file":"A payment method is on file. You can enable access now.","sec_tier_card_required_note":"A valid payment method is required to enable this tier. You will be redirected to add one — the card is only verified, never charged.","sec_tier_no_card_rail":"Card payments are unavailable right now, so this tier cannot be enabled. Please contact support.","sec_tier_card_settling":"Your card is still being confirmed. Give it a moment, then enable access again.","sec_tier_card_not_confirmed":"Your card could not be confirmed. Please add a payment method again.","sec_tier_card_admin_note":"A valid payment method must be on file to enable this tier. If enabling fails, ask a workspace admin to add one in Billing.","sec_tier_modal_intro":"These are unrestricted models for authorized security work. Access is logged and governed by the Acceptable Use Policy.","sec_tier_aup_checkbox":"I'm a security professional and will use these models only for authorized, lawful work — I accept the Acceptable Use Policy","sec_tier_aup_link":"Read the Acceptable Use Policy","sec_tier_payment_note":"A valid payment method is required before access is granted.","sec_tier_enable_success":"Security Research access enabled.","sec_tier_enable_failed":"Could not enable access. Please try again.","sec_tier_enable_denied":"Access to the Security Research tier was denied for this account.","sec_tier_deny_verification":"Identity verification is required before this tier can be enabled.","sec_tier_deny_risk_hold":"This account is on a temporary review hold. Please try again later or contact support.","sec_tier_deny_payment":"Add a valid payment method to enable this tier.","sec_tier_add_payment_cta":"Add a payment method","sec_tier_card_title":"Security Research access","sec_tier_card_desc":"Unrestricted models for authorized, lawful security work. Governed by the Acceptable Use Policy.","sec_tier_loading":"Loading access status…","sec_tier_status_label":"Status","sec_tier_status_granted":"Granted","sec_tier_status_not_enabled":"Not enabled","sec_tier_trust_level":"Trust","sec_tier_kyc_status":"KYC","sec_tier_risk_hold":"On review hold","sec_tier_expires":"Access renews / expires","sec_tier_verify_required":"Identity verification is required before access can be granted.","sec_tier_verify_cta":"Verify to continue","sec_tier_reaccept_required":"The Acceptable Use Policy was updated. Re-accept it to restore access.","sec_tier_reaccept_cta":"Re-accept policy","sec_tier_reaccept_modal_title":"Re-accept the Acceptable Use Policy","sec_tier_verify_started":"Verification started. We will update your status shortly.","sec_tier_verify_failed":"Could not start verification. Please try again.","sec_tier_verify_unavailable":"Identity verification isn't available yet — contact support to lift the hold.","sec_tier_granted_note":"You can call the Security Research models from any of your API keys.","sec_tier_status_pending_note":"Your access request is under review. We will update this page when a decision is made.","sec_tier_status_inactive_note":"This access tier is not active for your workspace. Contact support if you need a review.","sec_tier_status_value_pending":"Pending review","sec_tier_status_value_approved":"Approved","sec_tier_status_value_rejected":"Not approved","sec_tier_status_value_revoked":"Revoked","sec_tier_trust_value_developer":"Developer","sec_tier_trust_value_enterprise":"Enterprise","sec_tier_kyc_value_card_on_file":"Card on file","sec_tier_kyc_value_verified":"Verified","sec_tier_viewer_readonly_note":"Only workspace developers, admins, or owners can enable this tier. Ask a workspace admin to enable it for you.","aup_seo_title":"Acceptable Use Policy — Security Research","aup_seo_description":"Acceptable Use Policy for the OrcaRouter Security Research tier: permitted security work, privacy controls, and strictly prohibited uses.","aup_title":"Acceptable Use Policy — Security Research","aup_intro":"The Security Research tier provides unrestricted models for authorized, lawful security work. Access is granted to verified security professionals and is governed by this policy. Misuse results in immediate revocation.","aup_allowed_title":"Allowed uses","aup_allowed_intro":"For authorized, lawful security work you may use these models for:","aup_allowed_exploit":"Exploit and proof-of-concept (PoC) development","aup_allowed_malware":"Malware analysis and deobfuscation","aup_allowed_payload":"Payload and shellcode development","aup_allowed_c2":"Command-and-control (C2) tooling","aup_allowed_re":"Reverse engineering","aup_allowed_vuln":"Vulnerability research","aup_allowed_phishing":"Authorized phishing and social-engineering assessments","aup_privacy_title":"Privacy","aup_privacy_intro":"This tier is designed around strict privacy controls:","aup_privacy_zdr":"Designed for zero data retention","aup_privacy_screened":"Request content is screened in memory","aup_privacy_not_stored":"Zero-data-retention is available for this tier","aup_privacy_not_trained":"When zero-data-retention is enabled, your content is not used for training","aup_blocked_title":"Strictly prohibited","aup_blocked_intro":"These uses are never permitted under any circumstances:","aup_blocked_csam":"Child sexual abuse material (CSAM)","aup_blocked_cbrn":"Chemical, biological, radiological, nuclear weapons or other weapons of mass destruction (CBRN/WMD)","aup_blocked_fraud":"Large-scale fraud-as-a-service","aup_blocked_note":"Note: CSAM and CBRN/WMD content is strictly blocked; confirmed cases are handled through our incident and abuse process.","leaderboard_title":"AI Model Leaderboard","leaderboard_subtitle":"Ranked on real OrcaRouter production traffic and community Battle Mode votes — not vendor-reported benchmarks.","leaderboard_seo_title":"AI Model Leaderboard — OrcaRouter","leaderboard_seo_desc_lead":"The OrcaRouter model leaderboard, ranked on real production traffic and community Battle Mode votes.","leaderboard_real_traffic_note":"Measured on real traffic","leaderboard_no_data_short":"No data yet","leaderboard_subnav_aria":"Leaderboard sections","leaderboard_nav_overall":"Overall","leaderboard_nav_reliability":"Reliability","leaderboard_chart_aria":"Win-rate leaderboard with 95% confidence intervals","leaderboard_highlight_best_success":"Top success rate (7d)","leaderboard_highlight_fastest":"Fastest p50 latency","leaderboard_highlight_top_winrate":"Top community win rate","leaderboard_overall_heading":"Overall — community win rate","leaderboard_overall_note":"Head-to-head Battle Mode votes, ranked by Wilson lower bound. Dots show win rate; bars show the 95% confidence interval.","leaderboard_reliability_heading":"Reliability & cost","leaderboard_reliability_note":"Measured on OrcaRouter production traffic over the last 7 days.","leaderboard_col_rank":"Rank","leaderboard_col_model":"Model","leaderboard_col_winrate":"Win rate","leaderboard_col_ci":"95% CI","leaderboard_col_votes":"Votes","leaderboard_col_record":"W·L·T","leaderboard_tag_provisional":"preference · provisional","leaderboard_tag_p