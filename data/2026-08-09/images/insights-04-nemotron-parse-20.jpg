      <script>
    (function () {
      var p = window.location.pathname;
      // Decode before every check: /%72edeem/SECRET routes to the decoded
      // path server-side while location.pathname keeps the raw bytes, so an
      // encoded capability URL would slip the guards. Malformed escapes fail
      // CLOSED. Mirrors web/index.html (round 28).
      var pDecodeFailed = false;
      try {
        p = decodeURIComponent(p);
      } catch (e) {
        pDecodeFailed = true;
      }
      // Collapse repeated separators — same direction as the decode, same
      // reason: every check below is anchored ^\/ with one separator per
      // segment, so //compliance/share/TOKEN slipped all of them while the
      // ingress merged the slashes and served the real route. Mirrors
      // web/index.html (round 53).
      p = p.replace(/\/{2,}/g, '/');
      // Credential-/PII-bearing query values no path check can see: bearer
      // tokens, the Stripe Checkout session_id on the billing return, email /
      // login_hint / focus_user_email, and redirect targets that can nest a
      // token. Anchored on [?&] so ?promo_code= is unaffected. Mirrors
      // web/index.html.
      // Matched on DECODED KEY NAMES: URLSearchParams decodes keys, so the app
      // consumes ?%73ession_id= as session_id while a raw-byte regex sees
      // nothing (round 31). Split on the raw boundaries, decode only the key —
      // decoding the whole string would let an encoded value forge boundaries.
      // Undecodable keys fail CLOSED. Mirrors web/index.html.
      var SENSITIVE_PARAM_RE =
        /^(token|email|login_hint|focus|focus_[a-z0-9_]*|prompt|prompt_id|conversation_id|tool|tool_name|arg_paths|request_id|workspace_name|member_user_id|byok_key_id|client_app[a-z0-9_]*|run_id|guardrail_id|deployment_id|ws|skill_[a-z0-9_]*|redirect|redirect_uri)$/i;
      // session_id is sensitive ONLY on a checkout return — the Stripe
      // Checkout Session ID on /console/billing — because ActivityTab
      // deliberately uses ?session_id= as an ordinary firewall drill-in filter
      // (/console/firewall?tab=activity&session_id=…), and __skipAnalytics is
      // DOCUMENT-STICKY, so an admin bookmarking that drill-in disabled
      // tracking for the whole document (codex round 48). Scoped by path
      // prefix on the decoded path, failing closed when it would not decode.
      // Mirrors web/index.html.
      var CHECKOUT_RETURN_PATH_RE =
        /^(\/[A-Za-z]{2}(-[A-Za-z0-9]+)?)?\/(console\/billing|redeem)(\/|$)/i;
      var onCheckoutReturn = pDecodeFailed || CHECKOUT_RETURN_PATH_RE.test(p);
      var sensitiveQuery = false;
      try {
        var pairs = (window.location.search || '').replace(/^\?/, '').split('&');
        for (var qi = 0; qi < pairs.length; qi++) {
          var rawKey = pairs[qi].split('=')[0];
          if (!rawKey) continue;
          var decodedKey = decodeURIComponent(rawKey.replace(/\+/g, ' '));
          if (SENSITIVE_PARAM_RE.test(decodedKey)) {
            sensitiveQuery = true;
            break;
          }
          if (onCheckoutReturn && /^session_id$/i.test(decodedKey)) {
            sensitiveQuery = true;
            break;
          }
        }
      } catch (e) {
        sensitiveQuery = true;
      }
      // Locale-stripped path for the exact/prefix auth checks (round 15) —
      // /zh-CN/auth etc. are served as the shell with the query preserved,
      // so the raw-path checks would miss them. Mirrors web/index.html.
      var pNoLocale = p.replace(/^\/[A-Za-z]{2}(-[A-Za-z0-9]+)?(?=\/)/, '').toLowerCase();
      var isRedeem = /^(\/[A-Za-z]{2}(-[A-Za-z0-9]+)?)?\/redeem(\/|$)/i.test(p);
      var isBoostShare = /^(\/[A-Za-z]{2}(-[A-Za-z0-9]+)?)?\/b\//i.test(p);
      var isSquadShare = /^(\/[A-Za-z]{2}(-[A-Za-z0-9]+)?)?\/s\//i.test(p);
      var isComplianceShare = /^(\/[A-Za-z]{2}(-[A-Za-z0-9]+)?)?\/compliance\/share(\/|$)/i.test(p);
      var pendingRedeem = false;
      try {
        // The stash is a return TARGET and inherits its route's sensitivity:
        // PKCEAuthorize and AcceptInvite write their full query-bearing URLs
        // here before hard-navigating to /login (round 24). Mirrors
        // web/index.html.
        // DECODED and fail-closed (round 66): both writers stash
        // location.pathname + location.search verbatim, so the escapes from the
        // address bar survive and /%61ccept-invite?token=… resolved to the real
        // route while this regex saw nothing. Query off first so an encoded
        // VALUE cannot forge a path match. Mirrors web/index.html.
        var stashed = localStorage.getItem('post_login_redirect') || '';
        var sPath = stashed.split('?')[0].split('#')[0];
        var sDecoded = sPath;
        var sDecodeFailed = false;
        try { sDecoded = decodeURIComponent(sPath); } catch (e2) { sDecodeFailed = true; }
        var sRe = /(^|\/)(redeem|b|s|compliance\/share)\/|(^|\/)(auth|accept-invite)(\/|$)/i;
        pendingRedeem =
          (!!stashed && sDecodeFailed) ||
          sRe.test(sPath) ||
          sRe.test(sDecoded) ||
          sRe.test(sPath.replace(/\/{2,}/g, '/')) ||
          sRe.test(sDecoded.replace(/\/{2,}/g, '/'));
      } catch (e) {}
      try {
        pendingRedeem =
          pendingRedeem ||
          !!(sessionStorage.getItem('pending_redeem_code') || '') ||
          !!(sessionStorage.getItem('pending_redeem_claim') || '') ||
          !!(sessionStorage.getItem('pending_squad_join') || '');
      } catch (e) {}
      // Single decoded, fail-closed OAuth-callback decision for every tag
      // template below — they used to re-derive it from the raw pathname in six
      // separate copies (round 32). Mirrors web/index.html.
      window.__ORCA_OAUTH_CALLBACK =
        pDecodeFailed || /^(\/[A-Za-z]{2}(-[A-Za-z0-9]+)?)?\/oauth\//i.test(p);
      // Suppression reasons split by whether they are STILL TRUE after an SPA
      // navigation (codex round 61 / open item 15). __skipAnalytics is
      // document-sticky, so a cold load of an invalid /s/:token that then
      // navigates to / left the whole document permanently unreportable —
      // on a static frontend the deferred fallback tags never install at all.
      //
      // The naive fix is to drop the sticky short-circuit in
      // analyticsSuppressed(); that UNDER-suppresses, which is the direction
      // that leaks credentials rather than the one that loses a conversion.
      // So the guard publishes WHY instead, and the runtime re-evaluates only
      // the reasons it can re-derive from the CURRENT url.
      //
      // STICKY = true about this SESSION, not about the URL we are on:
      // an impersonation view token and the claim-resume breadcrumbs outlive
      // any navigation, so a document that booted under them stays silent.
      // Stored impersonation, read the same way helpers/impersonation.js does.
      // The PATH check below is not enough (codex round 65): the bootstrap page
      // scrubs its own url and navigates into the app, so a RELOAD in that tab
      // parses at /console with imp_token still in sessionStorage. Round 64 gave
      // analytics.js an isImpersonating() check, but THIS script runs first and
      // GTM plus the injected head tags load from it — by the time any module
      // could object, the tags are already live on the customer's account.
      // Exactly the fix-it-twice shape this file's own drift pins exist for.
      var impersonating = false;
      try {
        impersonating = !!(
          sessionStorage.getItem('imp_token') &&
          sessionStorage.getItem('imp_user')
        );
      } catch (e) {
        // Storage unavailable: nothing could have been stashed there either.
        impersonating = false;
      }
      var stickyReason =
        impersonating ||
        pNoLocale.indexOf('/impersonate') === 0 ||
        pendingRedeem;
      // PATH/QUERY = true only of the url in the address bar right now.
      var pathQueryReason =
        pDecodeFailed ||
        sensitiveQuery ||
        pNoLocale.indexOf('/user/reset') === 0 ||
        pNoLocale.indexOf('/login/magic') === 0 ||
        pNoLocale === '/auth' ||
        pNoLocale === '/auth/' ||
        pNoLocale.indexOf('/accept-invite') === 0 ||
        isRedeem ||
        isBoostShare ||
        isSquadShare ||
        isComplianceShare;
      window.__skipAnalytics = stickyReason || pathQueryReason;
      // Only when EVERY reason was about the url may the runtime re-decide.
      // Absent/false keeps the pre-existing sticky behaviour exactly, so a
      // reason added to the guard without being classified here fails CLOSED.
      window.__skipAnalyticsPathOnly = !stickyReason && pathQueryReason;
    })();
    </script>
    <script>window.__AD_CLICK_ID_PARAMS = ["gclid","gbraid","wbraid","fbclid","msclkid","ttclid","twclid","li_fat_id","rdt_cid","sccid","ScCid","epik"];</script>
    <script>window.__AD_TRACKING_ON = {vendor:true,custom:false};</script>
    <!-- Meta Pixel (admin-configured) -->
    <script>
    (function () {
      if (window.__skipAnalytics) { return; }
      if (window.__ORCA_OAUTH_CALLBACK) { return; }
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '656083250933792');
      fbq('track', 'PageView');
    })();
    </script></head>
