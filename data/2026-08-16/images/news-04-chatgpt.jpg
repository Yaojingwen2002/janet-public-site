<script>
document.addEventListener('DOMContentLoaded', function () {
	var content = document.querySelector('.post-content');
	if (!content) return;

	var headings = Array.prototype.filter.call(
		content.querySelectorAll('h2'),
		function (h) { return h.parentNode === content; }
	);

	headings.forEach(function (heading) {
		var ad = document.createElement('aside');
		ad.className = 'post-ad';
		ad.setAttribute('aria-label', 'Advertisement');
		ad.style.cssText = 'margin:48px auto;padding:16px;border-radius:16px;background:var(--color-background-100);text-align:center';
		ad.innerHTML =
			'<span style="display:block;margin-bottom:10px;color:var(--color-secondary);font-size:12px;letter-spacing:.06em;text-transform:uppercase">Advertisement</span>' +
			'<ins class="adsbygoogle" style="display:block;text-align:center"' +
			' data-ad-layout="in-article"' +
			' data-ad-format="fluid"' +
			' data-ad-client="ca-pub-5533680193282546"' +
			' data-ad-slot="2738168343"></ins>';

		content.insertBefore(ad, heading);
		(window.adsbygoogle = window.adsbygoogle || []).push({});
	});
});
</script>


