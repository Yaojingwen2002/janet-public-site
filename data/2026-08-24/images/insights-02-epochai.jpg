  <path d="M10 7.88786C9.094 6.12686 6.628 2.84386 4.335 1.22586C2.138 -0.324144 1.301 -0.0571439 0.752 0.192856C0.116 0.477856 0 1.45486 0 2.02786C0 2.60286 0.315 6.73686 0.52 7.42786C1.2 9.70786 3.614 10.4779 5.84 10.2309C2.58 10.7139 -0.317 11.9009 3.48 16.1289C7.658 20.4539 9.206 15.2019 10 12.5389C10.794 15.2019 11.708 20.2649 16.444 16.1289C20 12.5389 17.421 10.7139 14.161 10.2309C16.386 10.4779 18.801 9.70786 19.48 7.42786C19.685 6.73786 20 2.60286 20 2.02886C20 1.45386 19.884 0.478856 19.248 0.190856C18.699 -0.057144 17.862 -0.326144 15.665 1.22386C13.372 2.84486 10.905 6.12786 10 7.88786Z" fill="currentColor"/>
