line underline-offset-2 hover:text-primary/80 transition-colors\",\"onClick\":\"$undefined\",\"children\":\"public safety\"}],[\"$\",\"$L29\",\"3308\",{\"href\":\"/topics/civil-liberties\",\"className\":\"text-primary underline underline-offset-2 hover:text-primary/80 transition-colors\",\"onClick\":\"$undefined\",\"children\":\"Civil Liberties\"}],[\"$\",\"$L29\",\"18023\",{\"href\":\"/topics/automated-license-plate-readers\",\"className\":\"text-primary underline underline-offset-2 hover:text-primary/80 transition-colors\",\"onClick\":\"$undefined\",\"children\":\"Automated License Plate Readers\"}],[\"$\",\"$L29\",\"5950\",{\"href\":\"/topics/flock-safety\",\"className\":\"text-primary underline underline-offset-2 hover:text-primary/80 transition-colors\",\"onClick\":\"$undefined\",\"children\":\"Flock Safety\"}]]}]]}]\n3d:[\"$\",\"div\",null,{\"className\":\"lg:col-span-4 mt-10 lg:mt-0 min-w-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-muted/30 border border-border p-4 min-h-[140px]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mb-2 text-center uppercase tracking-wide\",\"children\":\"Advertisement\"}],[\"$\",\"$L41\",null,{\"zone\":\"sidebar1\",\"className\":\"my-8\"}]]}],[\"$\",\"$7\",null,{\"fallback\":[\"$\",\"div\",null,{\"className\":\"animate-pulse bg-muted h-96 rounded\"}],\"children\":\"$L42\"}],[\"$\",\"div\",null,{\"className\":\"bg-muted/30 border border-border p-4 min-h-[140px] mt-6\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mb-2 text-center uppercase tracking-wide\",\"children\":\"Advertisement\"}],[\"$\",\"$L41\",null,{\"zone\":\"sidebar2\",\"className\":\"my-8\"}]]}],[\"$\",\"$7\",null,{\"fallback\":[\"$\",\"div\",null,{\"className\":\"animate-pulse bg-muted h-64 rounded mt-6\"}],\"children\":[\"$\",\"div\",null,{\"className\":\"lg:sticky lg:top-20 w-full\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-white dark:bg-card p-6 z-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-primary font-bold text-sm lg:text-lg uppercase tracking-wider mb-6\",\"children\":\"People Also Ask\"}],[\"$\",\"$L43\",null,{\"type\":\"multiple\",\"className\":\"divide-y flex flex-col\",\"children\":[[\"$\",\"$L44\",\"0\",{\"value\":\"paa-0\",\"children\":[[\"$\",\"$L45\",null,{\"className\":\"text-start text-foreground font-semibold text-base hover:text-primary\",\"children\":\"What is Flock Safety and how does it work?\"}],[\"$\",\"$L46\",null,{\"children\":\"Flock Safety is a surveillance startup deploying AI-powered cameras and automated license plate readers across over 5,000 U.S. cities. Its computer vision technology automatically captures and catalogs every passing vehicle into searchable databases that police departments and homeowner associations query to track movements. The company handles installation, maintenance, and data management on a monthly subscription basis.\"}]]}],[\"$\",\"$L44\",\"1\",{\"value\":\"paa-1\",\"children\":[[\"$\",\"$L45\",null,{\"className\":\"text-start text-foreground font-semibold text-base hover:text-primary\",\"children\":\"Why is Flock Safety facing privacy backlash?\"}],[\"$\",\"$L46\",null,{\"children\":\"Privacy groups like ACLU and EFF warn that Flock Safety enables mass surveillance with insufficient oversight. Police have m"])</script><script>self.__next_f.push([1,"isused the technology to track protesters, investigate minor violations, and build profiles of innocent people. Installations often occurred without public input, and the company created permanent tracking infrastructure without community conversations about data retention or civil liberties protections.\"}]]}],[\"$\",\"$L44\",\"2\",{\"value\":\"paa-2\",\"children\":[[\"$\",\"$L45\",null,{\"className\":\"text-start text-foreground font-semibold text-base hover:text-primary\",\"children\":\"Did San Francisco ban Flock Safety cameras?\"}],[\"$\",\"$L46\",null,{\"children\":\"Yes, San Francisco's Board of Supervisors banned Flock Safety entirely due to racial profiling and abuse concerns. Other cities including San Jose and Oakland have also canceled contracts or imposed restrictions. These bans reflect growing municipal concerns about automated surveillance systems operating without adequate oversight and public transparency requirements.\"}]]}],[\"$\",\"$L44\",\"3\",{\"value\":\"paa-3\",\"children\":[[\"$\",\"$L45\",null,{\"className\":\"text-start text-foreground font-semibold text-base hover:text-primary\",\"children\":\"How long does Flock Safety retain video footage?\"}],[\"$\",\"$L46\",null,{\"children\":\"Flock Safety retains footage for 30 days by default, though some contracts extend this window. Privacy advocates argue that even 30 days of comprehensive vehicle tracking creates detailed maps of daily movements, including visits to medical clinics, religious institutions, and political meetings. Retention policies vary across different municipal contracts.\"}]]}],\"$L47\",\"$L48\"]}]]}]}]}]}]]}]\n"])</script><link rel="preload" as="image" imageSrcSet="/cdn-cgi/image/width=640,quality=85,format=auto,fit=cover/https://charming-card-d91ad3487b.media.strapiapp.com/large_file_91a22373fc.png 640w, /cdn-cgi/image/width=750,quality=85,format=auto,fit=cover/https://charming-card-d91ad3487b.media.strapiapp.com/large_file_91a22373fc.png 750w, /cdn-cgi/image/width=828,quality=85,format=auto,fit=cover/https://charming-card-d91ad3487b.media.strapiapp.com/large_file_91a22373fc.png 828w, /cdn-cgi/image/width=1080,quality=85,format=auto,fit=cover/https://charming-card-d91ad3487b.media.strapiapp.com/large_file_91a22373fc.png 1080w, /cdn-cgi/image/width=1200,quality=85,format=auto,fit=cover/https://charming-card-d91ad3487b.media.strapiapp.com/large_file_91a22373fc.png 1200w, /cdn-cgi/image/width=1200,quality=85,format=auto,fit=cover/https://charming-card-d91ad3487b.media.strapiapp.com/large_file_91a22373fc.png 