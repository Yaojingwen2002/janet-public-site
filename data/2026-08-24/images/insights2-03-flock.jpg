      </style><div id="bsa-zone_1775145989229-9_123456"></div></div></div><!--$?--><template id="B:9"></template><div class="animate-pulse bg-muted h-64 rounded mt-6"></div><!--/$--></div></div><script>$RS("S:6","P:6")</script><script>$RC("B:2","S:2")</script><div hidden id="S:9"><div class="lg:sticky lg:top-20 w-full"><div class="relative overflow-hidden"><div class="relative bg-white dark:bg-card p-6 z-10"><h2 class="text-primary font-bold text-sm lg:text-lg uppercase tracking-wider mb-6">People Also Ask</h2><div class="divide-y flex flex-col" data-orientation="vertical"><div data-state="closed" data-orientation="vertical" class="border-b"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-_R_9kk5fiv5ullb_" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-_R_1kk5fiv5ullb_" class="flex flex-1 items-center justify-between py-4 transition-all hover:underline [&amp;[data-state=open]&gt;svg]:rotate-180 text-start text-foreground font-semibold text-base hover:text-primary" data-radix-collection-item="">What is Flock Safety and how does it work?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-_R_9kk5fiv5ullb_" hidden="" role="region" aria-labelledby="radix-_R_1kk5fiv5ullb_" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width)"></div></div><div data-state="closed" data-orientation="vertical" class="border-b"><h3 data-or