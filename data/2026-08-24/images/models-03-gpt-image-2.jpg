ote\":\"Generated with fal.ai's optimized version of the Ideogram 4.0 open weights model. fal's Fast variant is an FP4-quantized checkpoint trained with quantization-aware distillation, with classifier-free guidance distilled into a single branch for faster inference. Run with fal's BALANCED rendering speed setting.\",\"introducedAt\":\"2026-07-06T20:21:13.391295+00:00\",\"ciDelta\":27,\"ciLower\":982.93,\"ciUpper\":1036.9299999999998}},{\"formatted\":{\"rank\":39,\"elo\":\"1,010\",\"appearances\":\"480\",\"released\":\"Jul 2026\",\"apiPricing\":\"$L39d\",\"winRate\":\"49%\"},\"values\":{\"id\":\"740929c5-09b6-4a81-b98e-00e903e27d84\",\"name\":\"Ideogram 4.0 Instant\",\"url\":null,\"rank\":38,\"elo\":1009.7,\"appearances\":480,\"creator\":{\"id\":\"d3f67dc4-ba4d-4103-ba79-ee321ca99b40\",\"name\":\"Fal\",\"logo\":\"/img/logos/fal_small.svg\",\"color\":\"#FF6B35\"},\"released\":\"2026-07-13\",\"openWeightsUrl\":\"https://huggingface.co/fal/ideogram-v4-instant\",\"pricePer1kImages\":7.5,\"isScraped\":false,\"isCurrent\":true,\"isRecent\":false,\"isFirstPartyFoundational\":true,\"winRate\":0.4875,\"note\":\"Generated with fal.ai's optimized version of the Ideogram 4.0 open weights model. fal's Instant variant is an FP4-quantized checkpoint trained with quantization-aware distillation, with classifier-free guidance distilled into a single branch and additional timestep distillation to reduce denoising steps.\",\"introducedAt\":\"2026-07-06T20:21:13.391295+00:00\",\"ciDelta\":26,\"ciLower\":983.7,\"ciUpper\":1035.7}},{\"formatted\":{\"rank\":40,\"elo\":\"1,008\",\"appearances\":\"1,233\",\"released\":\"Jun 2026\",\"apiPricing\":\"$L39e\",\"winRate\":\"49%\"},\"values\":{\"id\":\"f625feda-2695-40cc-ba87-a5e65b914021\",\"name\":\"Ideogram 4.0 (Quality)\",\"url\":null,\"rank\":39,\"elo\":1008.04,\"appearances\":1233,\"creator\":{\"id\":\"a8b2ac11-1f36-44cb-9e88-383c4e0d749f\",\"name\":\"Ideogram\",\"logo\":\"/img/logos/ideogram_small.svg\",\"color\":\"#18181B\"},\"released\"