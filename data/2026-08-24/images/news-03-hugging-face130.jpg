2Fos%2Fcreatr-uploaded-images%2F2020-11%2F62e21440-2fbd-11eb-95ff-5673fa3d2f9f" alt="Reuters" class="provider-logo" loading="lazy" width="103" height="24" fetchpriority="auto"></picture>  </a> </div> <div class="cover-headline yf-1wlntij"><h1 class="cover-title yf-1wlntij">Hugging Face exploring sale valuing it at $13 billion, Business Insider says</h1>    <label data-testid="typography" class=" type-ui-xxl-reg    yf-gjjls9"> </label></div></div>  <div class="byline yf-z1ictt"><div class="byline-attr yf-z1ictt"> <div><div class="byline-attr-author yf-z1ictt">  Reuters </div> <div class="byline-attr-time-style"> <time class="byline-attr-meta-time" datetime="2026-08-23T20:00:12+00:00" data-timestamp="2026-08-23T20:00:12+00:00">Sun, August 23, 2026 at 1:00 PM PDT</time> <span class="byline-attr-mins-read yf-1pgkgts">1 min read</span></div></div></div> <div class="byline-share yf-z1ictt"><div><span class="share-dialog yf-15uzx9j"><div class="menuContainer  yf-1uspju" style="                    " role="presentation">   <button class="tertiary-btn fin-size-medium menuBtn tw-p-1    rounded   highlightWhenExpanded yf-7mptsx" data-ylk="elmt:menu;itc:1;elm:btn;sec:consolidated-share-popup;g:48f88407-e1ca-3a0e-b2d3-ac35c04bf27a;slk:share-menu-open" data-yga="{&quot;yLinkElementType&quot;:&quot;menu&quot;,&quot;yLinkElement&quot;:&quot;btn&quot;,&quot;yModuleName&quot;:&quot;consolidated-share-popup&quot;,&quot;yDestinationContentUUID&quot;:&quot;48f88407-e1ca-3a0e-b2d3-ac35c04bf27a&quot;,&quot;yLinkText&quot;:&quot;share-menu-open&quot;}" aria-haspopup="true" aria-controls="menu-jngu93my" tabindex="0" title="Share links" data-testid="share-link" dialogAlignLeftValue="-240px" dialogAlignTopValue="40px" aria-label="Share links"> <div aria-hidden="true" class="icon fin-icon primary-icn sz-x-large  yf-15ilbqr" data-icon-type="ios-share" data-testid="desktop-share-icon"><!-- HTML_TAG_START --><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="m16 5-1.42 1.42-1.59-