  <section
    data-component="breakthroughs"
    data-behavior="breakthroughs"
    class="py-set-11 breakout overflow-hidden bg-accent-deep-beige"
  >
    <div class="container relative z-10 flex flex-col gap-y-20 md:gap-y-80 md:pb-200">

      
        <div class="offset-grid relative z-10">
          <h2 class="f-h1 whitespace-pre-line text-pretty" data-reveal="true">
            Unlocking future
breakthroughs
across industries
          </h2>
        </div>
      

      <div data-breakthroughs-carousel class="relative flex flex-col gap-y-20 md:block" aria-roledescription="carousel">
        
          <ul class="flex flex-row-reverse gap-8 order-2 justify-end">
            <li class="md:absolute md:z-10 md:-10 md:top-1/2 md:end-0 md:-mt-24">
              <button
                type="button"
                class="border-1 border-inverse rounded-full text-accent-orange flex items-center justify-center size-40 md:size-48 hover:bg-white-opacity-85 hover:border-inverse focus:bg-white-opacity-85 focus:border-inverse cursor-pointer bg-white"
                data-breakthroughs-next
                aria-label="Show next video"
              >
                <svg class="block size-16" aria-hidden="true">
                  <use xlink:href="#arrow-right-21"></use>
                </svg>
              </button>
            </li>
            <li class="md:absolute md:z-10 md:top-1/2 md:start-0 md:-mt-24">
              <button
                type="button"
                class="border-1 border-inverse rounded-full text-accent-orange flex items-center justify-center size-40 md:size-48 hover:bg-white-opacity-85 hover:border-inverse focus:bg-white-opacity-85 focus:border-inverse cursor-pointer bg-white"
                data-breakthroughs-prev
                aria-label="Show previous video"
              >
                <svg class="block size-16 rotate-180" aria-hidden="true">
                  <use xlink:href="#arrow-right-21"></use>
                </svg>
              </button>
            </li>
          </ul>
        

        <ul class="relative z-1 grid" data-breakthroughs-list>
          
            

            <li
              class="breakthrough__item relative aspect-16/9 md:w-cols-10 md:mx-auto row-start-1 col-start-1"
              data-breakthroughs-item
              data-index="0"
              
            >
              <button
                type="button"
                class="absolute z-0 inset-0 cursor-pointer bg-secondary group overflow-hidden"
                data-breakthroughs-poster
                aria-label="Play Simulating human behavior through AI agents"
              >
                
                  <img
