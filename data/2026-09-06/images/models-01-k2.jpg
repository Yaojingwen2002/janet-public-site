        measurementId: 'G-RSN3PPM5N0',
        scriptUrl: 'https://www.googletagmanager.com/gtag/js?id=G-RSN3PPM5N0',
        consentStatus: 'denied',
        initialized: false,
        getDeploymentEnvironment(hostname) {
          const productionHostname = 'ifm.ai';

          if (hostname === productionHostname) {
            return 'production';
          }

          if (hostname === `staging.${productionHostname}`) {
            return 'staging';
          }

          return 'other';
        },
        init() {
          if (this.initialized) {
            return;
          }

          const script = document.createElement('script');
          script.async = true;
          script.src = this.scriptUrl;
          document.head.appendChild(script);

          gtag('js', new Date());
          const deploymentEnvironment = this.getDeploymentEnvironment(
            window.location.hostname,
          );
          gtag('config', this.measurementId, {
            deployment_environment: deploymentEnvironment,
          });
          gtag('set', 'url_passthrough', true);
          this.initialized = true;
        },
        clearAnalyticsCookies() {
          const cookieNames = document.cookie
            .split(';')
            .map((cookie) => cookie.split('=')[0].trim())
            .filter((name) => name === '_ga' || name.startsWith('_ga_'));
          const domains = [null];

          if (
            window.location.hostname === 'ifm.ai'
            || window.location.hostname.endsWith('.ifm.ai')
          ) {
            domains.push('.ifm.ai');
          }

          for (const name of cookieNames) {
            for (const domain of domains) {
              const domainAttribute = domain ? `; Domain=${domain}` : '';
              document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax${domainAttribute}`;
            }
          }
        },
        updateConsent(status) {
          const isAccepted = status === 'accepted';
          this.consentStatus = status;
          window[`ga-disable-${this.measurementId}`] = !isAccepted;
          gtag('consent', 'update', {
            ad_storage: 'denied',
            analytics_storage: isAccepted ? 'granted' : 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });

          if (isAccepted) {
            this.init();
          } else {
            this.clearAnalyticsCookies();
          }
        }
      };

      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });

