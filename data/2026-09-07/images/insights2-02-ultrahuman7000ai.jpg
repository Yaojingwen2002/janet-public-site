28\",{}]]\n"])</script><script>self.__next_f.push([1,"1f:I[5500,[\"/_next/static/chunks/33zu5gerlsnj9.js?dpl=dpl_3xhGAdw9KMZbb1L7WK7RNgfma2BP\",\"/_next/static/chunks/14mrh2-p_w84d.js?dpl=dpl_3xhGAdw9KMZbb1L7WK7RNgfma2BP\",\"/_next/static/chunks/1w9lotakwc4_z.js?dpl=dpl_3xhGAdw9KMZbb1L7WK7RNgfma2BP\"],\"Image\"]\n25:I[95946,[\"/_next/static/chunks/33zu5gerlsnj9.js?dpl=dpl_3xhGAdw9KMZbb1L7WK7RNgfma2BP\",\"/_next/static/chunks/14mrh2-p_w84d.js?dpl=dpl_3xhGAdw9KMZbb1L7WK7RNgfma2BP\",\"/_next/static/chunks/1w9lotakwc4_z.js?dpl=dpl_3xhGAdw9KMZbb1L7WK7RNgfma2BP\"],\"SubscribeForm\"]\n15:[\"$\",\"div\",null,{\"className\":\"mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.15em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-2 w-2 rounded-full bg-gradient-brand\"}],[\"$\",\"span\",null,{\"className\":\"text-brand-violet\",\"children\":\"Technology\"}],[\"$\",\"span\",null,{\"className\":\"text-line\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-mute\",\"children\":\"News \u0026 analysis\"}]]}]\n16:[\"$\",\"h1\",null,{\"className\":\"max-w-4xl text-4xl font-bold leading-[1.09] tracking-[-0.04em] md:text-5xl xl:text-[3.6rem]\",\"children\":\"Ultrahuman raises $70 million to push smart rings into apps and AI controls\"}]\n17:[\"$\",\"p\",null,{\"className\":\"mt-6 max-w-3xl text-lg leading-relaxed text-mute md:text-xl\",\"children\":\"Ultrahuman’s $70 million financing brings Qualcomm into its push to make smart rings control apps, devices, and AI, with key capabilities still unproven.\"}]\n18:[\"$\",\"div\",null,{\"className\":\"mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-mute\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-bold text-ink\",\"children\":[\"By \",\"Jennifer Mossalgue\"]}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"·\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-09-06T01:10:19.012Z\",\"children\":\"September 6, 2026\"}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"·\"}],[\"$\",\"span\",null,{\"children\":[3,\" min read\"]}]]}]\n19:[\"$\",\"figure\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"$L1f\",null,{\"unoptimized\":true,\"src\":\"/news/images/63e71e4a071c9254afd74cb73ca96f2ca8a46d8c13ece50580e7ab7b2402e25f.webp\",\"width\":2400,\"height\":1352,\"alt\":\"Ultrahuman wants to make its smart ring an AI controller — newsletter story image\",\"loading\":\"eager\",\"fetchPriority\":\"high\",\"className\":\"h-auto w-full rounded-2xl bg-mist\"}],[\"$\",\"figcaption\",null,{\"className\":\"mt-3 text-xs leading-5 text-mute\",\"children\":\"Image source: Ultrahuman\"}]]}]\n"])</script><script>self.__next_f.push([1,"1a:[\"$\",\"div\",null,{\"className\":\"pt-8 md:pt-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"news-prose\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Ultrahuman has raised $70 million from investors including Qualcomm Ventures as it works to expand its smart rings from health tracking into controls for apps, devices, and AI. The ambition is to give a ring enough computing power and software support to accept commands from its wearer.\"}]]}],[\"$\",\"p\",\"1\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"As covered in \"}],[\"$\",\"a\",\"1\",{\"href\":\"https://www.therundown.ai/articles/apple-vision-pro-scrubs-into-surgery\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"The Rundown’s September 4 newsletter\"}]]}],[\"$\",\"$1\",\"2\",{\"children\":\", the Bengaluru company plans both new hardware and software features. As of September 6, the controller capabilities remain a roadmap: delivery of the proposed September software update has yet to be confirmed.\"}]]}],[\"$\",\"$1\",\"2\",{\"children\":[[\"$\",\"h2\",null,{\"id\":\"section-2\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"What Ultrahuman is building\"}]]}],\"$undefined\"]}],[\"$\",\"p\",\"3\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Ultrahuman’s \"}],[\"$\",\"a\",\"1\",{\"href\":\"https://insider.fitt.co/press-release/ultrahuman-raises-70-million-to-build-the-next-generation-of-human-computer-interface-for-health/\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"September 3 financing announcement\"}]]}],[\"$\",\"$1\",\"2\",{\"children\":\" named Qualcomm Ventures, Labcorp, Alpha Wave, Blume, Nexus, and Alteria among the participants. The funding will support sensing, AI, miniaturized electronics, health algorithms, research, and expansion, alongside its broader ambitions for human-computer interfaces.\"}]]}],[\"$\",\"p\",\"4\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"According to \"}],[\"$\",\"a\",\"1\",{\"href\":\"https://techcrunch.com/2026/09/03/qualcomm-backs-ultrahuman-in-70m-round-on-bet-to-turn-smart-rings-into-computers/?utm_source=chatgpt.com\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"TechCrunch’s September 3 interview\"}]]}],[\"$\",\"$1\",\"2\",{\"children\":\", the company said the financing comprises $65 million in equity and $5 million in debt. TechCrunch reported a $365 million valuation, roughly triple its 2023 valuation, citing unnamed sources.\"}]]}],[\"$\",\"p\",\"5\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Ultrahuman said it is working with Qualcomm on a future ring that would incorporate Qualcomm silicon and run more algorithms on the device. It also described a September software update intended to connect rings with apps and games, and exploratory work on pointer functions, car keys, and gesture controls. The chip, hardware release date, and supported apps and devices remain unspecified.\"}]]}],[\"$\",\"p\",\"6\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"The company told TechCrunch it had sold about 800,000 rings and was generating revenue at an annualized rate of $140 million, with a target of $200 million by January 2027. Those figures are company claims; the January figure is a forecast.\"}]]}],[\"$\",\"$1\",\"7\",{\"children\":[[\"$\",\"h2\",null,{\"id\":\"section-7\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Why it matters\"}]]}],\"$undefined\"]}],[\"$\",\"p\",\"8\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"Ultrahuman wants to give people another reason to wear a smart ring: issuing commands to software and devices alongside tracking their health. If it succeeds, a ring could become an input device for apps, games, and AI interactions. The practical test is whether a wearer can make an intentional gesture and reliably get the intended action.\"}]]}],[\"$\",\"p\",\"9\",{\"children\":[[\"$\",\"$1\",\"0\",{\"children\":\"The company has already pursued a developer platform. Its \"}],[\"$\",\"a\",\"1\",{\"href\":\"https://cyborg.ultrahuman.com/press-releases/ultrahuman-announces-its-app-store-powerplugs-with-the-worlds-first-afib-detection-technology-on-a-smart-ring\",\"rel\":\"noopener noreferrer\",\"children\":\"$L20\"}],\"$L21\"]}],\"$L22\",\"$L23\",\"$L24\"]}]}]\n"])</script><script>self.__next_f.push([1,"1b:[\"$\",\"section\",null,{\"className\":\"mt-12 border-t border-line pt-7\",\"aria-labelledby\":\"news-sources\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"news-sources\",\"className\":\"text-xs font-bold uppercase tracking-[0.16em] text-mute\",\"children\":\"Sources \u0026 further reading\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-3\",\"children\":[[\"$\",\"li\",\"https://www.therundown.ai/articles/apple-vision-pro-scrubs-into-surgery\",{\"className\":\"flex gap-3 text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-mute\",\"children\":\"01\"}],[\"$\",\"a\",null,{\"className\":\"break-words font-medium underline decoration-line underline-offset-4 hover:decoration-brand-violet\",\"href\":\"https://www.therundown.ai/articles/apple-vision-pro-scrubs-into-surgery\",\"rel\":\"noopener noreferrer\",\"children\":[\"therundown.ai\",\" ↗\"]}]]}],[\"$\",\"li\",\"https://insider.fitt.co/press-relea