{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaojingwen2002.github.io/janet-public-site/data/schemas/mirror-plan-experiment.schema.json",
  "title": "Janet Mirror Plan Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_hash",
    "id",
    "sequence",
    "title",
    "status",
    "status_label",
    "scene",
    "shot_scale",
    "source",
    "hypothesis",
    "methods",
    "result_summary",
    "conclusion",
    "next_step",
    "prompt_changes",
    "findings",
    "failures",
    "images",
    "stats",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^JW-LTBF-[0-9]{2}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 14 },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["frozen", "freeze_candidate", "stage_closed", "active", "scheduled"]
    },
    "status_label": { "type": "string", "minLength": 1 },
    "scene": { "type": "string", "minLength": 1 },
    "shot_scale": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["frame_id", "file_label", "source_type", "timecode", "evidence_status", "summary"],
      "additionalProperties": false,
      "properties": {
        "frame_id": { "type": "string" },
        "file_label": { "type": "string" },
        "source_type": { "type": "string" },
        "timecode": { "type": "string" },
        "evidence_status": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "hypothesis": { "type": "string", "minLength": 1 },
    "methods": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "label", "intent"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["A", "B", "C"] },
          "label": { "type": "string" },
          "intent": { "type": "string" }
        }
      }
    },
    "result_summary": { "type": "string", "minLength": 1 },
    "conclusion": { "type": "string", "minLength": 1 },
    "next_step": { "type": "string", "minLength": 1 },
    "prompt_changes": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "string" } },
    "failures": { "type": "array", "items": { "type": "string" } },
    "document_id": { "type": ["string", "null"], "pattern": "^[0-9]{2}$" },
    "images": {
      "type": "object",
      "required": ["source", "variants"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^assets/works/mirror-plan/research/atlas/[0-9]{2}\\.jpg$"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "src", "outcome"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-D]$" },
              "label": { "type": "string" },
              "src": {
                "type": "string",
                "pattern": "^assets/works/mirror-plan/research/experiments/JW-LTBF-[0-9]{2}/[A-D]\\.jpg$"
              },
              "outcome": { "type": "string" }
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["round_count", "prompt_count", "image_count", "document_count"],
      "additionalProperties": false,
      "properties": {
        "round_count": { "type": "integer", "minimum": 0 },
        "prompt_count": { "type": "integer", "minimum": 0 },
        "image_count": { "type": "integer", "minimum": 0 },
        "document_count": { "type": "integer", "minimum": 0 }
      }
    },
    "updated_at": { "type": "string", "format": "date" }
  }
}
